6","text":"Formulate hypotheses and experimental designs, review literature, conduct studies and publish research papers, educational texts and articles","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31200.00","via":"31200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.00#37","text":"Deliver presentations at conferences, workshops or symposia","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31200.00","via":"31200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.00#38","text":"Provide consultation services to government and other organizations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31200.00","via":"31200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.00#39","text":"Conduct applied psychology and/or experimental research.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31200.00","via":"31200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.00#40","text":"Interview clients, prepare case histories and assess problems","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.00#41","text":"Develop and implement counselling and intervention programs to assist clients in determining goals and means of attaining them","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.00#42","text":"Counsel clients, provide therapy and mediation services, and facilitate group sessions","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.00#43","text":"Liaise with community agencies or partners,  and identify additional or alternative services and provide referrals","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.00#44","text":"Evaluate the effectiveness of counselling programs and interventions, and clients' progress in resolving identified problems and movement toward defined objectives","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.00#45","text":"Follow up on results of counselling programs and clients' adjustments","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.00#46","text":"Prepare assessment, progress, follow-up and court reports","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.00#47","text":"May supervise other counsellors, social service staff and assistants","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.00#48","text":"May provide public education and consultation to other professionals or groups regarding counselling services, issues and methods","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.00#49","text":"May provide witness testimony in court proceedings","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.00#50","text":"May conduct research, publish research papers, educational texts and articles and deliver presentations at conferences","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.00#51","text":"May collaborate with employee assistance programs or with government organizations in health and safety or with victims of crime","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.00#52","text":"May participate in fundraising activities.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null}]}