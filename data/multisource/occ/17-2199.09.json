s, technicians, or others, using knowledge of chemical, analytical, or biological processes as applied to micro and nanoscale systems.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16540","via":"17-2199.09","match":"native","w":0.5}],"n_sources":1,"weight":0.5,"ai":{"pct":0.912,"anthropic_penetration":0.711,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-2199.09#2","text":"Supervise technologists or technicians engaged in nanotechnology research or production.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16532","via":"17-2199.09","match":"native","w":0.416}],"n_sources":1,"weight":0.416,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-2199.09#3","text":"Conduct research related to a range of nanotechnology topics, such as packaging, heat transfer, fluorescence detection, nanoparticle dispersion, hybrid systems, liquid systems, nanocomposites, nanofabrication, optoelectronics, or nanolithography.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16546","via":"17-2199.09","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"17-2199.09#4","text":"Synthesize, process, or characterize nanomaterials, using advanced tools or techniques.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16533","via":"17-2199.09","match":"native","w":0.833}],"n_sources":1,"weight":0.833,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"17-2199.09#5","text":"Prepare reports, deliver presentations, or participate in program review activities to communicate engineering results or recommendations.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16537","via":"17-2199.09","match":"native","w":0.666}],"n_sources":1,"weight":0.666,"ai":{"pct":0.931,"anthropic_penetration":0.798,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-2199.09#6","text":"Design or conduct tests of new nanotechnology products, processes, or systems.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16542","via":"17-2199.09","match":"native","w":0.584}],"n_sources":1,"weight":0.584,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"17-2199.09#7","text":"Create designs or prototypes for nanosystem applications, such as biomedical delivery systems or atomic force microscopes.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16545","via":"17-2199.09","match":"native","w":0.5}],"n_sources":1,"weight":0.5,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"17-2199.09#8","text":"Write proposals to secure external funding or to partner with other companies.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16531","via":"17-2199.09","match":"native","w":0.334}],"n_sources":1,"weight":0.334,"ai":{"pct":0.92,"anthropic_penetration":0.733,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-2199.09#9","text":"Generate high-resolution images or measure force-distance curves, using techniques such as atomic force microscopy.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16536","via":"17-2199.09","match":"native","w":0.334}],"n_sources":1,"weight":0.334,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"17-2199.09#10","text":"Develop processes or identify equipment needed for pilot or commercial nanoscale scale production.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16539","via":"17-2199.09","match":"native","w":0.25}],"n_sources":1,"weight":0.25,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-2199.09#11","text":"Provide technical guidance or support to customers on topics such as nanosystem start-up, maintenance, or use.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16535","via":"17-2199.09","match":"native","w":0.166}],"n_sources":1,"weight":0.166,"ai":{"pct":0.941,"anthropic_penetration":0.86,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-2199.09#12","text":"Engineer production processes for specific nanotechnology applications, such as electroplating, nanofabrication, or epoxy.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16541","via":"17-2199.09","match":"native","w":0.25}],"n_sources":1,"weight":0.25,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-2199.09#13","text":"Apply nanotechnology to improve the performance or reduce the environmental impact of energy products, such as fuel cells or solar cells.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"19669","via":"17-2199.09","match":"native","w":0.084}],"n_sources":1,"weight":0.084,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"17-2199.09#14","text":"Identify new applications for existing nanotechnologies.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16534","via":"17-2199.09","match":"native","w":0.166}],"n_sources":1,"weight":0.166,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-2199.09#15","text":"Design or engineer nanomaterials, nanodevices, nano-enabled products, or nanosystems, using three-dimensional computer-aided design (CAD) software.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16544","via":"17-2199.09","match":"native","w":0.25}],"n_sources":1,"weight":0.25,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-2199.09#16","text":"Design nano-enabled products with reduced toxicity, increased durability, or improved energy efficiency.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"19671","via":"17-2199.09","match":"native","w":0.084}],"n_sources":1,"weight":0.084,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-2199.09#17","text":"Coordinate or supervise the work of suppliers or vendors in the designing, building, or testing of nanosystem devices, such as lenses or probes.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16543","via":"17-2199.09","match":"native","w":0.166}],"n_sources":1,"weight":0.166,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-2199.09#18","text":"Design nano-based manufacturing processes to minimize water, chemical, or energy use, as well as to reduce waste production.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"19670","via":"17-2199.09","match":"native","w":0.084}],"n_sources":1,"weight":0.084,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-2199.09#19","text":"Design nanosystems with components such as nanocatalysts or nanofiltration devices to clean specific pollutants from hazardous waste sites.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"19673","via":"17-2199.09","match":"native","w":0.007}],"n_sources":1,"weight":0.007,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-2199.09#20","text":"Prepare nanotechnology-related invention disclosures or patent applications.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16538","via":"17-2199.09","match":"native","w":0.166}],"n_sources":1,"weight":0.166,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-2199.09#21","text":"Reengineer nanomaterials to improve biodegradability.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"19677","via":"17-2199.09","match":"native","w":0.007}],"n_sources":1,"weight":0.007,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"17-2199.09#22","text":"Integrate nanotechnology with antimicrobial properties into products, such as household or medical appliances, to reduce the development of bacteria or other microbes.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"19676","via":"17-2199.09","match":"native","w":0.084}],"n_sources":1,"weight":0.084,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"17-2199.09#23","text":"Develop catalysis or other green chemistry methods to synthesize nanomaterials, such as nanotubes, nanocrystals, nanorods, or nanowires.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"19674","via":"17-2199.09","match":"native","w":0.084}],"n_sources":1,"weight":0.084,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"17-2199.09#24","text":"Design nanoparticle catalysts to detect or remove chemical or ot