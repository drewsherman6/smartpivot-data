:[{"id":"55-3013.00#1","text":"Learn and follow safety regulations.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9849","via":"55-3013.00","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"55-3013.00#2","text":"Take actions to avoid potential hazards or obstructions, such as utility lines, other equipment, other workers, or falling objects.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9850","via":"55-3013.00","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"55-3013.00#3","text":"Start engines, move throttles, switches, or levers, or depress pedals to operate machines, such as bulldozers, trench excavators, road graders, or backhoes.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9852","via":"55-3013.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"55-3013.00#4","text":"Coordinate machine actions with other activities, positioning or moving loads in response to hand or audio signals from crew members.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9858","via":"55-3013.00","match":"native","w":0.364}],"n_sources":1,"weight":0.364,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"55-3013.00#5","text":"Align machines, cutterheads, or depth gauge makers with reference stakes and guidelines or ground or position equipment, following hand signals of other workers.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9855","via":"55-3013.00","match":"native","w":0.273}],"n_sources":1,"weight":0.273,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E3","score":1,"basis":"direct"}},{"id":"55-3013.00#6","text":"Locate underground services, such as pipes or wires, prior to beginning work.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9853","via":"55-3013.00","match":"native","w":0.091}],"n_sources":1,"weight":0.091,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"55-3013.00#7","text":"Signal operators to guide movement of tractor-drawn machines.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9868","via":"55-3013.00","match":"native","w":0.091}],"n_sources":1,"weight":0.091,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3013.00#8","text":"Repair and maintain equipment, making emergency adjustments or assisting with major repairs as necessary.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9860","via":"55-3013.00","match":"native","w":0.546}],"n_sources":1,"weight":0.546,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3013.00#9","text":"Load and move dirt, rocks, equipment, or other materials, using trucks, crawler tractors, power cranes, shovels, graders, or related equipment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9856","via":"55-3013.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"55-3013.00#10","text":"Drive and maneuver equipment equipped with blades in successive passes over working areas to remove topsoil, vegetation, or rocks or to distribute and level earth or terrain.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9857","via":"55-3013.00","match":"native","w":0.909}],"n_sources":1,"weight":0.909,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"55-3013.00#11","text":"Operate tractors or bulldozers to perform such tasks as clearing land, mixing sludge, trimming backfills, or building roadways or parking lots.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9859","via":"55-3013.00","match":"native","w":0.546}],"n_sources":1,"weight":0.546,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"55-3013.00#12","text":"Monitor operations to ensure that health and safety standards are met.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9854","via":"55-3013.00","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3013.00#13","text":"Connect hydraulic hoses, belts, mechanical linkages, or power takeoff shafts to tractors.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9862","via":"55-3013.00","match":"native","w":0.091}],"n_sources":1,"weight":0.091,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"55-3013.00#14","text":"Select and fasten bulldozer blades or other attachments to tractors, using hitches.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9864","via":"55-3013.00","match":"native","w":0.091}],"n_sources":1,"weight":0.091,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"55-3013.00#15","text":"Operate loaders to pull out stumps, rip asphalt or concrete, rough-grade properties, bury refuse, or perform general cleanup.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9863","via":"55-3013.00","match":"native","w":0.454}],"n_sources":1,"weight":0.454,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"55-3013.00#16","text":"Operate equipment to demolish or remove debris or to remove snow from streets, roads, or parking lots.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9875","via":"55-3013.00","match":"native","w":0.273}],"n_sources":1,"weight":0.273,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"55-3013.00#17","text":"Keep records of material or equipment usage or problems encountered.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9872","via":"55-3013.00","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3013.00#18","text":"Adjust handwheels and depress pedals to control attachments, such as blades, buckets, scrapers, or swing booms.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9851","via":"55-3013.00","match":"native","w":0.364}],"n_sources":1,"weight":0.364,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E3","score":1,"basis":"direct"}},{"id":"55-3013.00#19","text":"Check fuel supplies at sites to ensure adequate availability.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9861","via":"55-3013.00","match":"native","w":0.091}],"n_sources":1,"weight":0.091,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"55-3013.00#20","text":"Talk to clients and study instructions, plans, or diagrams to establish work requirements.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9867","via":"55-3013.00","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3013.00#21","text":"Drive tractor-trailer trucks to move equipment from site to site.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9873","via":"55-3013.00","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"55-3013.00#22","text":"Push other equipment when extra traction or assistance is required.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9871","via":"55-3013.00","match":"native","w":0.091}],"n_sources":1,"weight":0.091,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3013.00#23","text":"Operate road watering, oiling, or rolling equipment, or street sealing equipment, such as chip spreaders.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9869","via":"55-3013.00","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"55-3013.00#24","text":"Operate compactors, scrapers, or rollers to level, compact, or cover refuse at disposal grounds.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9866","via":"55-3013.00","match":"native","w":0.091}],"n_sources":1,"weight":0.091,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"55-3013.00#25","text":"Test atmosphere for adequate oxygen or explosive conditions when working in confined spaces.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9865","via":"55-3013.00","match":"native","w":0.008}],"n_sources":1,"weight":0.008,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"55-3013.00#26","text":"Turn valves to control air or water output of compressors or pumps.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9874","via":"55-3013.00","match":"native","w":0.091}],"n_sources":1,"weight":0.091,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"55-3013.00#27","text":"Respond to emergency calls and complaints, execute search warrants and arrest criminal suspects","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3013.00#28","text":"Patrol assigned areas on foot, horseback, bicycle and motorized vehicles to maintain public safety and order and to enforce laws and regulations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3013.00#29","text":"Prepare reports to record incidents and patrol activities and to provide testimony in courts of law","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3013.00#30","text":"Provide emergency assistance to victims of accidents, crimes and natural disasters","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3013.00#31","text":"Monitor traffic to ensure motorists observe traffic regulations and test persons suspected of driving under the influence of alcohol and drugs","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3013.00#32","text":"Control crowds at public events and protests and monitor suspicious and violent behaviour","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3013.00#33","text":"Participate in crime prevention, public information, safety and community relations programs","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3013.00#34","text":"Perform daily administrative tasks in support of law enforcement activities, such as maintaining equipment and information files","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3013.00#35","text":"May assist police investigators in criminal investigations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3013.00#36","text":"Certify ammunition, explosive items, munitions and non-munitions scrap to different degrees of classification","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42102.00","via":"42102","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3013.00#37","text":"Inspect, test, identify faults, adjust, repair, recondition and modify electrical, electromechanical, electronic, electro-optic and mechanical equipment, optical instruments, and control systems for weapons and missiles","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42102.00","via":"42102","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3013.00#38","text":"Maintain and repair machine-guns and non-guided anti-tank weapons, grenade projectors, mortars and launcher systems","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42102.00","via":"42102","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3013.00#39","text":"Test, inspect and repair air weapons systems","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42102.00","via":"42102","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3013.00#40","text":"Compile test logs, evaluation reports, equipment maintenance documentation and read and interpret electronic drawings","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42102.00","via":"42102","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3013.00#41","text":"Analyze equipment and system performance on all combat information equipment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3013.00#42","text":"Maintain and operate engineering equipment, including weapons, vehicles, heavy equipment and supplies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3013.00#43","text":"Inspect motors in operation, road test motor vehicles, and test automotive systems and components using computerized diagnostic and other testing devices to diagnose and isolate faults","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3013.00#44","text":"Configure and operate intelligence, surveillance and recognizance systems","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3013.00#45","text":"Oversee the construction of tools and devices to enable infantry soldiers to cross natural and man-made obstacles and break through enemy defenses","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3013.00#46","text":"Operate weapons and missile related equipment for defense.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3013.00#47","text":"Provide assistance in emergency situations, such as civil disorder, natural disasters and major accidents","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3013.00#48","text":"Operate armoured vehicles, artillery, hand-held weapons and other military combat equipment and defense systems","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.2