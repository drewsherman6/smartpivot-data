e":0.3333333333333333,"basis":"direct"}},{"id":"47-2081.00#5","text":"Fit and fasten wallboard or drywall into position on wood or metal frameworks, using glue, nails, or screws.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13505","via":"47-2081.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2081.00#6","text":"Measure and cut openings in panels or tiles for electrical outlets, windows, vents, plumbing, or other fixtures, using keyhole saws or other cutting tools.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13507","via":"47-2081.00","match":"native","w":0.278}],"n_sources":1,"weight":0.278,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2081.00#7","text":"Cut metal or wood framing and trim to size, using cutting tools.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13515","via":"47-2081.00","match":"native","w":0.056}],"n_sources":1,"weight":0.056,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2081.00#8","text":"Cut fixture or border tiles to size, using keyhole saws, and insert them into surrounding frameworks.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13514","via":"47-2081.00","match":"native","w":0.111}],"n_sources":1,"weight":0.111,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2081.00#9","text":"Coordinate work with drywall finishers who cover the seams between drywall panels.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13510","via":"47-2081.00","match":"native","w":0.056}],"n_sources