 and ceilings","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"73102.02","via":"73102","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"47-2081.00#73","text":"Position and secure sheets to metal or wooden studs or joists","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"73102.02","via":"73102","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"47-2081.00#74","text":"Cut and install metal corner beads to protect exterior corners","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"73102.02","via":"73102","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"47-2081.00#75","text":"Fill joints, nail indentations, holes and cracks with joint compound using trowel and broad knife","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"73102.02","via":"73102","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"47-2081.00#76","text":"Tape over joints using taping machine and embed tape in compound","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"73102.02","via":"73102","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"47-2081.00#77","text":"Smooth out excess compound and allow coat to dry","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"73102.02","via":"73102","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"47-2081.00#78","text":"Apply successive coats of compound and sand seams and joints","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"73102.02","via":"73102","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"47-2081.00#79","text":"Fabricate and install suspended metal ceiling grids and place in panels to form acoustical and coffered ceiling