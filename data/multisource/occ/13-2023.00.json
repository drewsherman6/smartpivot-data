es":1,"weight":0.231,"ai":{"pct":0.981,"anthropic_penetration":0.972,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2023.00#5","text":"Obtain county land values and sales information about nearby properties to aid in establishment of property values.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21570","via":"13-2023.00","match":"native","w":0.231}],"n_sources":1,"weight":0.231,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2023.00#6","text":"Maintain familiarity with aspects of local real estate markets.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21564","via":"13-2023.00","match":"native","w":0.231}],"n_sources":1,"weight":0.231,"ai":{"pct":0.989,"anthropic_penetration":1,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2023.00#7","text":"Inspect properties, considering factors such as market value, location, and building or replacement costs to determine appraisal value.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21556","via":"13-2023.00","match":"native","w":0.692}],"n_sources":1,"weight":0.692,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2023.00#8","text":"Collect and analyze relevant data to identify real estate market trends.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21552","via":"13-2023.00","match":"native","w":0.231}],"n_sources":1,"weight":0.231,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2023.00#9","text":"Review information about transfers of property to ensure its accuracy, checking basic information on buyers, sellers, and sales prices and making corrections as necessary.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21558","via":"13-2023.00","match":"native","w":0.154}],"n_sources":1,"weight":0.154,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2023.00#10","text":"Analyze trends in sales prices, construction costs, and rents, to assess property values or determine the accuracy of assessments.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21577","via":"13-2023.00","match":"native","w":0.231}],"n_sources":1,"weight":0.231,"ai":{"pct":0.956,"anthropic_penetration":0.902,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2023.00#11","text":"Inspect new construction and major improvements to existing structures to determine values.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21551","via":"13-2023.00","match":"native","w":0.154}],"n_sources":1,"weight":0.154,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2023.00#12","text":"Check building codes and zoning bylaws to determine any effects on the properties being appraised.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21566","via":"13-2023.00","match":"native","w":0.154}],"n_sources":1,"weight":0.154,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2023.00#13","text":"Interview persons familiar with properties and immediate surroundings, such as contractors, home owners, and realtors, to obtain pertinent information.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21568","via":"13-2023.00","match":"native","w":0.154}],"n_sources":1,"weight":0.154,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2023.00#14","text":"Verify legal descriptions of properties by comparing them to county records.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21567","via":"13-2023.00","match":"native","w":0.077}],"n_sources":1,"weight":0.077,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2023.00#15","text":"Evaluate land and neighborhoods where properties are situated, considering locations and trends or impending changes that could influence future values.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21563","via":"13-2023.00","match":"native","w":0.154}],"n_sources":1,"weight":0.154,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2023.00#16","text":"Examine the type and location of nearby services, such as shopping centers, schools, parks, and other neighborhood features, to evaluate their impact on property values.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21571","via":"13-2023.00","match":"native","w":0.077}],"n_sources":1,"weight":0.077,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2023.00#17","text":"Examine income records and operating costs of income properties.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21562","via":"13-2023.00","match":"native","w":0.154}],"n_sources":1,"weight":0.154,"ai":{"pct":0.978,"anthropic_penetration":0.966,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2023.00#18","text":"Estimate building replacement costs, using building valuation manuals and professional cost estimators.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21572","via":"13-2023.00","match":"native","w":0.154}],"n_sources":1,"weight":0.154,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2023.00#19","text":"Draw land diagrams to be used in appraisal reports to support findings.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21573","via":"13-2023.00","match":"native","w":0.077}],"n_sources":1,"weight":0.077,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2023.00#20","text":"Conduct regular reviews of property within jurisdictions to determine changes in property due to construction or demolition.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21560","via":"13-2023.00","match":"native","w":0.077}],"n_sources":1,"weight":0.077,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E3","score":1,"basis":"direct"}},{"id":"13-2023.00#21","text":"Testify in court as to the value of a piece of real estate property.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21574","via":"13-2023.00","match":"native","w":0.077}],"n_sources":1,"weight":0.077,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2023.00#22","text":"Identify the ownership of each piece of taxable property.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21555","via":"13-2023.00","match":"native","w":0.077}],"n_sources":1,"weight":0.077,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2023.00#23","text":"Prepare and maintain current data on each parcel assessed, including maps of boundaries, inventories of land and structures, property characteristics, and any applicable exemptions.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21553","via":"13-2023.00","match":"native","w":0.307}],"n_sources":1,"weight":0.307,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2023.00#24","text":"Establish uniform and equitable systems for assessing all classes and kinds of property.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21561","via":"13-2023.00","match":"native","w":0.077}],"n_sources":1,"weight":0.077,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2023.00#25","text":"Calculate tax bills for properties by multiplying assessed values by jurisdiction tax rates.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21575","via":"13-2023.00","match":"native","w":0.077}],"n_sources":1,"weight":0.077,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2023.00#26","text":"Determine taxability of properties, using methods such as field inspection, structural measurement, calculation, sales analysis, market trend studies, and income and expense analysis.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21578","via":"13-2023.00","match":"native","w":0.077}],"n_sources":1,"weight":0.077,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2023.00#27","text":"Explain assessed values to property owners and defend appealed assessments at public hearings.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21554","via":"13-2023.00","match":"native","w":0.154}],"n_sources":1,"weight":0.154,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2023.00#28","text":"Explain real and personal property taxes to property owners.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21559","via":"13-2023.00","match":"nativ