robotics":null},{"id":"29-2092.00#40","text":"physiology of hearing","kind":"knowledge","esco_uri":"http://data.europa.eu/esco/skill/3154e3b5-93d8-46c5-bb15-326b3be99d51","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/3154e3b5-93d8-46c5-bb15-326b3be99d51","via":"http://data.europa.eu/esco/occupation/521bbfd5-c179-46e3-879b-e74bd6db367c","match":"exactMatch","essential":false,"w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#41","text":"hearing loss","kind":"knowledge","esco_uri":"http://data.europa.eu/esco/skill/54b927e2-7a9d-4593-ba64-284b5dde443e","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/54b927e2-7a9d-4593-ba64-284b5dde443e","via":"http://data.europa.eu/esco/occupation/521bbfd5-c179-46e3-879b-e74bd6db367c","match":"exactMatch","essential":false,"w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#42","text":"geriatrics","kind":"knowledge","esco_uri":"http://data.europa.eu/esco/skill/52c19dc8-651f-4095-98fe-dcb2799d702e","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/52c19dc8-651f-4095-98fe-dcb2799d702e","via":"http://data.europa.eu/esco/occupation/521bbfd5-c179-46e3-879b-e74bd6db367c","match":"exactMatch","essential":false,"w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#43","text":"Examining, interviewing, and measuring patients in order to determine their appliance needs, and to identify factors that could affect appliance fit","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3214-1","via":"3214","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.293,"anthropic_penetration":null,"ilo_2025":0.175,"basis":"direct"},"robotics":null},{"id":"29-2092.00#44","text":"Conferring with medical and dental practitioners in order to formulate specifications and prescriptions for devices and appliances","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3214-2","via":"3214","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.424,"anthropic_penetration":null,"ilo_2025":0.25,"basis":"direct"},"robotics":null},{"id":"29-2092.00#45","text":"Interpreting prescriptions or specifications to determine the type of product or device to be fabricated, and the materials and tools that will be required","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3214-3","via":"3214","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.506,"anthropic_penetration":null,"ilo_2025":0.285,"basis":"direct"},"robotics":null},{"id":"29-2092.00#46","text":"Making or receiving casts or impressions of patients' torsos, limbs, mouths or teeth for use as fabrication patterns","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3214-4","via":"3214","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.202,"anthropic_penetration":null,"ilo_2025":0.15,"basis":"direct"},"robotics":null},{"id":"29-2092.00#47","text":"Designing and making orthotic and prosthetic devices using materials such as thermoplastic and thermosetting materials, metal alloys and leather, and hand and power tools","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3214-5","via":"3214","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.202,"anthropic_penetration":null,"ilo_2025":0.15,"basis":"direct"},"robotics":null},{"id":"29-2092.00#48","text":"Fitting appliances and devices onto patients, testing and evaluating them, and making adjustments for proper fit, function and comfort","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3214-6","via":"3214","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.324,"anthropic_penetration":null,"ilo_2025":0.19,"basis":"direct"},"robotics":null},{"id":"29-2092.00#49","text":"Repairing, modifying and maintaining medical and dental prosthetic and supportive devices, according to specifications","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3214-7","via":"3214","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.281,"anthropic_penetration":null,"ilo_2025":0.17,"basis":"direct"},"robotics":null},{"id":"29-2092.00#50","text":"Bending, forming, and shaping fabric or material so that it conforms to prescribed contours needed to fabricate structural components","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3214-8","via":"3214","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.117,"anthropic_penetration":null,"ilo_2025":0.1275,"basis":"direct"},"robotics":null},{"id":"29-2092.00#51","text":"Fabricating full and partial dentures and constructing mouth guards, crowns, metal clasps, inlays, bridgework and other aids","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3214-9","via":"3214","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.164,"anthropic_penetration":null,"ilo_2025":0.14,"basis":"direct"},"robotics":null},{"id":"29-2092.00#52","text":"Instructing patients in the use and care of prosthetic or orthotic devices.","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3214-10","via":"3214","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.25,"anthropic_penetration":null,"ilo_2025":0.1625,"basis":"direct"},"robotics":null},{"id":"29-2092.00#53","text":"Examine adult clients to assess hearing loss using diagnostic evaluation and electro acoustic testing","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.01","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#54","text":"Recommend and dispense or sell appropriate type of hearing instrument","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.01","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#55","text":"Take earmold impressions for use in the manufacture of hearing devices","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.01","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#56","text":"Fit, adjust and make minor modifications to hearing instruments","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.01","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#57","text":"Educate clients in appropriate use, care and maintenance of hearing instruments","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.01","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#58","text":"Communicate with audiologist or other health care professionals regarding patients' condition","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.01","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#59","text":"Perform follow-up examinations and readjustments.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.01","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#60","text":"Assist speech-language pathologists and audiologists during assessment of patients","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.02","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#61","text":"Carry out treatment programs, document results and develop materials for use with patients, under the supervision of speech-language pathologists or audiologists","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.02","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#62","text":"Document patient rehabilitation progress","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.02","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#63","text":"Check and maintain therapeutic equipment and materials.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.02","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#64","text":"Take patients' general medical and ophthalmic history","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.03","via":"32109","match":"statcan_concordance","w":0.5},{"source":"oasis","ref":"33109.04","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#65","text":"Conduct specialized testing such as refractometry, ultrasonography, fluorescein angiography or ocular motility testing  to aid ophthalmologists in assessing patients' vision","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.03","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#66","text":"Instruct patient on diagnostic test and record, interpret and troubleshoot results","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.03","via":"32109","match":"statcan_concordance","w":0.5},{"source":"oasis","ref":"33109.04","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#67","text":"Assist ophthalmologists in performing ophthalmic procedures, and surgeries","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.03","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#68","text":"Prepare specimens for culture and staining","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.03","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#69","text":"Administer topical ophthalmic or oral medications as directed by ophthalmologists","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.03","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#70","text":"Maintain ophthalmic instruments or equipment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.03","via":"32109","match":"statcan_concordance","w":0.5},{"source":"oasis","ref":"33109.04","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#71","text":"May instruct and supervise other ophthalmic staff and perform various administrative duties","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.03","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#72","text":"May participate in research activities.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.03","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#73","text":"Collect and analyse information from clients' file upon referral from the physiotherapist or physician","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.04","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#74","text":"Develop, implement and monitor treatment plans of clients in collaboration with the physiotherapist or physician","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.04","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#75","text":"Use a variety of therapeutic modalities such as manual techniques (e.g. massage), exercises, electrotherapy, hydrotherapy and thermotherapy (ice or heat) to achieve treatment objectives","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.04","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#76","text":"Advise clients on postures, lifestyle and exercises to help them improve their physical condition.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.04","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#77","text":"Under the direction of physiotherapists and/or occupational therapists, carry out treatment programs such as thermotherapy, traction, hydrotherapy and electrotherapeutic techniques to rehabilitate patients with various injuries or disabilities to maximize their ability to independently manage daily activities.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.05","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#78","text":"Under the supervision of audiologists, administer tests such as pure tone hearing screening, impedance tests and noise level measurements using equipment such as audiometers and sound level meters to determine hearing thresholds of patients","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.01","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#79","text":"Instruct patients on test procedures and record results","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.01","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#80","text":"Monitor, check and calibrate auditory equipment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.01","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#81","text":"May take earmold impressions and fit and adjust hearing instruments.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.01","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#82","text":"Assist orthopedic surgeons in the treatment of orthopedic diseases and injuries by applying and adjusting casts, splints, bandages and other orthopedic devices","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.02","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#83","text":"Assist in the application, maintenance and adjustment of traction equipment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.02","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#84","text":"Clean and dress wounds","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.02","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#85","text":"Remove casts, sutures, staples and pins","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.02","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#86","text":"Instruct patients and their families and other health care professionals with respect to orthopedic matters.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.02","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#87","text":"Prepare and maintain equipment and supplies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.03","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#88","text":"Assist in activities for the rehabilitation of patients as directed by health care professionals","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.03","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#89","text":"May perform routine office functions.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.03","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#90","text":"Operate ophthalmic testing and measuring instruments to aid ophthalmologists in assessing patients' vision","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.04","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#91","text":"Assist ophthalmologists in minor office surgery","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.04","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#92","text":"Administer eye drops, ointments and medications as directed by ophthalmologists","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.04","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#93","text":"Perform various administrative duties","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.04","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#94","text":"Operate laboratory equipment to grind, cut, polish and edge lenses for eyeglasses according to prescriptions received and fit lenses into frames","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.05","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#95","text":"Make minor repairs for customers such as replacing frame screws or straightening frames","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.05","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#96","text":"Maintain and repair optical laboratory equipment or machinery.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.05","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#97","text":"Operate and maintain sterilization equipment such as instrument washers, sonic sinks, cart washers and steam autoclaves to clean and disinfect trays, carts, linens, supplies, instrumentation and equipment for re-use according to standardized safety practices","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.06","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#98","text":"Reassemble equipment and assemble packs of sterile supplies and instruments for delivery to hospital departments.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.06","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#99","text":"Set up and dismantle equipment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.07","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#100","text":"Prepare and maintain cleanliness of collection areas","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.07","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#101","text":"Maintain supplies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.07","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#102","text":"Monitor donors throughout procedure and assist with post-donation care and donor reaction care as assigned under the supervision of a registered nurse","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.07","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#103","text":"Record information on donors","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.07","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#104","text":"Label and process donated blood.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.07","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#105","text":"Assist pathologists at autopsies by laying out surgical instruments","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.08","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#106","text":"Prepare solutions for preservation of specimens","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.08","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#107","text":"Transfer bodies from morgue to examining table","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.08","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#108","text":"Remove organs and tissue specimens, as instructed by attending pathologist, and placing them in preservative solutions","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.08","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-2092.00#109","text":"Clean and sew up bodies for release to funeral home.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.08","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null}]}