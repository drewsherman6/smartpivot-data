.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14124","via":"51-6061.00","match":"native","w":0.818},{"source":"ilo","ref":"8154-11","via":"8154","match":"esco_onet_exactISCO","w":1}],"n_sources":2,"weight":1,"ai":{"pct":0.252,"anthropic_penetration":0,"ilo_2025":0.2825,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-6061.00#4","text":"Notify supervisors or mechanics of equipment malfunctions.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14122","via":"51-6061.00","match":"native","w":0.091},{"source":"oasis","ref":"94130.02","via":"94130","match":"statcan_concordance","w":0.5}],"n_sources":2,"weight":0.5,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-6061.00#5","text":"Monitor factors such as temperatures and dye flow rates to ensure that they are within specified ranges.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14126","via":"51-6061.00","match":"native","w":0.546}],"n_sources":1,"weight":0.546,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-6061.00#6","text":"Add dyes, water, detergents, or chemicals to tanks to dilute or strengthen solutions, according to established formulas and solution test results.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14121","via":"51-6061.00","match":"native","w":0.454}],"n_sources":1,"weight":0.454,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6061.00#7","text":"Examine and feel products to identify defects and variations from coloring and other processing standards.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14128","via":"51-6061.00","match":"native","w":0.454}],"n_sources":1,"weight":0.454,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6061.00#8","text":"Adjust equipment controls to maintain specified heat, tension, and speed.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14123","via":"51-6061.00","match":"native","w":0.364}],"n_sources":1,"weight":0.364,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"51-6061.00#9","text":"Soak specified textile products for designated times.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14138","via":"51-6061.00","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6061.00#10","text":"Inspect machinery to determine necessary adjustments and repairs.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14134","via":"51-6061.00","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6061.00#11","text":"Confer with coworkers to get information about order details, processing plans, or problems that occur.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14133","via":"51-6061.00","match":"native","w":0.272}],"n_sources":1,"weight":0.272,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-6061.00#12","text":"Sew ends of cloth together, by hand or using machines, to form endless lengths of cloth to facilitate processing.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14136","via":"51-6061.00","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6061.00#13","text":"Ravel seams that connect cloth ends when processing is completed.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14142","via":"51-6061.00","match":"native","w":0.091}],"n_sources":1,"weight":0.091,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6061.00#14","text":"Remove dyed articles from tanks and machines for drying and further processing.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14131","via":"51-6061.00","match":"native","w":0.364}],"n_sources":1,"weight":0.364,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"51-6061.00#15","text":"Study guides, charts, and specification sheets, and confer with supervisors to determine machine setup requirements.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14132","via":"51-6061.00","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-6061.00#16","text":"Prepare dyeing machines for production runs, and conduct test runs of machines to ensure their proper operation.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14125","via":"51-6061.00","match":"native","w":0.272}],"n_sources":1,"weight":0.272,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6061.00#17","text":"Key in processing instructions to program electronic equipment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14137","via":"51-6061.00","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0.985,"anthropic_penetration":0.984,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-6061.00#18","text":"Test solutions used to process textile goods to detect variations from standards.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14130","via":"51-6061.00","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6061.00#19","text":"Record production information such as fabric yardage processed, temperature readings, fabric tensions, and machine speeds.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14129","via":"51-6061.00","match":"native","w":0.272}],"n_sources":1,"weight":0.272,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-6061.00#20","text":"Thread ends of cloth or twine through specified sections of equipment prior to processing.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14139","via":"51-6061.00","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6061.00#21","text":"Mount rolls of cloth on machines, using hoists, or place textile goods in machines or pieces of equipment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14140","via":"51-6061.00","match":"native","w":0.364}],"n_sources":1,"weight":0.364,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6061.00#22","text":"Install, level, and align components such as gears, chains, dies, cutters, and needles.","kind":"task","esco_uri":nu