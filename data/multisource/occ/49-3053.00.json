,"sd":0.19,"range":0.502,"label":"sources partly agree"},"headline":{"value":0.013,"time_weighted_tasks":0.009,"other_measures_pct":0.399,"other_measures_linked":0.017,"weight_time_weighted":0.5,"weight_other_measures":0.5}}},"statements":[{"id":"49-3053.00#1","text":"Record repairs made, time spent, and parts used.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13777","via":"49-3053.00","match":"native","w":0.454}],"n_sources":1,"weight":0.454,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-3053.00#2","text":"Test and inspect engines to determine malfunctions, to locate missing and broken parts, and to verify repairs, using diagnostic instruments.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13780","via":"49-3053.00","match":"native","w":0.727}],"n_sources":1,"weight":0.727,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-3053.00#3","text":"Dismantle engines, using hand tools, and examine parts for defects.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13784","via":"49-3053.00","match":"native","w":0.636}],"n_sources":1,"weight":0.636,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-3053.00#4","text":"Repair and maintain gasoline engines used to power equipment such as portable saws, lawn mowers, generators, and compressors.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13774","via":"49-3053.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-3053.00#5","text":"Adjust points, valves, carburetors, distributors, and spark plug gaps, using feeler gauges.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13775","via":"49-3053.00","match":"native","w":0.545}],"n_sources":1,"weight":0.545,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-3053.00#6","text":"Repair or replace defective parts such as magnetos, water pumps, gears, pistons, and carburetors, using hand tools.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13781","via":"49-3053.00","match":"native","w":0.909}],"n_sources":1,"weight":0.909,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-3053.00#7","text":"Perform routine maintenance such as cleaning and oiling parts, honing cylinders, and tuning ignition systems.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13778","via":"49-3053.00","match":"native","w":0.727}],"n_sources":1,"weight":0.727,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-3053.00#8","text":"Reassemble engines after repair or maintenance work is complete.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13776","via":"49-3053.00","match":"native","w":0.545}],"n_sources":1,"weight":0.545,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-3053.00#9","text":"Replace motors.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13785","via":"49-3053.00","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-3053.00#10","text":"Obtain problem descriptions from customers, and prepare cost estimates for repairs.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13779","via":"49-3053.00","match":"native","w":0.545}],"n_sources":1,"weight":0.545,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-3053.00#11","text":"Show customers how to maintain equipment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13783","via":"49-3053.00","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-3053.00#12","text":"Remove engines from equipment, and position and bolt engines to repair stands.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13787","via":"49-3053.00","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-3053.00#13","text":"Sell parts and equipment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13782","via":"49-3053.00","match":"native","w":0.273}],"n_sources":1,"weight":0.273,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-3053.00#14","text":"Grind, ream, rebore, and re-tap parts to obtain specified clearances, using grinders, lathes, taps, reamers, boring machines, and micrometers.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13786","via":"49-3053.00","match":"native","w":0.091}],"n_sources":1,"weight":0.091,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-3053.00#15","text":"replace defect components","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/87af00b5-30fa-41c8-bfa5-357f22c8d589","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/87af00b5-30fa-41c8-bfa5-357f22c