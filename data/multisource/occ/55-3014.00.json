{"id":"55-3014.00#1","text":"Examine blast areas to determine amounts and kinds of explosive charges needed and to ensure that safety laws are observed.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9904","via":"55-3014.00","match":"native","w":0.777}],"n_sources":1,"weight":0.777,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"55-3014.00#2","text":"Tie specified lengths of delaying fuses into patterns in order to time sequences of explosions.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9905","via":"55-3014.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"55-3014.00#3","text":"Place safety cones around blast areas to alert other workers of danger zones, and signal workers as necessary to ensure that they clear blast sites prior to explosions.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9906","via":"55-3014.00","match":"native","w":0.445}],"n_sources":1,"weight":0.445,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"55-3014.00#4","text":"Place explosive charges in holes or other spots; then detonate explosives to demolish structures or to loosen, remove, or displace earth, rock, or other materials.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9907","via":"55-3014.00","match":"native","w":0.555}],"n_sources":1,"weight":0.555,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3014.00#5","text":"Insert, pack, and pour explosives, such as dynamite, ammonium nitrate, black powder, or slurries into blast holes; then shovel drill cuttings, admit water into boreholes, and tamp material to compact charges.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9908","via":"55-3014.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"55-3014.00#6","text":"Mark patterns, locations, and depths of charge holes for drilling, and issue drilling instructions.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9909","via":"55-3014.00","match":"native","w":0.445}],"n_sources":1,"weight":0.445,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"55-3014.00#7","text":"Compile and keep gun and explosives records in compliance with local and federal laws.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9910","via":"55-3014.00","match":"native","w":0.555}],"n_sources":1,"weight":0.555,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3014.00#8","text":"Measure depths of drilled blast holes, using weighted tape measures.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9911","via":"55-3014.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E3","score":1,"basis":"direct"}},{"id":"55-3014.00#9","text":"Connect electrical wire to primers, and cover charges or fill blast holes with clay, drill chips, sand, or other material.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9912","via":"55-3014.00","match":"native","w":0.667}],"n_sources":1,"weight":0.667,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"55-3014.00#10","text":"Lay primacord between rows of charged blast holes, and tie cord into main lines to form blast patterns.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9913","via":"55-3014.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"55-3014.00#11","text":"Assemble and position equipment, explosives, and blasting caps in holes at specified depths, or load perforating guns or torpedoes with explosives.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9914","via":"55-3014.00","match":"native","w":0.445}],"n_sources":1,"weight":0.445,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3014.00#12","text":"Verify detonation of charges by observing control panels, or by listening for the sounds of blasts.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9915","via":"55-3014.00","match":"native","w":0.111}],"n_sources":1,"weight":0.111,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3014.00#13","text":"Move and store inventories of explosives, loaded perforating guns, and other materials, according to established safety procedures.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9916","via":"55-3014.00","match":"native","w":0.445}],"n_sources":1,"weight":0.445,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"55-3014.00#14","text":"Light fuses, drop detonating devices into wells or boreholes, or activate firing devices with plungers, dials, or buttons, in order to set off single or multiple blasts.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9917","via":"55-3014.00","match":"native","w":0.111}],"n_sources":1,"weight":0.111,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"55-3014.00#15","text":"Drive trucks to transport explosives and blasting equipment to blasting sites.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9918","via":"55-3014.00","match":"native","w":0.667}],"n_sources":1,"weight":0.667,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"55-3014.00#16","text":"Cut specified lengths of primacord and attach primers to cord ends.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9919","via":"55-3014.00","match":"native","w":0.222}],"n_sources":1,"weight":0.222,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"55-3014.00#17","text":"Maintain inventory levels, ordering new supplies as necessary.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9920","via":"55-3014.00","match":"native","w":0.222}],"n_sources":1,"weight":0.222,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"55-3014.00#18","text":"Repair and service blasting, shooting, and automotive equipment, and electrical wiring and instruments, using hand tools.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9922","via":"55-3014.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3014.00#19","text":"Set up and operate short-wave radio or field telephone equipment to transmit and receive blast information.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9923","via":"55-3014.00","match":"native","w":0.111}],"n_sources":1,"weight":0.111,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3014.00#20","text":"Insert waterproof sealers, bullets, and/or powder charges into guns, and screw gun ports back into place.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9924","via":"55-3014.00","match":"native","w":0.111}],"n_sources":1,"weight":0.111,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"55-3014.00#21","text":"Clean, gauge, and lubricate gun ports.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9925","via":"55-3014.00","match":"native","w":0.111}],"n_sources":1,"weight":0.111,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"55-3014.00#22","text":"Lower perforating guns into wells, using hoists; then use measuring devices and instrument panels to position guns in correct positions for taking samples.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9927","via":"55-3014.00","match":"native","w":0.111}],"n_sources":1,"weight":0.111,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"55-3014.00#23","text":"Create and lay out designs for drill and blast patterns.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23490","via":"55-3014.00","match":"native","w":0.445}],"n_sources":1,"weight":0.445,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3014.00#24","text":"Document geological formations encountered during work.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23491","via":"55-3014.00","match":"native","w":0.111}],"n_sources":1,"weight":0.111,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3014.00#25","text":"Operate machines to flush earth cuttings or to blow dust from holes.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23492","via":"55-3014.00","match":"native","w":0.111}],"n_sources":1,"weight":0.111,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"55-3014.00#26","text":"Set up and operate equipment such as hoists, jackhammers, and drills, in order to bore charge holes.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23493","via":"55-3014.00","match":"native","w":0.555}],"n_sources":1,"weight":0.555,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"55-3014.00#27","text":"Signal crane operators to move equipment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23494","via":"55-3014.00","match":"native","w":0.111}],"n_sources":1,"weight":0.111,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3014.00#28","text":"Respond to emergency calls and complaints, execute search warrants and arrest criminal suspects","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3014.00#29","text":"Patrol assigned areas on foot, horseback, bicycle and motorized vehicles to maintain public safety and order and to enforce laws and regulations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3014.00#30","text":"Prepare reports to record incidents and patrol activities and to provide testimony in courts of law","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3014.00#31","text":"Provide emergency assistance to victims of accidents, crimes and natural disasters","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3014.00#32","text":"Monitor traffic to ensure motorists observe traffic regulations and test persons suspected of driving under the influence of alcohol and drugs","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3014.00#33","text":"Control crowds at public events and protests and monitor suspicious and violent behaviour","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3014.00#34","text":"Participate in crime prevention, public information, safety and community relations programs","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3014.00#35","text":"Perform daily administrative tasks in support of law enforcement activities, such as maintaining equipment and information files","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3014.00#36","text":"May assist police investigators in criminal investigations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3014.00#37","text":"Certify ammunition, explosive items, munitions and non-munitions scrap to different degrees of classification","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42102.00","via":"42102","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3014.00#38","text":"Inspect, test, identify faults, adjust, repair, recondition and modify electrical, electromechanical, electronic, electro-optic and mechanical equipment, optical instruments, and control systems for weapons and missiles","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42102.00","via":"42102","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3014.00#39","text":"Maintain and repair machine-guns and non-guided anti-tank weapons, grenade projectors, mortars and launcher systems","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42102.00","via":"42102","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3014.00#40","text":"Test, inspect and repair air weapons systems","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42102.00","via":"42102","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3014.00#41","text":"Compile test logs, evaluation reports, equipment maintenance documentation and read and interpret electronic drawings","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42102.00","via":"42102","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3014.00#42","text":"Analyze equipment and system performance on all combat information equipment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3014.00#43","text":"Maintain and operate engineering equipment, including weapons, vehicles, heavy equipment and supplies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3014.00#44","text":"Inspect motors in operation, road test motor vehicles, and test automotive systems and components using computerized diagnostic and other testing devices to diagnose and isolate faults","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3014.00#45","text":"Configure and operate intelligence, surveillance and recognizance systems","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3014.00#46","text":"Oversee the construction of tools and devices to enable infantry soldiers to cross natural and man-made obstacles and break through enemy defenses","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3014.00#47","text":"Operate weapons and missile related equipment for defense.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3014.00#48","text":"Provide assistance in emergency situations, such as civil disorder, natural disasters and major accidents","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3014.00#49","text":"Operate armoured vehicles, artillery, hand-held weapons and other military combat equipment and defense systems","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3014.00#50","text":"Engage in non-combat operations for humanitarian efforts","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3014.00#51","text":"Participate in drills and other training in preparation for peacekeeping, combat and natural disaster relief","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3014.00#52","text":"Maintain weapon systems, vehicles, survival gear and personal defensive equipment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3014.00#53","text":"Perform underwater search and recovery operations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3014.00#54","text":"Use tactics of camouflage and concealment, patrol, attack, defense, and evasion when engaged in combat missions.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null}]}