:"13-2081.00#73","text":"Audit accounting records to determine income, exemptions, payable taxes, compliance with reporting regulations and existence of fraud","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"12104.01","via":"12104","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"13-2081.00#74","text":"Examine accounting systems and internal controls of organizations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"12104.01","via":"12104","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"13-2081.00#75","text":"Provide advice on reporting and evaluation methods for goods subject to taxation","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"12104.01","via":"12104","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"13-2081.00#76","text":"Determine the eligibility of persons applying for government benefits such as Employment Insurance (EI), Canada Pension Plan (CPP) and Old Age Security (OAS)","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"12104.02","via":"12104","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"13-2081.00#77","text":"Ascertain the facts on such issues as reasons for loss of employment and availability for work","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"12104.02","via":"12104","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"13-2081.00#78","text":"Monitor the payments of benefits and investigate claimants when there appears to be fraud or abuse.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"12104.02","via":"12104","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"13-2081.00#79","text":"Conduct interviews, using inspections and information-seeking techniques at border points as part of primary and secondary inspections for immigration, food, plant and animals, and customs program functions","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43203.01","via":"43203","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"13-2081.00#80","text":"Apply applicable legislation, policies, and procedure when screening and/or inspecting people and goods","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43203.01","via":"43203","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"13-2081.00#81","text":"Inspect baggage to detect undeclared merchandise, or contraband","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43203.01","via":"43203","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"13-2081.00#82","text":"Inform manufacturers and shippers of customs and laws and procedures","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43203.01","via":"43203","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"13-2081.00#83","text":"Observe fabrication of articles affected by customs laws and conduct appraisals","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43203.01","via":"43203","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"13-2081.00#84","text":"Board carriers arriving from foreign countries to determine nature of cargo to ensure compliance with customs and commerce laws","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43203.01","via":"43203","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"13-2081.00#85","text":"Inspect goods imported by mail","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43203.01","