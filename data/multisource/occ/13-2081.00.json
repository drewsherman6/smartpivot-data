ct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2081.00#5","text":"Contact taxpayers by mail or telephone to address discrepancies and to request supporting documentation.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"5292","via":"13-2081.00","match":"native","w":0.625}],"n_sources":1,"weight":0.625,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2081.00#6","text":"Answer questions from taxpayers and assist them in completing tax forms.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"20016","via":"13-2081.00","match":"native","w":0.375}],"n_sources":1,"weight":0.375,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2081.00#7","text":"Collect taxes from individuals or businesses according to prescribed laws and regulations.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"5288","via":"13-2081.00","match":"native","w":0.5}],"n_sources":1,"weight":0.5,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2081.00#8","text":"Determine appropriate methods of debt settlement, such as offers of compromise, wage garnishment, or seizure and sale of property.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"5305","via":"13-2081.00","match":"native","w":0.375}],"n_sources":1,"weight":0.375,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2081.00#9","text":"Check tax forms to verify that names and taxpayer identification numbers are correct, that computations have been performed correctly, or that amounts match those on supporting documentation.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"5302","via":"13-2081.00","match":"native","w":0.75}],"n_sources":1,"weight":0.75,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2081.00#10","text":"Examine and analyze tax assets and liabilities to determine resolution of delinquent tax problems.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"5303","via":"13-2081.00","match":"native","w":0.5}],"n_sources":1,"weight":0.5,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2081.00#11","text":"Impose payment deadlines on delinquent taxpayers and monitor payments to ensure that deadlines are met.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"5301","via":"13-2081.00","match":"native","w":0.375}],"n_sources":1,"weight":0.375,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2081.00#12","text":"Direct service of legal documents, such as subpoenas, warrants, notices of assessment, and garnishments.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"5308","via":"13-2081.00","match":"native","w":0.125}],"n_sources":1,"weight":0.125,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2081.00#13","text":"Review filed tax returns to determine whether claimed tax credits and deductions are allowed by law.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"5296","via":"13-2081.00","match":"native","w":0.874}],"n_sources":1,"weight":0.874,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2081.00#14","text":"Maintain knowledge of tax code changes, and of accounting procedures and theory to properly evaluate financial information.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"5289","via":"13-2081.00","match":"native","w":0.5}],"n_sources":1,"weight":0.5,"ai":{"pct":0.911,"anthropic_penetration":0.699,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2081.00#15","text":"Investigate claims of inability to pay taxes by researching court information for the status of liens, mortgages, or financial statements, or by locating assets through third parties.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"5310","via":"13-2081.00","match":"native","w":0.375}],"n_sources":1,"weight":0.375,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2081.00#16","text":"Review selected tax returns to determine the nature and extent of audits to be performed on them.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"5297","via":"13-2081.00","match":"native","w":0.375}],"n_sources":1,"weight":0.375,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2081.00#17","text":"Examine accounting systems and records to determine whether accounting methods used were appropriate and in compliance with statutory provisions.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"5299","via":"13-2081.00","match":"native","w":0.625}],"n_sources":1,"weight":0.625,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2081.00#18","text":"Participate in informal appeals hearings on contested cases from other agents.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"5312","via":"13-2081.00","match":"native","w":0.125}],"n_sources":1,"weight":0.125,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2081.00#19","text":"Prepare briefs and assist in searching and seizing records to prepare charges and documentation for court cases.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"5307","via":"13-2081.00","match":"native","w":0.125},{"source":"oasis","ref":"12104.01","via":"12104","match":"statcan_concordance","w":0.5}],"n_sources":2,"weight":0.5,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2081.00#20","text":"Enter tax return information into computers for processing.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"5298","via":"13-2081.00","match":"native","w":0.25}],"n_sources":1,"weight":0.25,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2081.00#21","text":"Secure a taxpayer's agreement to discharge a tax assessment or submit contested determinations to other administrative or judicial conferees for appeals hearings.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"5306","via":"13-2081.00","match":"native","w":0.25}],"n_sources":1,"weight":0.25,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2081.00#22","text":"inspect tax returns","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/1883a1f5-f190-4ef3-8521-36d8cc6dbb47","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/1883a1f5-f190-4ef3-8521-36d8cc6dbb47","via":"http://data.europa.eu/esco/occupation/4a39fddb-17e7-4431-be03-613edab8d1c8","match":"exactMatch","essential":true,"w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"13-2081.00#23","text":"inform on fiscal duties","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/14464b13-19b5-4403-8c2c-09eb98e28f2f","sources":[{"source":"esco","ref":"http://data.eur