y agree"}}},"statements":[{"id":"49-3043.00#1","text":"Record conditions of cars, and repair and maintenance work performed or to be performed.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9986","via":"49-3043.00","match":"native","w":0.4}],"n_sources":1,"weight":0.4,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-3043.00#2","text":"Inspect components such as bearings, seals, gaskets, wheels, and coupler assemblies to determine if repairs are needed.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9988","via":"49-3043.00","match":"native","w":0.533}],"n_sources":1,"weight":0.533,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-3043.00#3","text":"Repair or replace defective or worn parts such as bearings, pistons, and gears, using hand tools, torque wrenches, power tools, and welding equipment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9984","via":"49-3043.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-3043.00#4","text":"Inspect the interior and exterior of rail cars coming into rail yards to identify defects and to determine the extent of wear and damage.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9989","via":"49-3043.00","match":"native","w":0.466}],"n_sources":1,"weight":0.466,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-3043.00#5","text":"Remove locomotives, car mechanical units, or other components, using pneumatic hoists and jacks, pinch bars, hand tools, and cutting torches.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9987","via":"49-3043.00","match":"native","w":0.533}],"n_sources":1,"weight":0.533,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-3043.00#6","text":"Test units for operability before and after repairs.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9985","via":"49-3043.00","match":"native","w":0.267}],"n_sources":1,"weight":0.267,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-3043.00#7","text":"Adjust repaired or replaced units as needed to ensure proper operation.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9990","via":"49-3043.00","match":"native","w":0.267}],"n_sources":1,"weight":0.267,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-3043.00#8","text":"Repair, fabricate, and install steel or wood fittings, using blueprints, shop sketches, and instruction manuals.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9992","via":"49-3043.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-3043.00#9","text":"Perform scheduled maintenance, and clean units and components.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9991","via":"49-3043.00","match":"native","w":0.4}],"n_sources":1,"weight":0.4,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-3043.00#10","text":"Examine car roofs for wear and damage, and repair defective sections, using roofing material, cement, nails, and waterproof paint.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10000","via":"49-3043.00","match":"native","w":0.133}],"n_so