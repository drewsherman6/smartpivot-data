":0.163,"other_measures_pct":0.738,"other_measures_linked":0.171,"weight_time_weighted":0.5,"weight_other_measures":0.5}}},"statements":[{"id":"47-2053.00#1","text":"Measure designated amounts of ingredients for terrazzo or grout, according to standard formulas and specifications, using graduated containers and scales, and load ingredients into portable mixer.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9825","via":"47-2053.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2053.00#2","text":"Grind surfaces with a power grinder, or polish surfaces with polishing or surfacing machines.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9829","via":"47-2053.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"47-2053.00#3","text":"Cut metal division strips and press them into the terrazzo base for joints or changes of color to form designs or patterns or to help prevent cracks.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9823","via":"47-2053.00","match":"native","w":0.417}],"n_sources":1,"weight":0.417,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2053.00#4","text":"Blend marble chip mixtures, place into panels, and push a roller over the surface to embed the chips.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9824","via":"47-2053.00","match":"native","w":0.417}],"n_sources":1,"weight":0.417,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2053.00#5","text":"Modify mixing, grouting, grinding, or cleaning procedures, according to type of installation or material used.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9831","via":"47-2053.00","match":"native","w":0.083}],"n_sources":1,"weight":0.083,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"47-2053.00#6","text":"Spread, level, or smooth concrete or terrazzo mixtures to form bases or finished surfaces, using rakes, shovels, hand or power trowels, hand or power screeds, or floats.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9827","via":"47-2053.00","match":"native","w":0.583}],"n_sources":1,"weight":0.583,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2053.00#7","text":"Grind curved surfaces or areas inaccessible to surfacing machine, such as stairways or cabinet tops, with portable hand grinder.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9828","via":"47-2053.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2053.00#8","text":"Wash polished terrazzo surface, using cleaner and water, and apply sealer and curing agent according to manufacturer's specifications, using brush or sprayer.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9832","via":"47-2053.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"47-2053.00#9","text":"Position and secure moisture membrane and wire mesh in preparation for pouring base materials for terrazzo installation.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9830","via":"47-2053.00","match":"native","w":0.25}],"n_sources":1,"weight":0.25,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2053.00#10","text":"Fill slight grinding depressions with matching grout material and hand-trowel for a smooth, uniform surface.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9838","via":"47-2053.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2053.00#11","text":"Clean installation site, mixing and storage areas, tools, machines, and equipment, and store materials and equipment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9837","via":"47-2053.00","match":"native","w":0.5}],"n_sources":1,"weight":0.5,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2053.00#12","text":"Sprinkle colored marble or stone chips, powdered steel, or coloring powder over surface to produce prescribed finish.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9834","via":"47-2053.00","match":"native","w":0.167}],"n_sources":1,"weight":0.167,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2053.00#13","text":"Wet surface to prepare for bonding, fill holes and cracks with grout or slurry, and smooth with a trowel.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9835","via":"47-2053.00","match":"native","w":0.167}],"n_sources":1,"weight":0.167,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2053.00#14","text":"Mix cement, sand, and water to produce concrete, grout, or slurry, using hoe, trowel, tamper, scraper, or concrete-mixing machine.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9833","via":"47-2053.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2053.00#15","text":"Chip, scrape, or grind high spots, ridges, or rough projections to finish concrete, using pneumatic chisel, hand chisel, or other hand tools.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9839","via":"47-2053.00","match":"native","w":0.167}],"n_sources":1,"weight":0.167,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2053.00#16","text":"Mold expansion joints and edges, using edging tools, jointers, or straightedges.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9826","via":"47-2053.00","match":"native","w":0.167}],"n_sources":1,"weight":0.167,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2053.00#17","text":"Move terrazzo installation materials, tools, machines, or work devices to work areas, manually or using wheelbarrow.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9841","via":"47-2053.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"47-2053.00#18","text":"Clean chipped area, using wire brush, and feel and observe surface to determine if it is rough or uneven.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9840","via":"47-2053.00","match":"native","w":0.083}],"n_sources":1,"weight":0.083,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2053.00#19","text":"Repair concrete by cutting out damaged areas, drilling holes for reinforcing rods, and positioning reinforcing rods, using power saw and drill.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9836","via":"47-2053.00","match":"native","w":0.083}],"n_sources":1,"weight":0.083,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2053.00#20","text":"Precast terrazzo blocks in wooden forms.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9845","via":"47-2053.00","match":"native","w":0.006}],"n_sources":1,"weight":0.006,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2053.00#21","text":"Wet concrete surface and rub with stone to smooth surface and obtain specified finish.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9848","via":"47-2053.00","match":"native","w":0.006}],"n_sources":1,"weight":0.006,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2053.00#22","text":"Build wooden molds, clamping molds around areas to be repaired, or setting up frames to the proper depth and alignment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9842","via":"47-2053.00","match":"native","w":0.083}],"n_sources":1,"weight":0.083,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2053.00#23","text":"Spread roofing paper on surface of foundation and spread concrete onto roofing paper with trowel to form terrazzo base.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9846","via":"47-2053.00","match":"native","w":0.083}],"n_sources":1,"weight":0.083,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2053.00#24","text":"Produce rough concrete surface, using broom.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9844","via":"47-2053.00","match":"native","w":0.006}],"n_sources":1,"weight":0.006,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2053.00#25","text":"Remove frames when the foundation is dry.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9847","via":"47-2053.00","match":"native","w":0.083}],"n_sources":1,"weight":0.083,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2053.00#26","text":"Signal truck driver to position truck to facilitate pouring concrete and move chute to direct concrete on forms.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9843","via":"47-2053.00","match":"native","w":0.083}],"n_sources":1,"weight":0.083,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2053.00#27","text":"grout terrazzo","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/e602f6c8-dad0-41cd-8379-eb287bc5f29f","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/e602f6c8-dad0-41cd-8379-eb287bc5f29f","via":"http://data.europa.eu/esco/occupation/a50d64e7-2dba-4418-81a7-92b2ba2e508f","match":"broadMatch","essential":true,"w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"47-2053.00#28","text":"inspect construction supplies","kind":"skill","esco_uri":"http://da