:"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-1013.00#4","text":"Respond to and resolve patrons' complaints.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23128","via":"39-1013.00","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-1013.00#5","text":"Greet customers and ask about the quality of service they are receiving.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23132","via":"39-1013.00","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-1013.00#6","text":"Perform minor repairs or make adjustments to slot machines, resolving problems such as machine tilts and coin jams.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23130","via":"39-1013.00","match":"native","w":0.15}],"n_sources":1,"weight":0.15,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-1013.00#7","text":"Maintain familiarity with the games at a facility and with strategies or tricks used by cheaters at such games.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23135","via":"39-1013.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-1013.00#8","text":"Monitor payment of hand-delivered jackpots to ensure promptness.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23131","via":"39-1013.00","match":"native","w":0.15}],"n_sources":1,"weight":0.15,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-1013.00#9","text":"Explain and interpret house rules, such as game rules or betting limits, for patrons.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23134","via":"39-1013.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-1013.00#10","text":"Establish and maintain banks and table limits for each game.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23140","via":"39-1013.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-1013.00#11","text":"Reset slot machines after payoffs.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23136","via":"39-1013.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"39-1013.00#12","text":"Answer patrons' questions about gaming machine functions and payouts.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23137","via":"39-1013.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-1013.00#13","text":"Record the specifics of malfunctioning machines and document malfunctions needing repair.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23138","via":"39-1013.00","match":"native","w":0.05}],"n_sources":1,"weight":0.05,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-1013.00#14","text":"Monitor patrons for signs of compulsive gambling, offering assistance if necessary.","kind":"task","esco_ur