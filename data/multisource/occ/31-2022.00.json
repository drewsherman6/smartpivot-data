robotics":null},{"id":"31-2022.00#73","text":"Carry out treatment programs, document results and develop materials for use with patients, under the supervision of speech-language pathologists or audiologists","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.02","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#74","text":"Document patient rehabilitation progress","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.02","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#75","text":"Check and maintain therapeutic equipment and materials.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.02","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#76","text":"Take patients' general medical and ophthalmic history","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.03","via":"32109","match":"statcan_concordance","w":0.5},{"source":"oasis","ref":"33109.04","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#77","text":"Conduct specialized testing such as refractometry, ultrasonography, fluorescein angiography or ocular motility testing  to aid ophthalmologists in assessing patients' vision","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.03","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#78","text":"Instruct patient on diagnostic test and record, interpret and troubleshoot results","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.03","via":"32109","match":"statcan_concordance","w":0.5},{"source":"oasis","ref":"33109.04","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#79","text":"Assist ophthalmologists in performing ophthalmic procedures, and surgeries","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.03","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#80","text":"Prepare specimens for culture and staining","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.03","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#81","text":"Administer topical ophthalmic or oral medications as directed by ophthalmologists","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.03","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#82","text":"Maintain ophthalmic instruments or equipment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.03","via":"32109","match":"statcan_concordance","w":0.5},{"source":"oasis","ref":"33109.04","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#83","text":"May instruct and supervise other ophthalmic staff and perform various administrative duties","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.03","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#84","text":"May participate in research activities.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.03","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#85","text":"Collect and analyse information from clients' file upon referral from the physiotherapist or physician","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.04","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#86","text":"Develop, implement and monitor treatment plans of clients in collaboration with the physiotherapist or physician","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.04","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#87","text":"Use a variety of therapeutic modalities such as manual techniques (e.g. massage), exercises, electrotherapy, hydrotherapy and thermotherapy (ice or heat) to achieve treatment objectives","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.04","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#88","text":"Advise clients on postures, lifestyle and exercises to help them improve their physical condition.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.04","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#89","text":"Under the direction of physiotherapists and/or occupational therapists, carry out treatment programs such as thermotherapy, traction, hydrotherapy and electrotherapeutic techniques to rehabilitate patients with various injuries or disabilities to maximize their ability to independently manage daily activities.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32109.05","via":"32109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#90","text":"Under the supervision of audiologists, administer tests such as pure tone hearing screening, impedance tests and noise level measurements using equipment such as audiometers and sound level meters to determine hearing thresholds of patients","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.01","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#91","text":"Instruct patients on test procedures and record results","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.01","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#92","text":"Monitor, check and calibrate auditory equipment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.01","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#93","text":"May take earmold impressions and fit and adjust hearing instruments.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.01","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#94","text":"Assist orthopedic surgeons in the treatment of orthopedic diseases and injuries by applying and adjusting casts, splints, bandages and other orthopedic devices","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.02","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#95","text":"Assist in the application, maintenance and adjustment of traction equipment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.02","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#96","text":"Clean and dress wounds","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.02","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#97","text":"Remove casts, sutures, staples and pins","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.02","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#98","text":"Instruct patients and their families and other health care professionals with respect to orthopedic matters.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.02","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#99","text":"Prepare and maintain equipment and supplies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.03","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#100","text":"Assist in activities for the rehabilitation of patients as directed by health care professionals","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.03","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#101","text":"May perform routine office functions.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.03","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#102","text":"Operate ophthalmic testing and measuring instruments to aid ophthalmologists in assessing patients' vision","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.04","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#103","text":"Assist ophthalmologists in minor office surgery","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.04","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#104","text":"Administer eye drops, ointments and medications as directed by ophthalmologists","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.04","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#105","text":"Perform various administrative duties","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.04","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#106","text":"Operate laboratory equipment to grind, cut, polish and edge lenses for eyeglasses according to prescriptions received and fit lenses into frames","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.05","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#107","text":"Make minor repairs for customers such as replacing frame screws or straightening frames","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.05","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#108","text":"Maintain and repair optical laboratory equipment or machinery.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.05","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#109","text":"Operate and maintain sterilization equipment such as instrument washers, sonic sinks, cart washers and steam autoclaves to clean and disinfect trays, carts, linens, supplies, instrumentation and equipment for re-use according to standardized safety practices","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.06","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#110","text":"Reassemble equipment and assemble packs of sterile supplies and instruments for delivery to hospital departments.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.06","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#111","text":"Set up and dismantle equipment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.07","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#112","text":"Prepare and maintain cleanliness of collection areas","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.07","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#113","text":"Maintain supplies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.07","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#114","text":"Monitor donors throughout procedure and assist with post-donation care and donor reaction care as assigned under the supervision of a registered nurse","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.07","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#115","text":"Record information on donors","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.07","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#116","text":"Label and process donated blood.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.07","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#117","text":"Assist pathologists at autopsies by laying out surgical instruments","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.08","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#118","text":"Prepare solutions for preservation of specimens","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.08","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#119","text":"Transfer bodies from morgue to examining table","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.08","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#120","text":"Remove organs and tissue specimens, as instructed by attending pathologist, and placing them in preservative solutions","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.08","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"31-2022.00#121","text":"Clean and sew up bodies for release to funeral home.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33109.08","via":"33109","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null}]}