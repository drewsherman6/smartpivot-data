":"introduce artist to potential employers","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/ab871daf-57f2-469c-a3bc-eefe49713302","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/ab871daf-57f2-469c-a3bc-eefe49713302","via":"http://data.europa.eu/esco/occupation/c85e39a4-2c40-413f-a171-45907ecdd599","match":"narrowMatch","essential":false,"w":0.3}],"n_sources":1,"weight":0.3,"ai":null,"robotics":null},{"id":"27-2012.04#70","text":"liaise with book publishers","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/3882c29a-a3b4-48be-8349-00958cdfdc58","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/3882c29a-a3b4-48be-8349-00958cdfdc58","via":"http://data.europa.eu/esco/occupation/c85e39a4-2c40-413f-a171-45907ecdd599","match":"narrowMatch","essential":false,"w":0.3}],"n_sources":1,"weight":0.3,"ai":null,"robotics":null},{"id":"27-2012.04#71","text":"Choosing writers, studying scripts to determine artistic interpretation, and instructing actors on acting methods","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2654-1","via":"2654","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.755,"anthropic_penetration":null,"ilo_2025":0.4075,"basis":"direct"},"robotics":null},{"id":"27-2012.04#72","text":"Directing all aspects of dramatic productions on stage, television, radio or in motion pictures, including choice of actors, and final decisions concerning costumes, set designs, sound or lighting effects","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2654-2","via":"2654","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.483,"anthropic_penetration":null,"ilo_2025":0.2725,"basis":"direct"},"robotics":null},{"id":"27-2012.04#73","text":"Planning, organizing and controlling the various stages and scheduling involved in the production of presentations, motion pictures, television shows and radio programmes","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2654-3","via":"2654","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.754,"anthropic_penetration":null,"ilo_2025":0.406,"basis":"direct"},"robotics":null},{"id":"27-2012.04#74","text":"Engaging and supervising all technical personnel, and determining the treatment, scope and scheduling of production","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2654-4","via":"2654","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.589,"anthropic_penetration":null,"ilo_2025":0.3225,"basis":"direct"},"robotics":null},{"id":"27-2012.04#75","text":"Maintaining production archives and negotiating royalties","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2654-5","via":"2654","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.756,"anthropic_penetration":null,"ilo_2025":0.41,"basis":"direct"},"robotics":null},{"id":"27-2012.04#76","text":"Creating, planning, writing scripts for recording, videotaping and editing programmes","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2654-6","via":"2654","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.809,"anthropic_penetration":null,"ilo_2025":0.45,"basis":"direct"},"robotics":null},{"id":"27-2012.04#77","text":"Supervising the positioning of scenery, props and lighting and sound equipment.","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2654-7","via":"2654","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.524,"anthropic_penetration":null,"ilo_2025":0.2875,"basis":"direct"},"robotics":null},{"id":"27-2012.04#78","text":"Plan, organize and control the various stages and scheduling involved in the production of presentations, motion pictures, television shows and radio programs; engage directors and other production personnel and supervise all technical personnel, and determine the treatment, scope and scheduling of production; maintain production archives, negotiate royalties, and may plan and control the budget pertaining to a particular production.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"51120.01","via":"51120","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"27-2012.04#79","text":"Interpret scripts and direct the mise-en-scène; select and direct the actors, extras and technical crew; advise the cast and crew on the interpretation and delivery of the performance; direct rehearsals, filmings, broadcasts and performances; and confer with crew and specialists throughout production and post-production to achieve desired presentation.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"51120.02","via":"51120","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"27-2012.04#80","text":"Create dances for film, theatre and television performances that convey stories, ideas and moods, and direct rehearsals for dancers to achieve desired interpretation.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"51120.03","via":"51120","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"27-2012.04#81","text":"Plan, organize and direct the artistic aspects of motion pictures, video games, stage productions and television shows by overseeing the design of sets, costumes, furnishings and props to create portrayals of period and setting.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"51120.04","via":"51120","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"27-2012.04#82","text":"Edit motion picture film and arrange film segments into sequences to achieve continuity and desired dramatic, comedic and thematic effects.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"51120.05","via":"51120","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"27-2012.04#83","text":"Plan and coordinate the production of musical recordings, direct musicians and singers during rehearsals and recordings and manage technicians involved in duplicating, dubbing and mastering of recordings.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"51120.06","via":"51120","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"27-2012.04#84","text":"Coordinate and direct the photography of motion pictures, supervise camera operators and other crews and determine lighting, lenses, camera angles, backgrounds and other elements to achieve desired visual effect.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"51120.07","via":"51120","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"27-2012.04#85","text":"Coordinate the work of camera operators and other technical staff, and cue announcers, actors and performers during news broadcasts and television program tapings.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"52119.01","via":"52119","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"27-2012.04#86","text":"Supervise grips, gaffers and stagehands who rig, place, move and dismantle lights, sets, backdrops, scenery and other stage equipment.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"52119.02","via":"52119","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"27-2012.04#87","text":"Set up, operate and make repairs to lights and other electrical equipment in studios and on sets and stages.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"52119.03","via":"52119","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"27-2012.04#88","text":"Design and coordinate special effects such as fires, explosions and crashes.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"52119.04","via":"52119","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"27-2012.04#89","text":"Apply cosmetic and special effects make-up on actors and other performers.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"52119.05","via":"52119","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"27-2012.04#90","text":"Study scripts to determine the necessary costumes and oversee the acquisition, fitting and maintenance of costumes.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"52119.06","via":"52119","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"27-2012.04#91","text":"Assist in preparing the construction specifications for sets","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"52119.07","via":"52119","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"27-2012.04#92","text":"Identify and list the necessary props and place them during rehearsals and performances.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"52119.07","via":"52119","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null}]}