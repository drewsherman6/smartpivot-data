{"tier":"E0","score":0,"basis":"direct"}},{"id":"23-2099.00#5","text":"Prepare lists of all legal instruments applying to a specific piece of land and the buildings on it.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9230","via":"23-2099.00","match":"native","w":0.267}],"n_sources":1,"weight":0.267,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"23-2099.00#6","text":"Copy or summarize recorded documents, such as mortgages, trust deeds, and contracts, that affect property titles.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9233","via":"23-2099.00","match":"native","w":0.4}],"n_sources":1,"weight":0.4,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"23-2099.00#7","text":"Verify accuracy and completeness of land-related documents accepted for registration, preparing rejection notices when documents are not acceptable.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9236","via":"23-2099.00","match":"native","w":0.267}],"n_sources":1,"weight":0.267,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"23-2099.00#8","text":"Read search requests to ascertain types of title evidence required and to obtain descriptions of properties and names of involved parties.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9232","via":"23-2099.00","match":"native","w":0.267}],"n_sources":1,"weight":0.267,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"23-2099.00#9","text":"Retrieve and examine real estate closing files for accuracy and to ensure that information included is recorded and executed according to regulations.","kind":"task","esco_uri":null,"sources":[{"source":"onet",