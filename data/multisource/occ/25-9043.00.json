ct"}},{"id":"25-9043.00#6","text":"Tutor and assist children individually or in small groups to help them master assignments and to reinforce learning concepts presented by teachers.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"22512","via":"25-9043.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.984,"anthropic_penetration":0.98,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"25-9043.00#7","text":"Employ special educational strategies or techniques during instruction to improve the development of sensory- and perceptual-motor skills, language, cognition, or memory.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"22491","via":"25-9043.00","match":"native","w":0.375}],"n_sources":1,"weight":0.375,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"25-9043.00#8","text":"Enforce administration policies and rules governing students.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"22492","via":"25-9043.00","match":"native","w":0.25}],"n_sources":1,"weight":0.25,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"25-9043.00#9","text":"Observe students' performance, and record relevant data to assess progress.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"22498","via":"25-9043.00","match":"native","w":0.5}],"n_sources":1,"weight":0.5,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"25-9043.00#10","text":"Instruct and monitor students in the use and care of equipment and materials to prevent injuries and damage.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"22494","via":"25-9043.00","match":"native","w":0.125}],"n_sources":1,"weight":0.125,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"25-9043.00#11","text":"Present subject matter to students under the direction and guidance of teachers, using lectures, discussions, supervised role-playing methods, or by reading aloud.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"22505","via":"25-9043.00","match":"native","w":0.25}],"n_sources":1,"weight":0.25,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"25-9043.00#12","text":"Discuss assigned duties with classroom teachers to coordinate instructional efforts.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"22489","via":"25-9043.00","match":"native","w":0.25}],"n_sources":1,"weight":0.25,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"25-9043.00#13","text":"Instruct students in daily living skills required for independent maintenance and self-sufficiency, such as hygiene, safety, or food preparation.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"22495","via":"25-9043.00","match":"native","w":0.375}],"n_sources":1,"weight":0.375,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"25-9043.00#14","text":"Prepare classrooms with a variety of materials or resources for children to explore, manipulate, or use in learning activities or imaginative play.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"22502","via":"25-9043.00","match":"native","w":0.125}],"n_sources":1,"weight":0.125,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"25-9043.00#15","text":"Distribute teaching materials, such as textbooks, workbooks, papers, and pencils, to stude