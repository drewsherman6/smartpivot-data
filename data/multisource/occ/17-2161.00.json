tatements, reports, or presentations for regulatory or other agencies.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"19643","via":"17-2161.00","match":"native","w":0.571}],"n_sources":1,"weight":0.571,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-2161.00#11","text":"Develop or contribute to the development of plans to remediate or restore environments affected by nuclear radiation, such as waste disposal sites.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"19641","via":"17-2161.00","match":"native","w":0.286}],"n_sources":1,"weight":0.286,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-2161.00#12","text":"Conduct tests of nuclear fuel behavior and cycles or performance of nuclear machinery and equipment to optimize performance of existing plants.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"5388","via":"17-2161.00","match":"native","w":0.714}],"n_sources":1,"weight":0.714,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-2161.00#13","text":"Design fuel cycle models or processes to reduce the quantity of radioactive waste generated from nuclear activities.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"19640","via":"17-2161.00","match":"native","w":0.286}],"n_sources":1,"weight":0.286,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-2161.00#14","text":"Consult with other scientists to determine parameters of experimentation or suitability of analytical models.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"20958","via":"17-2161.00","match":"native","w":0.571}],"n_sources":1,"weight":0.571,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-2161.00#15","text":"Recommend preventive measures to be taken in the handling of nuclear technology, based on data obtained from operations monitoring or from evaluation of test results.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"5386","via":"17-2161.00","match":"native","w":0.571}],"n_sources":1,"weight":0.571,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-2161.00#16","text":"Discuss construction project proposals with interested parties, such as vendors, contractors, or nuclear facility review boards.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"20959","via":"17-2161.00","match":"native","w":0.571}],"n_sources":1,"weight":0.571,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-2161.00#17","text":"Perform experiments that will provide information about acceptable methods of nuclear material usage, nuclear fuel reclamation, or waste disposal.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"5382","via":"17-2161.00","match":"native","w":0.429}],"n_sources":1,"weight":0.429,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"17-2161.00#18","text":"Conduct environmental studies on topics such as nuclear power generation, nuclear waste disposal, or nuclear weapon deployment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"19639","via":"17-2161.00","match":"native","w":0.286}],"n_sources":1,"weight":0.286,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-2161.00#19","text":"Design or direct nuclear research projects to develop, test, m