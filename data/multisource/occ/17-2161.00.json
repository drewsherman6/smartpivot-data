1}}},"statements":[{"id":"17-2161.00#1","text":"Design or develop nuclear equipment, such as reactor cores, radiation shielding, or associated instrumentation or control mechanisms.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"5384","via":"17-2161.00","match":"native","w":1},{"source":"ilo","ref":"2149-6","via":"2149","match":"bls_crosswalk","w":1}],"n_sources":2,"weight":1,"ai":{"pct":0.286,"anthropic_penetration":0,"ilo_2025":0.315,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-2161.00#2","text":"Monitor nuclear facility operations to identify any design, construction, or operation practices that violate safety regulations and laws or could jeopardize safe operations.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"5380","via":"17-2161.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-2161.00#3","text":"Initiate corrective actions or order plant shutdowns in emergency situations.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"5385","via":"17-2161.00","match":"native","w":0.286}],"n_sources":1,"weight":0.286,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-2161.00#4","text":"Examine accidents to obtain data for use in design of preventive measures.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"5379","via":"17-2161.00","match":"native","w":0.286}],"n_sources":1,"weight":0.286,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-2161.00#5","text":"Direct operating or maintenance activities of nuclear power plants to ensure efficiency and conformity to safety standards.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"5389","via":"17-