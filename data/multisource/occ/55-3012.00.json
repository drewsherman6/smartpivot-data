der the influence of alcohol and drugs","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3012.00#33","text":"Control crowds at public events and protests and monitor suspicious and violent behaviour","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3012.00#34","text":"Participate in crime prevention, public information, safety and community relations programs","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3012.00#35","text":"Perform daily administrative tasks in support of law enforcement activities, such as maintaining equipment and information files","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3012.00#36","text":"May assist police investigators in criminal investigations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3012.00#37","text":"Certify ammunition, explosive items, munitions and non-munitions scrap to different degrees of classification","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42102.00","via":"42102","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3012.00#38","text":"Inspect, test, identify faults, adjust, repair, recondition and modify electrical, electromechanical, electronic, electro-optic and mechanical equipment, optical instruments, and control systems for weapons and missiles","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42102.00","via":"42102","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3012.00#39","text":"Maintain and repair machine-guns and non-guided anti-tank weapons, grenade projectors, mortars and launcher systems","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42102.00","via":"42102","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3012.00#40","text":"Test, inspect and repair air weapons systems","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42102.00","via":"42102","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3012.00#41","text":"Compile test logs, evaluation reports, equipment maintenance documentation and read and interpret electronic drawings","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42102.00","via":"42102","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3012.00#42","text":"Analyze equipment and system performance on all combat information equipment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3012.00#43","text":"Maintain and operate engineering equipment, including weapons, vehicles, heavy equipment and supplies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3012.00#44","text":"Inspect motors in operation, road test motor vehicles, and test automotive systems and components using computerized diagnostic and other testing devices to diagnose and isolate faults","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3012.00#45","text":"Configure and operate intelligence, surveillance and recognizance systems","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3012.00#46","text":"Oversee the construction of tools and devices to enable infantry soldiers to cross natural and man-made obstacles and break through enemy defenses","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3012.00#47","text":"Operate weapons and missile related equipment for defense.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3012.00#48","text":"Provide assistance in emergency situations, such as civil disorder, natural disasters and major accidents","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3012.00#49","text":"Operate armoured vehicles, artillery, hand-held weapons and other military combat equipment and defense systems","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3012.00#50","text":"Engage in non-combat operations for humanitarian efforts","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3012.00#51","text":"Participate in drills and other training in preparation for peacekeeping, combat and natural disaster relief","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3012.00#52","text":"Maintain weapon systems, vehicles, survival gear and personal defensive equipment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3012.00#53","text":"Perform underwater search and recovery operations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3012.00#54","text":"Use tactics of camouflage and concealment, patrol, attack, defense, and evasion when engaged in combat missions.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null}]}