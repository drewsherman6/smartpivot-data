enetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1126.00#5","text":"Provide emergency care, such as artificial respiration, external cardiac massage, or assistance with cardiopulmonary resuscitation.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"398","via":"29-1126.00","match":"native","w":0.231}],"n_sources":1,"weight":0.231,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1126.00#6","text":"Enforce safety rules and ensure careful adherence to physicians' orders.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"403","via":"29-1126.00","match":"native","w":0.154}],"n_sources":1,"weight":0.154,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1126.00#7","text":"Work as part of a team of physicians, nurses, or other healthcare professionals to manage patient care by assisting with medical procedures or related duties.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"18522","via":"29-1126.00","match":"native","w":0.308}],"n_sources":1,"weight":0.308,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1126.00#8","text":"Maintain charts that contain patients' pertinent identification and therapy information.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"404","via":"29-1126.00","match":"native","w":0.615}],"n_sources":1,"weight":0.615,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1126.00#9","text":"Make emergency visits to resolve equipment problems.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"414","via":"29-1126.00","match":"native","w":0.077}],"n_sources":1,"weight":0.077,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1126.00#10","text":"Determine requirements for treatment, such as type, method and duration of therapy, precautions to be taken, or medication and dosages, compatible with physicians' orders.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"399","via":"29-1126.00","match":"native","w":0.231}],"n_sources":1,"weight":0.231,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1126.00#11","text":"Inspect, clean, test, and maintain respiratory therapy equipment to ensure equipment is functioning safely and efficiently, ordering repairs when necessary.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"405","via":"29-1126.00","match":"native","w":0.385}],"n_sources":1,"weight":0.385,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"29-1126.00#12","text":"Explain treatment procedures to patients to gain cooperation and allay fears.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"407","via":"29-1126.00","match":"native","w":0.231}],"n_sources":1,"weight":0.231,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1126.00#13","text":"Perform bronchopulmonary drainage and assist or instruct patients in performance of breathing exercises.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"410","via":"29-1126.00","match":"native","w":0.231}],"n_sources":1,"weight":0.231,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"29-1126.00#14","text":"Demonstrate respiratory care procedures to trainees or other healthcare personnel.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"411","via":"29-1126.00","match":"native","w":0.077}],"n_sources":1,"weight":0.077,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1126.00#15","text":"Perform pulmonary function and adjust equipment to obtain optimum results in therapy.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"409","via":"29-1126.00","match":"native","w":0.154}],"n_sources":1,"weight":0.154,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1126.00#16","text":"Educate patients and their families about their conditions and teach appropriate disease management techniques, such as breathing exercises or the use of medications or respiratory equipment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"406","via":"29-1126.00","match":"native","w":0.231}],"n_sources":1,"weight":0.231,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1126.00#17","text":"Conduct tests, such as electrocardiograms (EKGs), stress testing, or lung capacity tests, to evaluate patients' cardiopulmonary functions.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"415","via":"29-1126.00","match":"native","w":0.154}],"n_sources":1,"weight":0.154,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1126.00#18","text":"Perform endotracheal intubation to maintain open airways for patients who are unable to breathe on their own.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"20410","via":"29-1126.00","match":"native","w":0.077}],"n_sources":1,"weight":0.077,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1126.00#19","text":"Teach, train, supervise, or use the assistance of students, respiratory therapy technicians, or assistants.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"412","via":"29-1126.00","match":"native","w":0.077}],"n_sources":1,"weight":0.077,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1126.00#20","text":"Use a variety of testing techniques to assist doctors in cardiac or pulmonary research or to diagnose disorders.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"413","via":"29-1126.00","match":"native","w":0.077}],"n_sources":1,"weight":0.077,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1126.00#21","text":"Monitor cardiac patients, using electrocardiography devices, such as a holter monitor.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"20411","via":"29-1126.00","match":"native","w":0.077}],"n_sources":1,"weight":0.077,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1126.00#22","text":"Transport patients to the hospital or within the hospital.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"20409","via":"29-1126.00","match":"native","w":0.077}],"n_sources":1,"weight":0.077,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1126.00#23","text":"Attend high-risk and caesarian section infant deliveries to provide neonatal respiratory care as needed.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"24033","via":"29-1126.00","match":"native","w":0.006}],"n_sources":1,"weight":0.006,"ai":null,"robotics":null},{"id":"29-1126.00#24","text":"clinical perfusion","kind":"knowled