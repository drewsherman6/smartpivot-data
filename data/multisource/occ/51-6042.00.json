sures":[{"id":"robot_targeted_share","label":"Share of work time covered by commercial/deployed robots","raw":0.058,"pct":0.646}]},"frey_osborne":{"label":"Frey & Osborne (2013) probability of computerisation (supporting, half weight)","weight":0.5,"share_of_other_measures":0.167,"score":0.94,"measures":[{"id":"frey_osborne_rob","label":"Frey-Osborne probability of computerisation (SOC 2010 via BLS 2010-2018)","raw":0.97,"pct":0.94}]}},"agreement":{"families":4,"sd":0.307,"range":0.77,"label":"sources disagree"},"headline":{"value":0.343,"time_weighted_tasks":0.351,"other_measures_pct":0.692,"other_measures_linked":0.271,"weight_time_weighted":0.9,"weight_other_measures":0.1}}},"statements":[{"id":"51-6042.00#1","text":"Inspect finished products to ensure that shoes have been completed according to specifications.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"24000","via":"51-6042.00","match":"native","w":0.143}],"n_sources":1,"weight":0.143,"ai":null,"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6042.00#2","text":"Align parts to be stitched, following seams, edges, or markings, before positioning them under needles.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14094","via":"51-6042.00","match":"native","w":0.286}],"n_sources":1,"weight":0.286,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6042.00#3","text":"Operate or tend machines to join, decorate, reinforce, or finish shoes and shoe parts.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14100","via":"51-6042.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6042.00#4","text":"Remove and examine shoes, shoe parts, and designs to verify conformance to specifications such as proper embedding of stitches in channels.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14090","via":"51-6042.00","match":"native","w":0.178}],"n_sources":1,"weight":0.178,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6042.00#5","text":"Switch on machines, lower pressure feet or rollers to secure parts, and start machine stitching, using hand, foot, or knee controls.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14096","via":"51-6042.00","match":"native","w":0.25}],"n_sources":1,"weight":0.25,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6042.00#6","text":"Draw thread through machine guide slots, needles, and presser feet in preparation for stitching, or load rolls of wire through machine axles.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14101","via":"51-6042.00","match":"native","w":0.072}],"n_sources":1,"weight":0.072,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6042.00#7","text":"Study work orders or shoe part tags to obtain information about workloads, specifications, and the types of materials to be used.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14089","via":"51-6042.00","match":"native","w":0.072}],"n_sources":1,"weight":0.072,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-6042.00#8","text":"Perform routine equipment maintenance such as cleaning and lubricating machines or replacing broken needles.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14091","via":"51-6042.00","match":"native","w":0.107}],"n_sources":1,"weight":0.107,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6042.00#9","text":"Test machinery to ensure proper functioning before beginning production.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14099","via":"51-6042.00","match":"native","w":0.036}],"n_sources":1,"weight":0.036,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6042.00#10","text":"Select and place spools of thread or pre-wound bobbins into shuttles, or onto spindles or loupers of stitching machines.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14105","via":"51-6042.00","match":"native","w":0.072}],"n_sources":1,"weight":0.072,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6042.00#11","text":"Cut excess thread or material from shoe parts, using scissors or knives.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14092","via":"51-6042.00","match":"native","w":0.107}],"n_sources":1,"weight":0.107,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6042.00#12","text":"Turn knobs to adjust stitch length and thread tension.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14107","via":"51-6042.00","match":"native","w":0.036}],"n_sources":1,"weight":0.036,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"51-6042.00#13","text":"Fill shuttle spools with thread from a machine's bobbin winder by pressing a foot treadle.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14102","via":"51-6042.00","match":"native","w":0.036}],"n_sources":1,"weight":0.036,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6042.00#14","text":"Staple sides of shoes, pressing a foot treadle to position and hold each shoe under the feeder of the machine.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14104","via":"51-6042.00","match":"native","w":0.072}],"n_sources":1,"weight":0.072,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6042.00#15","text":"Position dies on material in a manner that will obtain the maximum number of parts from each portion of material.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14098","via":"51-6042.00","match":"native","w":0.036}],"n_sources":1,"weight":0.036,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6042.00#16","text":"Collect shoe parts from conveyer belts or racks and place them in machinery such as ovens or on molds for dressing, returning them to conveyers or racks to send them to the next work station.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14097","via":"51-6042.00","match":"native","w":0.178}],"n_sources":1,"weight":0.178,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"51-6042.00#17","text":"Turn setscrews on needle bars, and position required numbers of needles in stitching machines.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14095","via":"51-6042.00","match":"native","w":0.036}],"n_sources":1,"weight":0.036,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6042.00#18","text":"Turn screws to regulate size of staples.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14093","via":"51-6042.00","match":"native","w":0.003}],"n_sources":1,"weight":0.003,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6042.00#19","text":"Hammer loose staples for proper attachment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14106","via":"51-6042.00","match":"native","w":0.036}],"n_sources":1,"weight":0.036,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6042.00#20","text":"footwear materials","kind":"knowledge","esco_uri":"http://data.europa.eu/esco/skill/a4cfad38-109a-4a61-8d01-98fd8cf001ce","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/a4cfad38-109a-4a61-8d01-98fd8cf001ce","via":"http://data.europa.eu/esco/occupation/4a246568-007e-46a8-a151-b98082ed6b50","match":"broadMatch","essential":true,"w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"51-6042.00#21","text":"assembling processes and techniques for cemented footwear construction","kind":"knowledge","esco_uri":"http://data.europa.eu/esco/skill/2200e940-ad43-4828-8727-47c4afcbc351","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/2200e940-ad43-4828-8727-47c4afcbc351","via":"http://data.europa.eu/esco/occupation/4a246568-007e-46a8-a151-b98082ed6b50","match":"broadMatch","essential":true,"w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"51-6042.00#22","text":"footwear machinery","kind":"knowledge","esco_uri":"http://data.europa.eu/esco/skill/acb43107-4354-40a5-8a82-9b9264fafacf","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/acb43107-4354-40a5-8a82-9b9264fafacf","via":"http://data.europa.eu/esco/occupation/4a246568-007e-46a8-a151-b98082ed6b50","match":"broa