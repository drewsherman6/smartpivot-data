ty","esco_uri":null,"sources":[{"source":"oasis","ref":"20011.02","via":"20011","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"11-9121.01#79","text":"Develop client relationships and communicate with clients to explain proposals, present research findings, establish specifications, or discuss project status","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"20011.02","via":"20011","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"11-9121.01#80","text":"Review project activities, prepare and review research, testing, or operational reports","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"20011.02","via":"20011","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"11-9121.01#81","text":"May participate directly in the design, development and inspection of the theoretical or applied scientific work of the department.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"20011.02","via":"20011","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null}]}