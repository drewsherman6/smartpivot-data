 of study protocols including guidelines for administration or data collection procedures.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"15596","via":"11-9121.01","match":"native","w":0.111}],"n_sources":1,"weight":0.111,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"11-9121.01#22","text":"Confer with health care professionals to determine the best recruitment practices for studies.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"15591","via":"11-9121.01","match":"native","w":0.111}],"n_sources":1,"weight":0.111,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"11-9121.01#23","text":"Communicate with laboratories or investigators regarding laboratory findings.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"15607","via":"11-9121.01","match":"native","w":0.222}],"n_sources":1,"weight":0.222,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"11-9121.01#24","text":"Review scientific literature, participate in continuing education activities, or attend conferences and seminars to maintain current knowledge of clinical studies affairs and issues.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"15583","via":"11-9121.01","match":"native","w":0.111}],"n_sources":1,"weight":0.111,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"11-9121.01#25","text":"Organize space for study equipment and supplies.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"15599","via":"11-9121.01","match":"native","w":0.111}],"n_sources":1,"weight":0.111,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"