","score":0,"basis":"direct"}},{"id":"11-9121.01#7","text":"Monitor study activities to ensure compliance with protocols and with all relevant local, federal, and state regulatory and institutional polices.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"15613","via":"11-9121.01","match":"native","w":0.444}],"n_sources":1,"weight":0.444,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"11-9121.01#8","text":"Oversee subject enrollment to ensure that informed consent is properly obtained and documented.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"15597","via":"11-9121.01","match":"native","w":0.444}],"n_sources":1,"weight":0.444,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"11-9121.01#9","text":"Maintain required records of study activity including case report forms, drug dispensation records, or regulatory forms.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"15614","via":"11-9121.01","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"11-9121.01#10","text":"Identify protocol problems, inform investigators of problems, or assist in problem resolution efforts, such as protocol revisions.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"15603","via":"11-9121.01","match":"native","w":0.222}],"n_sources":1,"weight":0.222,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"11-9121.01#11","text":"Review proposed study protocols to evaluate factors such as sample collection processes, data management plans, or potential subject risks.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"15593","via":"11-9121.01","match":"native","w":0.222}],"n_sources":1,"weight":0.222,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"11-9121.01#12","text":"Collaborate with investigators to prepare presentations or reports of clinical study procedures, results, and conclusions.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"15608","via":"11-9121.01","match":"native","w":0.111}],"n_sources":1,"weight":0.111,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"11-9121.01#13","text":"Track enrollment status of subjects and document dropout information such as dropout causes and subject contact efforts.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"15592","via":"11-9121.01","match":"native","w":0.222}],"n_sources":1,"weight":0.222,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"11-9121.01#14","text":"Code, evaluate, or interpret collected study data.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"15609","via":"11-9121.01","match":"native","w":0.222}],"n_sources":1,"weight":0.222,"ai":{"pct":0.984,"anthropic_penetration":0.98,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"11-9121.01#15","text":"Direct the requisition, collection, labeling, storage, or shipment of specimens.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"15605","via":"11-9121.01","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"11-9121.01#16","text":"Instruct research staff in scientific and procedural aspects of studies including standards of care, informed consent procedures, or documentation proce