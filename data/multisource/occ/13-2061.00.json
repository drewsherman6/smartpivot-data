rustees, senior management, counsels, outside accountants, and consultants to gather information and discuss findings.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7324","via":"13-2061.00","match":"native","w":0.538}],"n_sources":1,"weight":0.538,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2061.00#2","text":"Recommend actions to ensure compliance with laws and regulations, or to protect solvency of institutions.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7317","via":"13-2061.00","match":"native","w":0.462}],"n_sources":1,"weight":0.462,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2061.00#3","text":"Prepare reports, exhibits, and other supporting schedules that detail an institution's safety and soundness, compliance with laws and regulations, and recommended solutions to questionable financial conditions.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7319","via":"13-2061.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2061.00#4","text":"Resolve problems concerning the overall financial integrity of banking institutions including loan investment portfolios, capital, earnings, and specific or large troubled accounts.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7327","via":"13-2061.00","match":"native","w":0.462}],"n_sources":1,"weight":0.462,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2061.00#5","text":"Investigate activities of institutions to enforce laws and regulations and to ensure legality of transactions and operations or financial solvency.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7314","via":"13-2061.00","match":"native","w":0.846}],"n_sources":1,"weight":0.846,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2061.00#6","text":"Review balance sheets, operating income and expense accounts, and loan documentation to confirm institution assets and liabilities.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7320","via":"13-2061.00","match":"native","w":0.923}],"n_sources":1,"weight":0.923,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2061.00#7","text":"Plan, supervise, and review work of assigned subordinates.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7316","via":"13-2061.00","match":"native","w":0.308}],"n_sources":1,"weight":0.308,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2061.00#8","text":"Review audit reports of internal and external auditors to monitor adequacy of scope of reports or to discover specific weaknesses in internal routines.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7321","via":"13-2061.00","match":"native","w":0.308}],"n_sources":1,"weight":0.308,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2061.00#9","text":"Examine the minutes of meetings of directors, stockholders, and committees to investigate the specific authority extended at various levels of management.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7318","via":"13-2061.00","match":"native","w":0.154}],"n_sources":1,"weight":0.154,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2061.00#10","text":"Train other examiners in the financial examination process.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7322","via":"13-2061.00","match":"native","w":0.154}],"n_sources":1,"weight":0.154,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2061.00#11","text":"Establish guidelines for procedures and policies that comply with new and revised regulations and direct their implementation.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7323","via":"13-2061.00","match":"native","w":0.154}],"n_sources":1,"weight":0.154,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2061.00#12","text":"Review and analyze new, proposed, or revised laws, regulations, policies, and procedures to interpret their meaning and determine their impact.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7315","via":"13-2061.00","match":"native","w":0.308}],"n_sources":1,"weight":0.308,"ai":{"pct":0.937,"anthropic_penetration":0.842,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2061.00#13","text":"Provide regulatory compliance training to employees.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"20190","via":"13-2061.00","match":"native","w":0.077}],"n_sources":1,"weight":0.077,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2061.00#14","text":"Evaluate data processing applications for institutions under examination to develop recommendations for coordinating existing systems with examination procedures.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7328","via":"13-2061.00","match":"native","w":0.154}],"n_sources":1,"weight":0.154,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2061.00#15","text":"Review applications for mergers, acquisitions, establishment of new institutions, acceptance in Federal Reserve System, or registration of securities sales to determine their public interest value and conformance to regulations, and recommend acceptance or rejection.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7326","via":"13-2061.00","match":"native","w":0.077}],"n_sources":1,"weight":0.077,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2061.00#16","text":"Verify and inspect cash reserves, assigned collateral, and bank-owned securities to check internal control procedures.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7325","via":"13-2061.00","match":"native","w":0.154}],"n_sources":1,"weight":0.154,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2061.00#17","text":"Confer with officials of real estate, securities, or financial institution industries to exchange views and discuss issues or pending cases.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7329","via":"13-2061.00","match":"native","w":0.154}],"n_sources":1,"weight":0.154,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"13-2061.00#18","text":"accounting","kind":"knowledge","esco_uri":"http://data.europa.eu/esco/skill/ecc18804-a466-40d9-98b4-fba5cd67dd4b","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/ecc18804-a466-40d9-98b4-fba5cd67dd4b","via":"http://data.europa.eu/esco/occupation/1ad59946-d13e-441e-9b36-56e1df055e21","match":"exactMatch","essential":true,"w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"13-2061.00#19","text":"prepare financial auditing reports"