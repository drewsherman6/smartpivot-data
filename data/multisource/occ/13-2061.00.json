","match":"exactMatch","essential":false,"w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"13-2061.00#68","text":"financial management","kind":"knowledge","esco_uri":"http://data.europa.eu/esco/skill/52e53619-fa77-4f72-b237-5e4aae784dc2","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/52e53619-fa77-4f72-b237-5e4aae784dc2","via":"http://data.europa.eu/esco/occupation/1ad59946-d13e-441e-9b36-56e1df055e21","match":"exactMatch","essential":false,"w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"13-2061.00#69","text":"liaise with shareholders","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/8f9e8842-94f3-48d5-8d09-c43829bcabc5","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/8f9e8842-94f3-48d5-8d09-c43829bcabc5","via":"http://data.europa.eu/esco/occupation/1ad59946-d13e-441e-9b36-56e1df055e21","match":"exactMatch","essential":false,"w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"13-2061.00#70","text":"ensure compliance with disclosure criteria of accounting information","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/da629999-d226-4ff3-9e1a-01788132664f","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/da629999-d226-4ff3-9e1a-01788132664f","via":"http://data.europa.eu/esco/occupation/1ad59946-d13e-441e-9b36-56e1df055e21","match":"exactMatch","essential":false,"w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"13-2061.00#71","text":"insolvency law","kind":"knowledge","esco_uri":"http://data.europa.eu/esco/skill/91003b4a-f2aa-4472-a9c1-4597abb518f2","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/91003b4a-f2aa-4472-a9c1-4597abb518f2","via":"http://data.europa.eu/esco/occupation/1ad59946-d13e-441e-9b36-56e1df055e21","match":"exactMatch","essential":false,"w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"13-2061.00#72","text":"international tariffs","kind":"knowledge","esco_uri":"http://data.europa.eu/esco/skill/21a3967a-dca2-4efa-9e5f-943f15527a47","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/21a3967a-dca2-4efa-9e5f-943f15527a47","via":"http://data.europa.eu/esco/occupation/1ad59946-d13e-441e-9b36-56e1df055e21","match":"exactMatch","essential":false,"w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"13-2061.00#73","text":"evaluate budgets","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/6556cbf1-d5c0-4f53-89a9-8707066069a6","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/6556cbf1-d5c0-4f53-89a9-8707066069a6","via":"http://data.europa.eu/esco/occupation/1ad59946-d13e-441e-9b36-56e1df055e21","match":"exactMatch","essential":false,"w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"13-2061.00#74","text":"internal auditing","kind":"knowledge","esco_uri":"http://data.europa.eu/esco/skill/8804d963-5a31-4609-b5df-f741b7199fb7","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/8804d963-5a31-4609-b5df-f741b7199fb7","via":"http://data.europa.eu/esco/occupation/1ad59946-d13e-441e-9b36-56e1df055e21","match":"exactMatch","essential":false,"w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"13-2061.00#75","text":"identify accounting errors","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/8a326ee1-169c-4c44-b38b-8f1bb20ec79b","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/8a326ee1-169c-4c44-b38b-8f1bb20ec79b","via":"http://data.europa.eu/esco/occupation/1ad59946-d13e-441e-9b36-56e1df055e21","match":"exactMatch","essential":false,"w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"13-2061.00#76","text":"Analysing financial information to produce forecasts of business, industry, and economic conditions for use in making investment decisions","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2413-1","via":"2413","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.974,"anthropic_penetration":null,"ilo_2025":0.645,"basis":"direct"},"robotics":null},{"id":"13-2061.00#77","text":"Maintaining knowledge and staying abreast of developments in the fields of industrial technology, business, finance, and economic theory","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2413-2","via":"2413","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.82,"anthropic_penetration":null,"ilo_2025":0.46,"basis":"direct"},"robotics":null},{"id":"13-2061.00#78","text":"Interpreting data affecting investment programmes, such as price, yield, stability, future trends in investment risks and economic influences","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2413-3","via":"2413","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.959,"anthropic_penetration":null,"ilo_2025":0.62,"basis":"direct"},"robotics":null},{"id":"13-2061.00#79","text":"Monitoring economic, industrial, and corporate developments through analysis of information obtained from financial publications and services, investment banking firms, government agencies, trade publications, company sources and personal interviews","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2413-4","via":"2413","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.967,"anthropic_penetration":null,"ilo_2025":0.635,"basis":"direct"},"robotics":null},{"id":"13-2061.00#80","text":"Recommending investments and investment timing to companies, investment firm staff or the investing public","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2413-5","via":"2413","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.967,"anthropic_penetration":null,"ilo_2025":0.635,"basis":"direct"},"robotics":null},{"id":"13-2061.00#81","text":"Determining the prices at which securities should be syndicated and offered to the public","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2413-6","via":"2413","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.967,"anthropic_penetration":null,"ilo_2025":0.635,"basis":"direct"},"robotics":null},{"id":"13-2061.00#82","text":"Preparing plans of action for investment based on financial analyses","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2413-7","via":"2413","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.962,"anthropic_penetration":null,"ilo_2025":0.6225,"basis":"direct"},"robotics":null},{"id":"13-2061.00#83","text":"Evaluating and comparing the relative quality of various securities in a given industry","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2413-8","via":"2413","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.967,"anthropic_penetration":null,"ilo_2025":0.635,"basis":"direct"},"robotics":null},{"id":"13-2061.00#84","text":"Presenting oral and written reports on general economic trends, individual corporations, and entire industries.","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2413-9","via":"2413","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.991,"anthropic_penetration":null,"ilo_2025":0.675,"basis":"direct"},"robotics":null},{"id":"13-2061.00#85","text":"Examine and analyze journal and ledger entries, bank statements, inventories, expenditures, tax returns and other accounting and financial records, documents and systems of individuals, departments within organizations, businesses or other establishments to ensure financial recording accuracy and compliance with established accounting standards, procedures and internal controls","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11100.01","via":"11100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2061.00#86","text":"Prepare detailed reports on audit findings and make recommendations to improve individual or establishment's accounting and management practices","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11100.01","via":"11100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2061.00#87","text":"Conduct field audits of businesses to ensure compliance with provisions of the Income Tax Act, Canadian Business Corporations Act or other statutory requirements","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11100.01","via":"11100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2061.00#88","text":"May supervise other auditors or professionals in charge of accounting within client's establishment.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11100.01","via":"11100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2061.00#89","text":"Plan, set up and administer accounting systems and prepare financial information for individuals, departments within organizations, businesses and other establishments","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11100.02","via":"11100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2061.00#90","text":"Examine accounting records and prepare financial statements and reports","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11100.02","via":"11100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2061.00#91","text":"Develop and maintain cost finding, reporting and internal control procedures","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11100.02","via":"11100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2061.00#92","text":"Examine financial accounts and records and prepare income tax returns from accounting records","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11100.02","via":"11100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2061.00#93","text":"Analyze financial statements and reports and provide financial, business and tax advice","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11100.02","via":"11100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2061.00#94","text":"May act as a trustee in bankruptcy proceedings","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11100.02","via":"11100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2061.00#95","text":"May supervise and train articling students, other accountants or administrative technicians.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11100.02","via":"11100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2061.00#96","text":"Develop personal financial plans for clients covering cash management, finances, insurance coverage, investments, retirement and estate planning, taxes and legal matters","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11102.00","via":"11102","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2061.00#97","text":"Analyze clients' financial records, set goals and develop a financial strategy","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11102.00","via":"11102","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2061.00#98","text":"Advise clients on implementing the financial plan to help them achieve their goals","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11102.00","via":"11102","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2061.00#99","text":"May also arrange for the purchase and sale of financial products and investments depending on the licence held, and monitor the portfolio to ensure its quality and profitability","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11102.00","via":"11102","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2061.00#100","text":"May help to expand business and attract new clients.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11102.00","via":"11102","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2061.00#101","text":"Review and examine banks, trust companies, credit unions, caisses populaires, credit companies, real estate companies, insurance companies, pension funds, securities brokers and other financial services and institutions to ensure compliance with governing legislation and regulations.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11109.01","via":"11109","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2061.00#102","text":"Investigate possible unethical conduct or breaches of securities or commodity futures laws by persons or companies that trade in securities and commodity futures or that provide related financial services.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11109.02","via":"11109","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2061.00#103","text":"Analyze clients requests to assess risk and details of stocks, bonds, mortgages or other financing solutions","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11109.03","via":"11109","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2061.00#104","text":"Negotiate with corporations, governments or individuals to determine the type and terms of financial products and prepare offering prospectuses or contracts","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11109.03","via":"11109","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2061.00#105","text":"May underwrite new issues of stocks and bonds.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11109.03","via":"11109","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2061.00#106","text":"Administer estate, personal, charitable, corporate and other types of trusts","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11109.04","via":"11109","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2061.00#107","text":"Direct trust account investments, receive and record investment income and disburse trust funds.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11109.04","via":"11109","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2061.00#108","text":"Meet with clients to obtain information about income, liabilities and assets, and type, price and condition of property to be mortgaged","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11109.05","via":"11109","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2061.00#109","text":"Negotiate mortgage loans with lenders or lending institutions on behalf of clients.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11109.05","via":"11109","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null}]}