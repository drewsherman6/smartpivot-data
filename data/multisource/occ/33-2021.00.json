s agree"},"headline":{"value":0.022,"time_weighted_tasks":0.023,"other_measures_pct":0.38,"other_measures_linked":0.014,"weight_time_weighted":0.9,"weight_other_measures":0.1}}},"statements":[{"id":"33-2021.00#1","text":"Prepare and maintain reports of investigation results, and records of convicted arsonists and arson suspects.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"22991","via":"33-2021.00","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-2021.00#2","text":"Testify in court cases involving fires, suspected arson, and false alarms.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"22992","via":"33-2021.00","match":"native","w":0.067}],"n_sources":1,"weight":0.067,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-2021.00#3","text":"Package collected pieces of evidence in securely closed containers, such as bags, crates, or boxes, to protect them.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"22993","via":"33-2021.00","match":"native","w":0.067}],"n_sources":1,"weight":0.067,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"33-2021.00#4","text":"Conduct inspections and acceptance testing of newly installed fire protection systems.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"22994","via":"33-2021.00","match":"native","w":0.267}],"n_sources":1,"weight":0.267,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-2021.00#5","text":"Analyze evidence and other information to determine probable cause of fire or explosion.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"22995","via":"33-2021.00","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-2021.00#6","text":"Photograph damage and evidence related to causes of fires or explosions to document investigation findings.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"22996","via":"33-2021.00","match":"native","w":0.067}],"n_sources":1,"weight":0.067,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-2021.00#7","text":"Inspect buildings to locate hazardous conditions and fire code violations, such as accumulations of combustible material, electrical wiring problems, and inadequate or non-functional fire exits.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"22998","via":"33-2021.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-2021.00#8","text":"Examine fire sites and collect evidence such as glass, metal fragments, charred wood, and accelerant residue for use in determining the cause of a fire.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"22997","via":"33-2021.00","match":"native","w":0.267}],"n_sources":1,"weight":0.267,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-2021.00#9","text":"Instruct children about the dangers of fire.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"22999","via":"33-2021.00","match":"native","w":0.067}],"n_sources":1,"weight":0.067,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-2021.00#10","text":"Conduct fire code compliance follow-ups to ensure that corrective actions have been taken in cases where violations were found.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23000","via":"33-2021.00","match":"native","w":0.334}],"n_sources":1,"weight":0.334,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-2021.00#11","text":"Inspect properties that store, handle, and use hazardous materials to ensure compliance with laws, codes, and regulations, and issue hazardous materials permits to facilities found in compliance.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23001","via":"33-2021.00","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-2021.00#12","text":"Write detailed reports of fire inspections performed, fire code violations observed, and corrective recommendations offered.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23002","via":"33-2021.00","match":"native","w":0.6}],"n_sources":1,"weight":0.6,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-2021.00#13","text":"Identify corrective actions necessary to bring properties into compliance with applicable fire codes, laws, regulations, and standards, and explain these measures to property owners or their representatives.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23003","via":"33-2021.00","match":"native","w":0.267}],"n_sources":1,"weight":0.267,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-2021.00#14","text":"Develop or review fire exit plans.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23004","via":"33-2021.00","match":"native","w":0.067}],"n_sources":1,"weight":0.067,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-2021.00#15","text":"Inspect and test fire protection or fire detection systems to verify that such systems are installed in accordance with appropriate laws, codes, ordinances, regulations, and standards.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23005","via":"33-2021.00","match":"native","w":0.267}],"n_sources":1,"weight":0.267,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-2021.00#16","text":"Coordinate efforts with other organizations, such as law enforcement agencies.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23006","via":"33-2021.00","match":"native","w":0.133}],"n_sources":1,"weight":0.133,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-2021.00#17","text":"Attend training classes to maintain current knowledge of fire prevention, safety, and firefighting procedures.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23007","via":"33-2021.00","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-2021.00#18","text":"Review blueprints and plans for new or remodeled buildings to ensure the structures meet fire safety codes.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23008","via":"33-2021.00","match":"native","w":0.267}],"n_sources":1,"weight":0.267,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-2021.00#19","text":"Teach fire investigation techniques to other firefighter personnel.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23009","via":"33-2021.00","match":"native","w":0.067}],"n_sources":1,"weight":0.067,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-2021.00#20","text":"Conduct fire exit drills to monitor and evaluate evacuation procedures.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23010","via":"33-2021.00","match":"native","w":0.067}],"n_sources":1,"weight":0.067,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-2021.00#21","text":"Teach public education programs on fire safety and prevention.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23011","via":"33-2021.00","match":"native","w":0.133}],"n_sources":1,"weight":0.133,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-2021.00#22","text":"Recommend changes to fire prevention, inspection, and fire code endorsement procedures.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23012","via":"33-2021.00","match":"native","w":0.067}],"n_sources":1,"weight":0.067,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-2021.00#23","text":"Subpoena and interview witnesses, property owners, and building occupants to obtain information and sworn testimony.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23013","via":"33-2021.00","match":"native","w":0.133}],"n_sources":1,"weight":0.133,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-2021.00#24","text":"Conduct internal investigation to determine negligence and violation of laws and regulations by fire department employees.","kind":"task","esco_uri":null,"sources":[{"source":