_penetration":null,"ilo_2025":0.285,"basis":"direct"},"robotics":null},{"id":"33-2021.00#74","text":"Develop, implement and evaluate policies and procedures for the operation of a municipal fire department, a district fire region or an industrial firefighting service","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"40041.00","via":"40041","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-2021.00#75","text":"Plan, direct and co-ordinate firefighting strategies for fire departments","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"40041.00","via":"40041","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-2021.00#76","text":"Evaluate the type of fire, the extent of damage to buildings and the danger to nearby establishments","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"40041.00","via":"40041","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-2021.00#77","text":"Direct activities at the scene of a fire","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"40041.00","via":"40041","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-2021.00#78","text":"Determine damage estimates and investigate the potential causes of a fire after extinguished","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"40041.00","via":"40041","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-2021.00#79","text":"Develop and oversee the implementation of security and fire prevention campaigns","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"40041.00","via":"40041","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-2021.00#80","text":"Represent the fire department in communications with government, the media and the public","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"40041.00","via":"40041","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-2021.00#81","text":"Direct the training of personnel in firefighting methods","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"40041.00","via":"40041","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-2021.00#82","text":"Co-ordinate and monitor budget and departmental resources.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"40041.00","via":"40041","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-2021.00#83","text":"Respond to fire alarms and other calls for assistance, such as automobile and industrial accidents, bomb threats and other emergencies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42101.00","via":"42101","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-2021.00#84","text":"Rescue victims from burning buildings and accident sites","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42101.00","via":"42101","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-2021.00#85","text":"Control and extinguish fires using manual and power equipment, such as axes, water hoses, aerial ladders and hydraulic equipment and various firefighting chemicals","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42101.00","via":"42101","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-2021.00#86","text":"Administer first aid and other assistance","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42101.00","via":"42101","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-2021.00#87","text":"Ensure proper operation and maintenance of firefighting equipment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42101.00","via":"42101","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-2021.00#88","text":"Prepare written reports on fire incidents","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42101.00","via":"42101","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-2021.00#89","text":"Inform and educate the public on fire prevention","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42101.00","via":"42101","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-2021.00#90","text":"Train to maintain high level of physical fitness","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42101.00","via":"42101","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-2021.00#91","text":"Assist the public, the police and emergency organizations during times of major disasters","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42101.00","via":"42101","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-2021.00#92","text":"May participate as members of a trauma or emergency response team and provide paramedical aid to accident victims or ill persons","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42101.00","via":"42101","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-2021.00#93","text":"May supervise and coordinate the work of other firefighters","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42101.00","via":"42101","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-2021.00#94","text":"May conduct building inspections to ensure compliance with fire code.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42101.00","via":"42101","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null}]}