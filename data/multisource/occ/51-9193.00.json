"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-9193.00#5","text":"Correct machinery malfunctions by performing actions such as removing jams, and inform supervisors of malfunctions as necessary.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8546","via":"51-9193.00","match":"native","w":0.312}],"n_sources":1,"weight":0.312,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-9193.00#6","text":"Assemble equipment, and attach pipes, fittings, or valves, using hand tools.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8548","via":"51-9193.00","match":"native","w":0.187}],"n_sources":1,"weight":0.187,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-9193.00#7","text":"Measure or weigh specified amounts of ingredients or materials, and load them into tanks, vats, hoppers, or other equipment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8553","via":"51-9193.00","match":"native","w":0.375}],"n_sources":1,"weight":0.375,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-9193.00#8","text":"Adjust machine or freezer speed and air intake to obtain desired consistency and amount of product.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8542","via":"51-9193.00","match":"native","w":0.312}],"n_sources":1,"weight":0.312,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-9193.00#9","text":"Weigh packages and adjust freezer air valves or switches on filler heads to obtain specified amounts of product in each container.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8550","via":"51-9193.00","match":"native","w":0.187}],"n_sources":1,"weight":0.187,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-9193.00#10","text":"Inspect and flush lines with solutions or steam, and spray equipment with sterilizing solutions.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8557","via":"51-9193.00","match":"native","w":0.375}],"n_sources":1,"weight":0.375,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"51-9193.00#11","text":"Load and position wrapping paper, sticks, bags, or cartons into dispensing machines.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8554","via":"51-9193.00","match":"native","w":0.187}],"n_sources":1,"weight":0.187,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-9193.00#12","text":"Sample and test product characteristics such as specific gravity, acidity, and sugar content, using hydrometers, pH meters, or refractometers.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8559","via":"51-9193.00","match":"native","w":0.187}],"n_sources":1,"weight":0.187,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-9193.00#13","text":"Start agitators to blend contents, or start beater, scraper, and expeller blades to mix contents with air and prevent sticking.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8552","via":"51-9193.00","match":"native","w":0.125}],"n_sources":1,"weight":0.125,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"51-9193.00#14","text":"Insert forming fixtures, and start machines that cut frozen products into measured portions or specified shapes.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8555","via":"51-9193.00","match":"native","w":0.125}],"n_sources":1,"weight":0.125,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-9193.00#15","text":"Place or position containers into equipment, and remove containers after completion of cooling or freezing processes.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8556","via":"51-9193.00","match":"native","w":0.312}],"n_sources":1,"weight":0.312,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-9193.00#16","text":"Scrape, dislodge, or break excess frost, ice, or frozen product from equipment to prevent accumulation, using hands and hand tools.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8549","via":"51-9193.00","match":"native","w":0.187}],"n_sources":1,"weight":0.187,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-9193.00#17","text":"Activate mechanical rakes to regulate flow of ice from storage bins to vats.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8560","via":"51-9193.00","match":"native","w":0.062}],"n_sources":1,"weight":0.062,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"51-9193.00#18","text":"Stir material with spoons or paddles to mix ingredients or allow even cooling and prevent coagulation.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8551","via":"51-9193.00","match":"native","w":0.062}],"n_sources":1,"weight":0.06