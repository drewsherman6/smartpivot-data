etworks, using direct leveling or other geodetic survey techniques, such as triangulation, trilateration, and traversing, to establish features of the Earth's surface.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16297","via":"17-1022.01","match":"native","w":0.667}],"n_sources":1,"weight":0.667,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-1022.01#7","text":"Plan or direct the work of geodetic surveying staff, providing technical consultation as needed.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16289","via":"17-1022.01","match":"native","w":0.583}],"n_sources":1,"weight":0.583,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-1022.01#8","text":"Assess the quality of control data to determine the need for additional survey data for engineering, construction, or other projects.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16300","via":"17-1022.01","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-1022.01#9","text":"Distribute compiled geodetic data to government agencies or the general public.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16290","via":"17-1022.01","match":"native","w":0.167}],"n_sources":1,"weight":0.167,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"17-1022.01#10","text":"Request additional survey data when field collection errors occur or engineering surveying specifications are not maintained.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16293","via":"17-1022.01","match":"native","w":0.083}],"n_sources":1,"weight":0.083,"ai":{"pct":0,"anthr