ic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"47-2152.04#6","text":"Demonstrate start-up, shut-down, maintenance, diagnostic, and safety procedures to thermal system owners.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17786","via":"47-2152.04","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"47-2152.04#7","text":"Install circulating pumps using pipe, fittings, soldering equipment, electrical supplies, and hand tools.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17774","via":"47-2152.04","match":"native","w":0.3}],"n_sources":1,"weight":0.3,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2152.04#8","text":"Install flat-plat, evacuated glass, or concentrating solar collectors on mounting devices, using brackets or struts.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17776","via":"47-2152.04","match":"native","w":0.5}],"n_sources":1,"weight":0.5,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2152.04#9","text":"Install solar thermal system controllers and sensors.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17781","via":"47-2152.04","match":"native","w":0.3}],"n_sources":1,"weight":0.3,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2152.04#10","text":"Fill water tanks and check tanks, pipes, and fittings for leaks.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17772","via":"47-2152.04","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2152.04#11","text":"Design active direct or indirect, passive direct or indirect, or pool solar systems.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17766","via":"47-2152.04","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"47-2152.04#12","text":"Determine locations for installing solar subsystem components, including piping, water heaters, valves, and ancillary equipment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17771","via":"47-2152.04","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"47-2152.04#13","text":"Perform routine maintenance or repairs to restore solar thermal systems to baseline operating conditions.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17767","via":"47-2152.04","match":"native","w":0.7}],"n_sources":1,"weight":0.7,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"47-2152.04#14","text":"Install heat exchangers and heat exchanger fluids according to installation manuals and schematics.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17777","via":"47-2152.04","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2152.04#15","text":"Apply operation or identification tags or labels to system components, as required.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17768","via":"47-2152.04","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2152.04#16","text":"Connect water heaters and storage tanks to power and water sources.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17770","via":"47-2152.04","match":"native","w":0.4}],"n_sources":1,"weight":0.4,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"47-2152.04#17","text":"Cut, miter, and glue piping insulation to insulate plumbing pipes and fittings.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17785","via":"47-2152.04","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"47-2152.04#18","text":"Install plumbing, such as dip tubes, port fittings, drain tank valves, pressure temperature relief valves, or tanks, according to manufacturer specifications and building codes.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17779","via":"47-2152.04","match":"native","w":0.4}],"n_sources":1,"weight":0.4,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2152.04#19","text":"Install monitoring system components, such as flow meters, temperature gauges, and pressure gauges, according to system design and manufacturer specifications.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17778","via":"47-2152.04","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2152.04#20","text":"Assess collector sites to ensure structural integrity