s":null},{"id":"29-1229.02#30","text":"Recording patients' medical information and history and exchanging information with specialist practitioners and other health workers as required for continuing medical care","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2211-8","via":"2211","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.657,"anthropic_penetration":null,"ilo_2025":0.355,"basis":"direct"},"robotics":null},{"id":"29-1229.02#31","text":"Reporting births, deaths and notifiable diseases to government authorities to meet legal and professional requirements","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2211-9","via":"2211","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.706,"anthropic_penetration":null,"ilo_2025":0.3725,"basis":"direct"},"robotics":null},{"id":"29-1229.02#32","text":"Conducting research in human health and medical services and disseminating the findings such as through scientific reports","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2211-10","via":"2211","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.842,"anthropic_penetration":null,"ilo_2025":0.4775,"basis":"direct"},"robotics":null},{"id":"29-1229.02#33","text":"Planning and participating in programmes designed to prevent the occurrence and spread of common diseases.","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2211-11","via":"2211","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.57,"anthropic_penetration":null,"ilo_2025":0.3125,"basis":"direct"},"robotics":null},{"id":"29-1229.02#34","text":"Administer anesthetics prior to, during, or after surgery or other medical procedures.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.01","via":"31100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#35","text":"Diagnose and provide non-surgical treatment of diseases and injuries of internal organ systems. Provide care mainly for adults who have a wide range of problems associated with the internal organs.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.02","via":"31100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#36","text":"Diagnose, treat, and help prevent children's diseases and injuries.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.03","via":"31100","match":"statcan_concordance","w":0.333},{"source":"oasis","ref":"31101.03","via":"31101","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#37","text":"Diagnose, treat, and help prevent disorders of the mind.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.04","via":"31100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#38","text":"Diagnose, treat, and help prevent allergic diseases and disease processes affecting the immune system.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.05","via":"31100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#39","text":"Provide inpatient care predominantly in settings such as medical wards,  intensive care units, rehabilitation centers, or emergency rooms. Manage and coordinate patient care throughout treatment.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.06","via":"31100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#40","text":"Diagnose, treat, and help prevent diseases and disorders of the nervous system involving the brain and spinal cord and other nerve and muscular conditions.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.07","via":"31100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#41","text":"Diagnose and treat diseases using radioactive materials. May monitor radionuclide preparation, administration, and disposition.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.08","via":"31100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#42","text":"Diagnose, treat, and help prevent diseases or other conditions of the skin.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.09","via":"31100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#43","text":"Diagnose and treat disorders requiring physiotherapy to provide physical, mental, and occupational rehabilitation.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.10","via":"31100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#44","text":"Apply knowledge of general preventive medicine and public health issues to promote health care to groups or individuals, and aid in the prevention or reduction of risk of disease, injury, disability, or death. May diagnose and treat patients in the context of clinical health promotion and disease prevention.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.11","via":"31100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#45","text":"Examine and diagnose disorders and diseases using x-rays and radioactive materials. May treat patients.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.12","via":"31100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#46","text":"Diagnose and treat diseases and physiological or psychiatric disorders. Order laboratory tests, X-rays and other diagnostic procedures. Prescribe medication and treatment and refer patients for surgery. Act as consultants to other physicians. May conduct medical research.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.13","via":"31100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#47","text":"Diagnose presence and stage of diseases using laboratory techniques and patient specimens. Study the nature, cause and development of diseases in humans and the structural and functional changes caused by diseases. Act as consultants to other physicians. May perform autopsies.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.14","via":"31100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#48","text":"Treat diseases, injuries, and deformities by invasive, minimally-invasive, or non-invasive surgical methods, such as using instruments, appliances, or by manual manipulation.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31101.01","via":"31101","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#49","text":"Provide medical care related to pregnancy or childbirth.  Diagnose, treat, and help prevent diseases of women, particularly those affecting the reproductive system. May also provide general medical care to women. May perform both medical and gynecological surgery functions.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31101.02","via":"31101","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#50","text":"Diagnose, treat, and help prevent benign and malignant medical and surgical disorders of the genitourinary system and the renal glands.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31101.04","via":"31101","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#51","text":"Assess patients' diseases or disorders to determine appropriate surgical procedures","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31101.05","via":"31101","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#52","text":"Perform and supervise surgical procedures to correct physical abnormalities and deficiencies and repair injuries","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31101.05","via":"31101","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#53","text":"Act as consultants to other physicians.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31101.05","via":"31101","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#54","text":"Interviews persons in connection with criminal incidents, including victims, witnesses and suspects","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#55","text":"Exchange information and coordinate activities with other law enforcements agencies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#56","text":"Prepare investigation reports and testify in courts concerning criminal investigations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#57","text":"Search and collect physical evidence from crimes scenes, such as fingerprints, and attend autopsies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#58","text":"Perform surveillance by using investigative technologies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#59","text":"Obtain search warrants, conduct searches and arrest suspects","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#60","text":"May conduct investigation on online networks and computer systems to detect cyber crimes or to recover data.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#61","text":"May supervise and coordinate the work of police officers.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#62","text":"Conduct death investigations to determine the identity of the deceased, date and location of death, medical cause of death, and manner of death","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#63","text":"Order or perform autopsies and other medical tests","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#64","text":"Consult with and request assistance from law enforcement, physicians, and family","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#65","text":"Issue death certificates, including assigning cause and manner of death","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#66","text":"Identify and educate the public on dangerous practices or conditions that may lead to death","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#67","text":"May testify or produce evidence in proceedings about observations made during investigations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1229.02#68","text":"May supervisor and coordinator work of other employees.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null}]}