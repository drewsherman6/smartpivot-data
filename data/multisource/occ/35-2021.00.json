an kitchen garbage containers.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2208","via":"35-2021.00","match":"native","w":0.166},{"source":"oasis","ref":"65201.02","via":"65201","match":"statcan_concordance","w":1}],"n_sources":2,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"35-2021.00#6","text":"Store food in designated containers and storage areas to prevent spoilage.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2197","via":"35-2021.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"35-2021.00#7","text":"Weigh or measure ingredients.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2203","via":"35-2021.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"35-2021.00#8","text":"Vacuum dining area and sweep and mop kitchen floor.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"18734","via":"35-2021.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"35-2021.00#9","text":"Inform supervisors when equipment is not working properly and when food and supplies are getting low, and order needed items.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"18732","via":"35-2021.00","match":"native","w":0.166}],"n_sources":1,"weight":0.166,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"35-2021.00#10","text":"Wash, peel, and cut various foods, such as fruits and vegetables, to prepare for cooking or serving.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"18731","via":"35-2021.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"35-2021.00#11","text":"Prepare a variety of foods, such as meats, vegetables, or desserts, according to customers' orders or supervisors' instructions, following approved procedures.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"18729","via":"35-2021.00","match":"native","w":0.833}],"n_sources":1,"weight":0.833,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"35-2021.00#12","text":"Assemble meal trays with foods in accordance with patients' diets.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21005","via":"35-2021.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"35-2021.00#13","text":"Stock cupboards and refrigerators, and tend salad bars and buffet meals.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2207","via":"35-2021.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"35-2021.00#14","text":"Use manual or electric appliances to clean, peel, slice, and trim foods.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2213","via":"35-2021.00","match":"native","w":0.333},{"source":"oasis","ref":"65201.01","via":"65201","match":"statcan_concordance","w":1}],"n_sources":2,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"35-2021.00#15","text":"Load dishes, glasses, and tableware into dishwashing machines.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2217","via":"35-2021.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"35-2021.00#16","text":"Portion and wrap food, or place it directly on plates for service to patrons.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2200","via":"35-2021.00","match":"native","w":0.5},{"source":"oasis","ref":"65201.01","via":"65201","match":"statcan_concordance","w":1}],"n_sources":2,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"35-2021.00#17","text":"Add cutlery, napkins, food, and other items to trays on assembly lines in hospitals, cafeterias, airline kitchens, and similar establishments.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2220","via":"35-2021.00","match":"native","w":0.166}],"n_sources":1,"weight":0.166,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"35-2021.00#18","text":"Place food trays over food warmers for immediate service, or store them in refrigerated storage cabinets.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2201","via":"35-2021.00","match":"native","w":0.166}],"n_sources":1,"weight":0.166,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"35-2021.00#19","text":"Prepare and serve a variety of beverages, such as coffee, tea, and soft drinks.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2209","via":"35-2021.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"35-2021.00#20","text":"Mix ingredients for green salads, molded fruit salads, vegetable salads, and pasta salads.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2221","via":"35-2021.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"35-2021.00#21","text":"Receive and store food supplies, equipment, and utensils in refrigerators, cupboards, and other storage areas.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2206","via":"35-2021.00","match":"native","w":0.166}],"n_sources":1,"weight":0.166,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"35-2021.00#22","text":"Stir and strain soups and sauces.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2214","via":"35-2021.00","match":"native","w":0.166}],"n_sources":1,"weight":0.166,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"35-2021.00#23","text":"Make special dressings and sauces as condiments for sandwiches.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2211","via":"35-2021.00","match":"native","w":0.166}],"n_sources":1,"weight":0.166,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"35-2021.00#24","text":"Scrape leftovers from dishes into garbage containers.","kind":"task","esco_uri":null,