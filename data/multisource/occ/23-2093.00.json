egal correspondence and perform general office and clerical duties.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42200.01","via":"42200","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"23-2093.00#75","text":"Represent clients in small claims court and in other lower court proceedings, at tribunals and before administrative bodies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42200.02","via":"42200","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"23-2093.00#76","text":"Advise clients and take legal action on landlord and tenant matters, traffic violations, name changes and other issues within their jurisdictions.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42200.02","via":"42200","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"23-2093.00#77","text":"Administer oaths and take affidavits and depositions","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42200.03","via":"42200","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"23-2093.00#78","text":"Witness and certify the validity of signatures on documents","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42200.03","via":"42200","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"23-2093.00#79","text":"May draft contracts, prepare promissory notes and draw up wills, mortgages and other legal documents","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42200.03","via":"42200","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"23-2093.00#80","text":"May arrange probates and administer the estates of deceased persons.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42200.03","via":"42200","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"23-2093.00#81","text":"Advise clients on intellectual property matters and represent clients before the Registrar of Trade-Marks on matters including prosecution of applications for registration of trademarks","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42200.04","via":"42200","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"23-2093.00#82","text":"Advise on the registrability of trademarks, trademark licensing requirements, transfer of intellectual property and protection of existing trademark rights","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42200.04","via":"42200","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"23-2093.00#83","text":"Represent clients at proceedings before the Trade Marks Opposition Board and in related proceedings","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42200.04","via":"42200","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"23-2093.00#84","text":"May represent clients internationally in consultation with foreign associates and attorneys.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42200.04","via":"42200","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"23-2093.00#85","text":"Issue subpoenas, summonses and warrants, including search warrants","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42200.05","via":"42200","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"23-2093.00#86","text":"Receive affidavits, declarations and affirmations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42200.05","via":"42200","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"23-2093.00#87","text":"Administer oaths","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42200.05","via":"42200","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"23-2093.00#88","text":"Conduct bail hearings","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42200.05","via":"42200","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"23-2093.00#89","text":"Release defendants on judges' orders and explain rights and obligations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42200.05","via":"42200","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"23-2093.00#90","text":"Hear evidence at trials on summary conviction offences and may preside over trials of criminal offences at the discretion of the chief judge of the jurisdiction or as provided for in federal, provincial or territorial statutes","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42200.05","via":"42200","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"23-2093.00#91","text":"Perform civil marriages","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42200.05","via":"42200","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"23-2093.00#92","text":"Register wills, probate, bankruptcy, etc.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42200.05","via":"42200","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null}]}