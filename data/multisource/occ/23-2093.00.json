":"E0","score":0,"basis":"direct"}},{"id":"23-2093.00#14","text":"Summarize pertinent legal or insurance details, or sections of statutes or case law from reference books for use in examinations or as proofs or ready reference.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9242","via":"23-2093.00","match":"native","w":0.133}],"n_sources":1,"weight":0.133,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"23-2093.00#15","text":"Prepare real estate closing statements, using knowledge and expertise in real estate procedures.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9244","via":"23-2093.00","match":"native","w":0.005}],"n_sources":1,"weight":0.005,"ai":{"pct":0.932,"anthropic_penetration":0.81,"ilo_2025":null,"basis":"direct"},"robotics":null},{"id":"23-2093.00#16","text":"Determine whether land-related documents can be registered under the relevant legislation, such as the Land Titles Act.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9245","via":"23-2093.00","match":"native","w":0.067}],"n_sources":1,"weight":0.067,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"23-2093.00#17","text":"Assess fees related to registration of property-related documents.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9246","via":"23-2093.00","match":"native","w":0.067}],"n_sources":1,"weight":0.067,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"23-2093.00#18","text":"analyse insurance risk","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/e4a57b51-16d7-4dfc-bb47-6aa401e39b2e","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/e4a57b51-16d7-4dfc-bb47-6aa401e39b2e","via":"http://data.europa.eu/esco/occupation/b42d8731-386b-4d34-a