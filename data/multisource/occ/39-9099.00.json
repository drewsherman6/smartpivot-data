27,"weight_time_weighted":0.9,"weight_other_measures":0.1}}},"statements":[{"id":"39-9099.00#1","text":"Instruct children in safe behavior, such as seeking adult assistance when crossing the street and avoiding contact with unsafe objects.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2355","via":"39-9099.00","match":"native","w":0.143}],"n_sources":1,"weight":0.143,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-9099.00#2","text":"Remove hazards and develop appropriate boundaries and rules to create a safe environment for children.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2368","via":"39-9099.00","match":"native","w":0.143}],"n_sources":1,"weight":0.143,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-9099.00#3","text":"Perform first aid or cardiopulmonary resuscitation (CPR) when required.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2351","via":"39-9099.00","match":"native","w":0.072}],"n_sources":1,"weight":0.072,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-9099.00#4","text":"Instruct and assist children in the development of health and personal habits, such as eating, resting, and toilet behavior.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2365","via":"39-9099.00","match":"native","w":0.571}],"n_sources":1,"weight":0.571,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-9099.00#5","text":"Regulate children's rest periods and nap schedules.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2352","via":"39-9099.00","match":"native","w":0.214}],"n_sources":1,"weight":0.214,"ai":{"pct":0,"anthropic_penetration":0