match":"native","w":0.3}],"n_sources":1,"weight":0.3,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-5094.00#6","text":"Treat the facial skin to maintain and improve its appearance, using specialized techniques and products, such as peels and masks.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8075","via":"39-5094.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-5094.00#7","text":"Examine clients' skin, using magnifying lamps or visors when necessary, to evaluate skin condition and appearance.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8072","via":"39-5094.00","match":"native","w":0.4}],"n_sources":1,"weight":0.4,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"39-5094.00#8","text":"Perform simple extractions to remove blackheads.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8078","via":"39-5094.00","match":"native","w":0.3}],"n_sources":1,"weight":0.3,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-5094.00#9","text":"Select and apply cosmetic products, such as creams, lotions, and tonics.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8073","via":"39-5094.00","match":"native","w":0.6}],"n_sources":1,"weight":0.6,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-5094.00#10","text":"Stay abreast of latest industry trends, products, research, and treatments.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"20258","via":"39-5094.00","match":"native","w":0.3}],"n_sources":1,"weight":0.3,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-5094.00#11","text":"Apply chemical peels to reduce fine lines and age spots.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8081","via":"39-5094.00","match":"native","w":0.3}],"n_sources":1,"weight":0.3,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-5094.00#12","text":"Refer clients to medical personnel for treatment of serious skin problems.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8076","via":"39-5094.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-5094.00#13","text":"Provide facial and body massages.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8079","via":"39-5094.00","match":"native","w":0.5}],"n_sources":1,"weight":0.5,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-5094.00#14","text":"Remove body and facial hair by applying wax.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8080","via":"39-5094.00","match":"native","w":0.7}],"n_sources":1,"weight":0.7,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-5094.00#15","text":"Tint eyelashes and eyebrows.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8086","via":"39-5094.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-5094.00#16","text":"Collaborate with plastic surgeons and dermatologists to provide patients with