,"ai":null,"robotics":null},{"id":"55-2011.00#12","text":"Control crowds at public events and protests and monitor suspicious and violent behaviour","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-2011.00#13","text":"Participate in crime prevention, public information, safety and community relations programs","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-2011.00#14","text":"Perform daily administrative tasks in support of law enforcement activities, such as maintaining equipment and information files","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-2011.00#15","text":"May assist police investigators in criminal investigations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-2011.00#16","text":"Certify ammunition, explosive items, munitions and non-munitions scrap to different degrees of classification","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42102.00","via":"42102","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-2011.00#17","text":"Inspect, test, identify faults, adjust, repair, recondition and modify electrical, electromechanical, electronic, electro-optic and mechanical equipment, optical instruments, and control systems for weapons and missiles","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42102.00","via":"42102","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0