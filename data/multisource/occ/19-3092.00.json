ht":0.5,"ai":null,"robotics":null},{"id":"19-3092.00#46","text":"write research proposals","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/0ee7b0d6-db98-4785-9948-f2ef415d155a","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/0ee7b0d6-db98-4785-9948-f2ef415d155a","via":"http://data.europa.eu/esco/occupation/bac64fa2-dcd6-47bb-8e5c-04e04a86a199","match":"exactMatch","essential":false,"w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3092.00#47","text":"environmental legislation","kind":"knowledge","esco_uri":"http://data.europa.eu/esco/skill/6f5850ea-5785-4e2c-b062-743066fd5bdb","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/6f5850ea-5785-4e2c-b062-743066fd5bdb","via":"http://data.europa.eu/esco/occupation/bac64fa2-dcd6-47bb-8e5c-04e04a86a199","match":"exactMatch","essential":false,"w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3092.00#48","text":"interview focus groups","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/670c79e9-aa33-41ae-9858-573ade0adb89","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/670c79e9-aa33-41ae-9858-573ade0adb89","via":"http://data.europa.eu/esco/occupation/bac64fa2-dcd6-47bb-8e5c-04e04a86a199","match":"exactMatch","essential":false,"w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3092.00#49","text":"Conducting research on the origin, development, structure, social patterns, organizations and interrelationships of human society","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2632-1","via":"2632","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.912,"anthropic_penetration":null,"ilo_2025":0.555,"basis":"direct"},"robotics":null},{"id":"19-3092.00#50","text":"Tracing the origin and evolution of humanity through the study of changing characteristics and cultural and social institutions","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2632-2","via":"2632","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.806,"anthropic_penetration":null,"ilo_2025":0.445,"basis":"direct"},"robotics":null},{"id":"19-3092.00#51","text":"Tracing the development of humanity through the material remains of its past, such as dwellings, temples, tools, pottery, coins, weapons or sculpture","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2632-3","via":"2632","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.352,"anthropic_penetration":null,"ilo_2025":0.2125,"basis":"direct"},"robotics":null},{"id":"19-3092.00#52","text":"Studying physical and climatic aspects of areas and regions, and correlating these findings with economic, social and cultural activities","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2632-4","via":"2632","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.903,"anthropic_penetration":null,"ilo_2025":0.545,"basis":"direct"},"robotics":null},{"id":"19-3092.00#53","text":"Developing theories, models and methods to interpret and describe social phenomena","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2632-5","via":"2632","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.82,"anthropic_penetration":null,"ilo_2025":0.46,"basis":"direct"},"robotics":null},{"id":"19-3092.00#54","text":"Evaluating the outcome of political decisions concerning social policy","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2632-6","via":"2632","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.706,"anthropic_penetration":null,"ilo_2025":0.3725,"basis":"direct"},"robotics":null},{"id":"19-3092.00#55","text":"Analysing and evaluating social data","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2632-7","via":"2632","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.955,"anthropic_penetration":null,"ilo_2025":0.615,"basis":"direct"},"robotics":null},{"id":"19-3092.00#56","text":"Advising on the practical application of findings in the formulation of economic and social policies for population groups and regions, and for the development of markets","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2632-8","via":"2632","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.919,"anthropic_penetration":null,"ilo_2025":0.56,"basis":"direct"},"robotics":null},{"id":"19-3092.00#57","text":"Preparing scholarly papers and reports.","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2632-9","via":"2632","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.889,"anthropic_penetration":null,"ilo_2025":0.535,"basis":"direct"},"robotics":null},{"id":"19-3092.00#58","text":"Conduct studies of the origin, development and functioning of human societies and cultures and of human evolution, changing physical characteristics and geographical distribution.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41409.01","via":"41409","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"19-3092.00#59","text":"Study artifacts (objects and structures) to reconstruct past economic, social, political and intellectual life.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41409.02","via":"41409","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"19-3092.00#60","text":"Study and analyse the spatial distribution and interrelationship of physical, biological, cultural and social patterns.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41409.03","via":"41409","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"19-3092.00#61","text":"Conduct research into one or more phases or aspects of past human activity and interpret and document findings.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41409.04","via":"41409","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"19-3092.00#62","text":"Study the origin, structure and development of languages and apply linguistic theory to problems in teaching, translation and communications.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41409.05","via":"41409","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"19-3092.00#63","text":"Conduct research into the theory, origin, development, interrelationships and functioning of political institutions, political movements and individual political behaviour.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41409.06","via":"41409","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"19-3092.00#64","text":"Develop psychological tests, scales and measures, and may administer or apply and interpret such tests, scales and measures. Psychometrists administer and score psychological tests, usually under the supervision of a registered psychologist.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41409.07","via":"41409","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"19-3092.00#65","text":"Study the development, structure, social patterns and interrelationships of human society.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41409.08","via":"41409","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.912,"anthropic_penetration":null,"ilo_2025":0.555,"basis":"transferred","from":"Conducting research on the origin, development, structure, social patterns, organizations and interrelationships of huma","similarity":0.583},"robotics":null},{"id":"19-3092.00#66","text":"Specialize in particular areas of social sciences and humanities disciplines. These include gerontologists (specialists in the phenomena and problems of aging), graphoanalysts (specialists in handwriting analysis) and others.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41409.09","via":"41409","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null}]}