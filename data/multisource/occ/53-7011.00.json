,"text":"Stop equipment or machinery and clear jams, using poles, bars, and hand tools, or remove damaged materials from conveyors.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10755","via":"53-7011.00","match":"native","w":0.5}],"n_sources":1,"weight":0.5,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"53-7011.00#2","text":"Load, unload, or adjust materials or products on conveyors by hand, by using lifts, hoists, and scoops, or by opening gates, chutes, or hoppers.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10757","via":"53-7011.00","match":"native","w":0.929}],"n_sources":1,"weight":0.929,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"53-7011.00#3","text":"Observe conveyor operations and monitor lights, dials, and gauges to maintain specified operating levels and to detect equipment malfunctions.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10750","via":"53-7011.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"53-7011.00#4","text":"Observe packages moving along conveyors to identify packages, detect defective packaging, and perform quality control.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21030","via":"53-7011.00","match":"native","w":0.357}],"n_sources":1,"weight":0.357,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"53-7011.00#5","text":"Position deflector bars, gates, chutes, or spouts to divert flow of materials from one conveyor onto another conveyor.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10744","via":"53-7011.00","match":"native","w":0.214}],"n_sources":1,"weight":0.214,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"53-7011.00#6","text":"Clean, sterilize, and maintain equipment, machinery, and work stations, using hand tools, shovels, brooms, chemicals, hoses, and lubricants.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10749","via":"53-7011.00","match":"native","w":0.429}],"n_sources":1,"weight":0.429,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"53-7011.00#7","text":"Record production data such as weights, types, quantities, and storage locations of materials, as well as equipment performance problems and downtime.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10747","via":"53-7011.00","match":"native","w":0.286}],"n_sources":1,"weight":0.286,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"53-7011.00#8","text":"Inform supervisors of equipment malfunctions that need to be addressed.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10748","via":"53-7011.00","match":"native","w":0.071}],"n_sources":1,"weight":0.071,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"53-7011.00#9","text":"Manipulate controls, levers, and valves to start pumps, auxiliary equipment, or conveyors, and to adjust equipment positions, speeds, timing, and material flows.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10746","via":"53-7011.00","match":"native","w":0.357}],"n_sources":1,"weight":0.357,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"53-7011.00#10","text":"Distribute materials, supplies, and equipment to work stations, using lifts and trucks.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10760","via":"53-7011.00","match":"native","w":0.357}],"n_sources":1,"weight":0.357,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"53-7011.00#11","text":"Press console buttons to deflect packages to predetermined accumulators or reject lines.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10764","via":"53-7011.00","match":"native","w":0.143}],"n_sources":1,"weight":0.143,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"53-7011.00#12","text":"Thread strapping through strapping tools and secure battens with strapping to form protective pallets around extrusions.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10766","via":"53-7011.00","match":"native","w":0.071}],"n_sources":1,"weight":0.071,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"53-7011.00#13","text":"Operate elevator systems in conjunction with conveyor systems.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10751","via":"53-7011.00","match":"native","w":0.006}],"n_sources":1,"weight":0.006,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":null},{"id":"53-7011.00#14","text":"Weigh or measure materials and products, using scales or other measuring instruments, or read scales on conveyors that continually weigh products, to verify specified tonnages and prevent overloads.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10745","via":"53-7011.00","match":"native","w":0.214}],"n_sources":1,"weight":0.214,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"53-7011.00#15","text":"Read production and delivery schedules, and confer with supervisors, to determine sorting and transfer procedures, arrangement of packages on pallets, and destinations of loaded pallets.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10752","via":"53-7011.00","match":"native","w":0.214}],"n_sources":1,"weight":0.214,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"53-7011.00#16","text":"Operate consoles to control automatic palletizing equipment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10758","via":"53-7011.00","match":"native","w":0.006}],"n_sources":1,"weight":0.006,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":null},{"id":"53-7011.00#17","text":"Contact workers in work stations or other departments to request movement of materials, products, or machinery, or to notify them of incoming shipments and their estimated delivery times.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10754","via":"53-7011.00","match":"native","w":0.143}],"n_sources":1,"weight":0.143,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"53-7011.00#18","text":"Affix identifying information to materials or products, using hand tools.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10759","via":"53-7011.00","match":"native","w":0.071}],"n_sources":1,"weight":0.071,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"53-7011.00#19","text":"Collect samples of materials or products, checking them to ensure conformance to specifications or sending them to laboratories for analysis.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10756","via":"53-7011.00","match":"native","w":0.071}],"n_sources":1,"weight":0.071,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"53-7011.00#20","text":"Move, assemble, and connect hoses or nozzles to material hoppers, storage tanks, conveyor sections or chutes, and pumps.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10761","via":"53-7011.00","match":"native","w":0.071}],"n_sources":1,"weight":0.071,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"53-7011.00#21","text":"Repair or replace equipment components or parts such as blades, rolls, and pumps.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10753","via":"53-7011.00","match":"native","w":0.214}],"n_sources":1,"weight":0.214,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"53-7011.00#22","text":"Measure dimensions of bundles, using rulers, and cut battens to required sizes, using power saws.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10763","via":"53-7011.00","match":"native","w":0.006}],"n_sources":1,"weight":0.006,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":null},{"id":"53-7011.00#23","text":"Join sections of conveyor frames at temporary working areas, and connect power units.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10765","via":"53-7011.00","match":"native","w":0.071}],"n_sources":1,"weight":0.071,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"53-7011.00#24","text":"Load, unload and move products and materials by hand or using basic material handling equipment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"75101.01","via":"75101","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"53-7011.00#25","text":"Perform other material handling activities such as counting, weighing, sorting, packing and unpacking.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"75101.01","via":"75101","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"53-7011.00#26","text":"May perform other activities, such as opening containers and crates, filling warehouse orders, assisting in taking inventory and weighing and checking materials.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"75101.01","via":"75101","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"53-7011.00#27","text":"Move household appliances and furniture onto and off moving trucks or vans","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"75101.02","via":"75101","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"53-7011.00#28","text":"Operate winches and other loading devices to load and unload materials onto and off trucks, railway cars and loading docks of warehouses and industrial establishments","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"75101.02","via":"75101","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"53-7011.00#29","text":"Operate industrial trucks, tractors, loaders and other equipment to transport materials to and from transportation vehicles and loading docks and to store and retrieve materials in warehouses","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"75101.02","via":"75101","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"53-7011.00#30","text":"Connect hoses or pipes and operate equipment to load and unload liquid petroleum, chemical or other products into or from tank cars, tank trucks or storage tanks","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"75101.02","via":"75101","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"53-7011.00#31","text":"Operate equipment to dump materials such as coal, ore and grain into or to remove materials from railway cars, trucks or other vehicles","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"75101.02","via":"75101","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"53-7011.00#32","text":"Operate conveyors and equipment to transfer grain or other materials from transportation vehicles to elevators, bins or other storage areas","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"75101.02","via":"75101","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null}]}