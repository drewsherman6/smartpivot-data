0.3333333333333333,"basis":"direct"}},{"id":"53-7011.00#21","text":"Repair or replace equipment components or parts such as blades, rolls, and pumps.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10753","via":"53-7011.00","match":"native","w":0.214}],"n_sources":1,"weight":0.214,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"53-7011.00#22","text":"Measure dimensions of bundles, using rulers, and cut battens to required sizes, using power saws.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10763","via":"53-7011.00","match":"native","w":0.006}],"n_sources":1,"weight":0.006,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":null},{"id":"53-7011.00#23","text":"Join sections of conveyor frames at temporary working areas, and connect power units.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10765","via":"53-7011.00","match":"native","w":0.071}],"n_sources":1,"weight":0.071,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"53-7011.00#24","text":"Load, unload and move products and materials by hand or using basic material handling equipment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"75101.01","via":"75101","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"53-7011.00#25","text":"Perform other material handling activities such as counting, weighing, sorting, packing and unpacking.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"75101.01","via":"75101","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"53-7011.00#26","text":"May perform other activities, such as opening containers and crates, filling warehouse orders, assisting in taking inventory a