,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-3041.00#10","text":"Make arrangements for illegally parked or abandoned vehicles to be towed, and direct tow-truck drivers to the correct vehicles.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7948","via":"33-3041.00","match":"native","w":0.077}],"n_sources":1,"weight":0.077,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-3041.00#11","text":"Observe and report hazardous conditions, such as missing traffic signals or signs, and street markings that need to be repainted.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7943","via":"33-3041.00","match":"native","w":0.039}],"n_sources":1,"weight":0.039,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E3","score":1,"basis":"direct"}},{"id":"33-3041.00#12","text":"Perform simple vehicle maintenance procedures, such as checking oil and gas, and report mechanical problems to supervisors.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7942","via":"33-3041.00","match":"native","w":0.039}],"n_sources":1,"weight":0.039,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"33-3041.00#13","text":"Mark tires of parked vehicles with chalk and record time of marking, and return at regular intervals to ensure that parking time limits are not exceeded.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7938","via":"33-3041.00","match":"native","w":0.115}],"n_sources":1,"weight":0.115,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"33-3041.00#14","text":"Prepare and maintain required records, including logs of parking enforcement activities,