xt":"Align, fit, assemble, connect, or install system components, using jigs, fixtures, measuring instruments, hand tools, or power tools.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13924","via":"51-2011.00","match":"native","w":0.385}],"n_sources":1,"weight":0.385,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-2011.00#10","text":"Cut, trim, file, bend, or smooth parts to ensure proper fit and clearance.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"20813","via":"51-2011.00","match":"native","w":0.308}],"n_sources":1,"weight":0.308,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-2011.00#11","text":"Clean, oil, or coat system components, as necessary, before assembly or attachment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13931","via":"51-2011.00","match":"native","w":0.154}],"n_sources":1,"weight":0.154,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-2011.00#12","text":"Cut cables and tubing, using master templates, measuring instruments, and cable cutters or saws.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13942","via":"51-2011.00","match":"native","w":0.077}],"n_sources":1,"weight":0.077,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-2011.00#13","text":"Set up or operate machines or systems to crimp, cut, bend, form, swage, flare, bead, burr, or straighten tubing, according to specifications.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13935","via":"51-2011.00","match":"native","w":0.077}],"n_sources":1,"weight":0.077,"ai":{"pct":0,"an