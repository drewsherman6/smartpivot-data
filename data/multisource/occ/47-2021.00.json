measures":0.1}}},"statements":[{"id":"47-2021.00#1","text":"Measure distance from reference points and mark guidelines to lay out work, using plumb bobs and levels.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4769","via":"47-2021.00","match":"native","w":0.267}],"n_sources":1,"weight":0.267,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"47-2021.00#2","text":"Construct corners by fastening in plumb position a corner pole or building a corner pyramid of bricks, and filling in between the corners using a line from corner to corner to guide each course, or layer, of brick.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4768","via":"47-2021.00","match":"native","w":0.4}],"n_sources":1,"weight":0.4,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"47-2021.00#3","text":"Apply and smooth mortar or other mixture over work surface.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4775","via":"47-2021.00","match":"native","w":0.8}],"n_sources":1,"weight":0.8,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E3","score":1,"basis":"direct"}},{"id":"47-2021.00#4","text":"Calculate angles and courses and determine vertical and horizontal alignment of courses.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4770","via":"47-2021.00","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E3","score":1,"basis":"direct"}},{"id":"47-2021.00#5","text":"Break or cut bricks, tiles, or blocks to size, using trowel edge, hammer, or power saw.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4772","via":"47-2021.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2021.00#6","text":"Interpret blueprints and drawings to determine specifications and to calculate the materials required.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4774","via":"47-2021.00","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"47-2021.00#7","text":"Remove excess mortar with trowels and hand tools, and finish mortar joints with jointing tools, for a sealed, uniform appearance.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4773","via":"47-2021.00","match":"native","w":0.467}],"n_sources":1,"weight":0.467,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"47-2021.00#8","text":"Fasten or fuse brick or other building material to structure with wire clamps, anchor holes, torch, or cement.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4771","via":"47-2021.00","match":"native","w":0.267}],"n_sources":1,"weight":0.267,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2021.00#9","text":"Clean working surface to remove scale, dust, soot, or chips of brick and mortar, using broom, wire brush, or scraper.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4778","via":"47-2021.00","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2021.00#10","text":"Examine brickwork or structure to determine need for repair.","kind":"task","esco_uri":null,"sources":[{"sourc