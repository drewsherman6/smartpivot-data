r_measures":0.5}}},"statements":[{"id":"53-6041.00#1","text":"Study factors affecting traffic conditions, such as lighting or sign and marking visibility, to assess their effectiveness.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8635","via":"53-6041.00","match":"native","w":0.599}],"n_sources":1,"weight":0.599,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"53-6041.00#2","text":"Interact with the public to answer traffic-related questions, respond to complaints or requests, or discuss traffic control ordinances, plans, policies, or procedures.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8630","via":"53-6041.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"53-6041.00#3","text":"Prepare work orders for repair, maintenance, or changes in traffic systems.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8634","via":"53-6041.00","match":"native","w":0.8}],"n_sources":1,"weight":0.8,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"53-6041.00#4","text":"Plan, design, and improve components of traffic control systems to accommodate current or projected traffic and to increase usability and efficiency.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8632","via":"53-6041.00","match":"native","w":0.8}],"n_sources":1,"weight":0.8,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"53-6041.00#5","text":"Analyze data related to traffic flow, accident rates, or proposed development to determine the most efficient methods to expedite traffic flow.","kind":"task","esco_uri":null,"sources":[{"source":"on