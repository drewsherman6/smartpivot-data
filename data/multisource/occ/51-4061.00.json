3333333333333,"basis":"direct"}},{"id":"51-4061.00#5","text":"Cut, shape, and form metal parts, using lathes, power saws, snips, power brakes and shears, files, and mallets.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"12025","via":"51-4061.00","match":"native","w":0.636}],"n_sources":1,"weight":0.636,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-4061.00#6","text":"Rework or alter component model or parts as required to ensure that products meet standards.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"12030","via":"51-4061.00","match":"native","w":0.455}],"n_sources":1,"weight":0.455,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-4061.00#7","text":"Drill, countersink, and ream holes in parts and assemblies for bolts, screws, and other fasteners, using power tools.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"12027","via":"51-4061.00","match":"native","w":0.273}],"n_sources":1,"weight":0.273,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-4061.00#8","text":"Grind, file, and sand parts to finished dimensions.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"12028","via":"51-4061.00","match":"native","w":0.455}],"n_sources":1,"weight":0.455,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-4061.00#9","text":"Devise and construct tools, dies, molds, jigs, and fixtures, or modify existing tools and equipment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"12034","via":"51-4061.00","match":"native","w":0.455}],"n_sources":1,"weight":0.455,"ai":{"pct":0,"anthr