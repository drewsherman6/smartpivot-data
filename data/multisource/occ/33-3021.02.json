co/occupation/3880e9e8-bc2b-48d9-8afc-a0f258c1c4b0","match":"closeMatch","essential":false,"w":0.4}],"n_sources":1,"weight":0.4,"ai":null,"robotics":null},{"id":"33-3021.02#69","text":"Establishing contacts and sources of information about crimes planned or committed, in order to prevent crimes or identify suspected offenders","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3355-1","via":"3355","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.389,"anthropic_penetration":null,"ilo_2025":0.235,"basis":"direct"},"robotics":null},{"id":"33-3021.02#70","text":"Obtaining and verifying evidence by examining crime and accident scenes for clues and physical evidence, interviewing witnesses and suspects and analysing documents and computer files","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3355-2","via":"3355","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.453,"anthropic_penetration":null,"ilo_2025":0.26,"basis":"direct"},"robotics":null},{"id":"33-3021.02#71","text":"Analysing evidence in order to solve crimes, identify criminal activity and gather information for court cases","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3355-3","via":"3355","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.466,"anthropic_penetration":null,"ilo_2025":0.265,"basis":"direct"},"robotics":null},{"id":"33-3021.02#72","text":"Establishing contacts and sources of information not readily available or apparent concerning establishments or the circumstances and behaviour of persons, usually with the aim of preventing a crime","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3355-4","via":"3355","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.506,"anthropic_penetration":null,"ilo_2025":0.285,"basis":"direct"},"robotics":null},{"id":"33-3021.02#73","text":"Making arrests","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3355-5","via":"3355","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.054,"anthropic_penetration":null,"ilo_2025":0.1025,"basis":"direct"},"robotics":null},{"id":"33-3021.02#74","text":"Testifying in courts of law or reporting to superiors about circumstances and results of investigations.","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3355-6","via":"3355","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.424,"anthropic_penetration":null,"ilo_2025":0.25,"basis":"direct"},"robotics":null},{"id":"33-3021.02#75","text":"Interviews persons in connection with criminal incidents, including victims, witnesses and suspects","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.02#76","text":"Exchange information and coordinate activities with other law enforcements agencies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"transferred","from":"Serve as technical advisor and coordinate with other law enforcement workers or legal personnel to exchange information ","similarity":0.375},"robotics":{"tier":"E0","score":0,"basis":"transferred","from":"Serve as technical advisor and coordinate with other law enforcement workers or legal personnel to exchange information ","similarity":0.375}},{"id":"33-3021.02#77","text":"Prepare investigation reports and testify in courts concerning criminal investigations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":{"pct":0.424,"anthropic_penetration":null,"ilo_2025":0.25,"basis":"transferred","from":"Testifying in courts of law or reporting to superiors about circumstances and results of investigations.","similarity":0.364},"robotics":null},{"id":"33-3021.02#78","text":"Search and collect physical evidence from crimes scenes, such as fingerprints, and attend autopsies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.02#79","text":"Perform surveillance by using investigative technologies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.02#80","text":"Obtain search warrants, conduct searches and arrest suspects","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.02#81","text":"May conduct investigation on online networks and computer systems to detect cyber crimes or to recover data.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.02#82","text":"May supervise and coordinate the work of police officers.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.02#83","text":"Conduct death investigations to determine the identity of the deceased, date and location of death, medical cause of death, and manner of death","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.02#84","text":"Order or perform autopsies and other medical tests","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.02#85","text":"Consult with and request assistance from law enforcement, physicians, and family","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.02#86","text":"Issue death certificates, including assigning cause and manner of death","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.02#87","text":"Identify and educate the public on dangerous practices or conditions that may lead to death","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.02#88","text":"May testify or produce evidence in proceedings about observations made during investigations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.02#89","text":"May supervisor and coordinator work of other employees.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.02#90","text":"Respond to emergency calls and complaints, execute search warrants and arrest criminal suspects","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.02#91","text":"Patrol assigned areas on foot, horseback, bicycle and motorized vehicles to maintain public safety and order and to enforce laws and regulations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.02#92","text":"Prepare reports to record incidents and patrol activities and to provide testimony in courts of law","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.02#93","text":"Provide emergency assistance to victims of accidents, crimes and natural disasters","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.02#94","text":"Monitor traffic to ensure motorists observe traffic regulations and test persons suspected of driving under the influence of alcohol and drugs","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.02#95","text":"Control crowds at public events and protests and monitor suspicious and violent behaviour","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.02#96","text":"Participate in crime prevention, public information, safety and community relations programs","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.02#97","text":"Perform daily administrative tasks in support of law enforcement activities, such as maintaining equipment and information files","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.02#98","text":"May assist police investigators in criminal investigations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null}]}