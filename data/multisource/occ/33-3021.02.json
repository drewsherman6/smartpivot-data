f":"2123","via":"33-3021.02","match":"native","w":0.4}],"n_sources":1,"weight":0.4,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-3021.02#6","text":"Dust selected areas of crime scene and lift latent fingerprints, adhering to proper preservation procedures.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2122","via":"33-3021.02","match":"native","w":0.4}],"n_sources":1,"weight":0.4,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-3021.02#7","text":"Analyze and process evidence at crime scenes, during autopsies, or in the laboratory, wearing protective equipment and using powders and chemicals.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21036","via":"33-3021.02","match":"native","w":0.933}],"n_sources":1,"weight":0.933,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-3021.02#8","text":"Package, store and retrieve evidence.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2125","via":"33-3021.02","match":"native","w":0.533}],"n_sources":1,"weight":0.533,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"33-3021.02#9","text":"Process film and prints from crime or accident scenes.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2129","via":"33-3021.02","match":"native","w":0.067}],"n_sources":1,"weight":0.067,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-3021.02#10","text":"Take fingerprints.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"24007","via":"33-3021.02","match":"native","w":0.006}],"n_sources":1,"weight":0.006,"ai":null,"robotics":null},{"id":"33-3021.02#11","text":"Perform emergency work during off-hours.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2127","via":"33-3021.02","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-3021.02#12","text":"Serve as technical advisor and coordinate with other law enforcement workers or legal personnel to exchange information on crime scene collection activities.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"18711","via":"33-3021.02","match":"native","w":0.267}],"n_sources":1,"weight":0.267,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-3021.02#13","text":"Create sketches and diagrams, by hand or computer software, to depict crime scenes.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21037","via":"33-3021.02","match":"native","w":0.267}],"n_sources":1,"weight":0.267,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-3021.02#14","text":"Coordinate or conduct instructional classes or in-services, such as citizen police academy classes and crime scene training for other officers.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"18712","via":"33-3021.02","match":"native","w":0.133}],"n_sources":1,"weight":0.133,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-3021.02#15","text":"Identify, compare, classify, and file fingerprints, using systems such as Automated Fingerprint Identification System (AFIS) or the Henry Classification System.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"18710","via":"33-3021.02","match":"native","w":0.267}],"n_sources":1,"wei