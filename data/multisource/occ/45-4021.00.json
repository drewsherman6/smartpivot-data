ation (SOC 2010 via BLS 2010-2018)","raw":0.76,"pct":0.618}]}},"agreement":{"families":4,"sd":0.249,"range":0.52,"label":"sources partly agree"},"headline":{"value":0.057,"time_weighted_tasks":0.062,"other_measures_pct":0.397,"other_measures_linked":0.016,"weight_time_weighted":0.9,"weight_other_measures":0.1}}},"statements":[{"id":"45-4021.00#1","text":"Saw back-cuts, leaving sufficient sound wood to control direction of fall.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13486","via":"45-4021.00","match":"native","w":0.667}],"n_sources":1,"weight":0.667,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"45-4021.00#2","text":"Control the direction of a tree's fall by scoring cutting lines with axes, sawing undercuts along scored lines with chainsaws, knocking slabs from cuts with single-bit axes, and driving wedges.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13491","via":"45-4021.00","match":"native","w":0.75}],"n_sources":1,"weight":0.75,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"45-4021.00#3","text":"Stop saw engines, pull cutting bars from cuts, and run to safety as tree falls.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13484","via":"45-4021.00","match":"native","w":0.167}],"n_sources":1,"weight":0.167,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"45-4021.00#4","text":"Select trees to be cut down, assessing factors such as site, terrain, and weather conditions before beginning work.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13493","via":"45-4021.00","match":"native","w":0.25}],"n_sources":1,"weight":0.25,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"45-4021.00#5","text":"Measure felled trees and cut them into specified log lengths, using chain saws and axes.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13488","via":"45-4021.00","match":"native","w":0.834}],"n_sources":1,"weight":0.834,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"45-4021.00#6","text":"Insert jacks or drive wedges behind saws to prevent binding of saws and to start trees falling.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13495","via":"45-4021.00","match":"native","w":0.167}],"n_sources":1,"weight":0.167,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"45-4021.00#7","text":"Assess logs after cutting to ensure that the quality and length are correct.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13489","via":"45-4021.00","match":"native","w":0.167}],"n_sources":1,"weight":0.167,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"45-4021.00#8","text":"Appraise trees for certain characteristics, such as twist, rot, and heavy limb growth, and gauge amount and direction of lean, to determine how to control the direction of a tree's fall with the least damage.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13485","via":"45-4021.00","match":"native","w":0.5}],"n_sources":1,"weight":0.5,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"45-4021.00#9","text":"Clear brush from work areas and escape routes, and cut saplings and other trees from direction of falls, using axes, chainsaws, or bulldozers.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13487","via":"45-4021.00","match":"native","w":0.583}],"n_sources":1,"weight":0.583,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"45-4021.00#10","text":"Tag unsafe trees with high-visibility ribbons.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13496","via":"45-4021.00","match":"native","w":0.083}],"n_sources":1,"weight":0.083,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"45-4021.00#11","text":"Determine position, direction, and depth of cuts to be made, and placement of wedges or jacks.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13490","via":"45-4021.00","match":"native","w":0.334}],"n_sources":1,"weight":0.334,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"45-4021.00#12","text":"Maintain and repair chainsaws and other equipment, cleaning, oiling, and greasing equipment, and sharpening equipment properly.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13494","via":"45-4021.00","match":"native","w":0.583}],"n_sources":1,"weight":0.583,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"45-4021.00#13","text":"Trim off the tops and limbs of trees, using chainsaws, delimbers, or axes.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13492","via":"45-4021.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"45-4021.00#14","text":"Mark logs for identification.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13499","via":"45-4021.00","match":"native","w":0.083}],"n_sources":1,"weight":0.083,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"45-4021.00#15","text":"Place supporting limbs or poles under felled trees to avoid splitting undersides, and to prevent logs from rolling.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13501","via":"45-4021.00","match":"native","w":0.083}],"n_sources":1,"weight":0.083,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"45-4021.00#16","text":"Secure steel cables or chains to logs for dragging by tractors or for pulling by cable yarding systems.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13497","via":"45-4021.00","match":"native","w":0.167}],"n_sources":1,"weight":0.167,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"45-4021.00#17","text":"Work as a member of a team, rotating between chain saw operation and skidder operation.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13500","via":"45-4021.00","match":"native","w":0.25},{"source":"oasis","ref":"84110.00","via":"84110","match":"statcan_concordance","w":1}],"n_sources":2,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"45-4021.00#18","text":"fell trees","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/b8cfe3d0-15a7-4be4-a7f1-f5141ed11f16","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/b8cfe3d0-15a7-4be4-a7f1-f5141ed11f16","via":"http://data.europa.eu/esco/occupation/699057b7-7aeb-4b5c-bb90-01d935ff32c1","match":"closeMatch","essential":true,"w":0.8},{"source":"esco","ref":"http://data.europa.eu/esco/skill/50113beb-08ca-42c4-ae2d-22106ab48a21","via":"http://data.europa.eu