ect"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-8011.00#2","text":"Adjust controls to position rod and to regulate flux level, reactor period, coolant temperature, or rate of power flow, following standard procedures.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8506","via":"51-8011.00","match":"native","w":0.25}],"n_sources":1,"weight":0.25,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-8011.00#3","text":"Develop or implement actions such as lockouts, tagouts, or clearances to allow equipment to be safely repaired.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"20680","via":"51-8011.00","match":"native","w":0.25}],"n_sources":1,"weight":0.25,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-8011.00#4","text":"Respond to system or unit abnormalities, diagnosing the cause, and recommending or taking corrective action.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8507","via":"51-8011.00","match":"native","w":0.25}],"n_sources":1,"weight":0.25,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-8011.00#5","text":"Monitor all systems for normal running conditions, performing activities such as checking gauges to assess output or the effects of generator loading on other equipment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8508","via":"51-8011.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-8011.00#6","text":"Monitor or operate boilers, turbines, wells, or auxiliary power plant equipment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":