ighted":0.5,"weight_other_measures":0.5}}},"statements":[{"id":"41-3021.00#1","text":"Customize insurance programs to suit individual customers, often covering a variety of risks.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"720","via":"41-3021.00","match":"native","w":0.462}],"n_sources":1,"weight":0.462,"ai":{"pct":0.961,"anthropic_penetration":0.915,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"41-3021.00#2","text":"Sell various types of insurance policies to businesses and individuals on behalf of insurance companies, including automobile, fire, life, property, medical and dental insurance, or specialized policies, such as marine, farm/crop, and medical malpractice.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"721","via":"41-3021.00","match":"native","w":0.769}],"n_sources":1,"weight":0.769,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"41-3021.00#3","text":"Explain features, advantages, and disadvantages of various policies to promote sale of insurance plans.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"724","via":"41-3021.00","match":"native","w":0.538}],"n_sources":1,"weight":0.538,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"41-3021.00#4","text":"Perform administrative tasks, such as maintaining records and handling policy renewals.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"728","via":"41-3021.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"41-3021.00#5","text":"Seek out new clients and develop clientele by networking to find new customers and generate lists of prospective clients.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"723","via":"41-3021.00","match":"native","w":0.846}],"n_sources":1,"weight":0.846,"ai":{"pct":0.977,"anthropic_penetration":0.963,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"41-3021.00#6","text":"Call on policyholders to deliver and explain policy, to analyze insurance program and suggest additions or changes, or to change beneficiaries.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"718","via":"41-3021.00","match":"native","w":0.384}],"n_sources":1,"weight":0.384,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"41-3021.00#7","text":"Confer with clients to obtain and provide information when claims are made on a policy.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"727","via":"41-3021.00","match":"native","w":0.384}],"n_sources":1,"weight":0.384,"ai":{"pct":0.964,"anthropic_penetration":0.922,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"41-3021.00#8","text":"Interview prospective clients to obtain data about their financial resources and needs, the physical condition of the person or property to be insured, and to discuss any existing coverage.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"722","via":"41-3021.00","match":"native","w":0.538}],"n_sources":1,"weight":0.538,"ai":{"pct":0.986,"anthropic_penetration":0.986,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"41-3021.00#9","text":"Contact underwriter and submit forms to obtain binder coverage.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"725","via":"41-3021.00","match":"native","w":0.231}],"n_sources":1,"weight":0.231,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"41-3021.00#10","text":"Select company that offers type of coverage requested by client to underwrite policy.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"729","via":"41-3021.00","match":"native","w":0.154}],"n_sources":1,"weight":0.154,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"41-3021.00#11","text":"Ensure that policy requirements are fulfilled, including any necessary medical examinations and the completion of appropriate forms.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"726","via":"41-3021.00","match":"native","w":0.231},{"source":"oasis","ref":"63100.00","via":"63100","match":"statcan_concordance","w":1}],"n_sources":2,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"41-3021.00#12","text":"Develop marketing strategies to compete with other individuals or companies who sell insurance.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"731","via":"41-3021.00","match":"native","w":0.154}],"n_sources":1,"weight":0.154,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"41-3021.00#13","text":"Calculate premiums and establish payment method.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"719","via":"41-3021.00","match":"native","w":0.231},{"source":"oasis","ref":"63100.00","via":"63100","match":"statcan_concordance","w":1}],"n_sources":2,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"41-3021.00#14","text":"Attend meetings, seminars, and programs to learn about new products and services, learn new skills, and receive technical assistance in developing new accounts.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"732","via":"41-3021.00","match":"native","w":0.231}],"n_sources":1,"weight":0.231,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"41-3021.00#15","text":"Monitor insurance claims to ensure they are settled equitably for both the client and the insurer.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"730","via":"41-3021.00","match":"native","w":0.154}],"n_sources":1,"weight":0.154,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"41-3021.00#16","text":"Plan and oversee incorporation of insurance program into bookkeeping system of company.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"735","via":"41-3021.00","match":"native","w":0.006}],"n_sources":1,"weight":0.006,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"41-3021.00#17","text":"Inspect property, examining its general condition, type of construction, age, and other characteristics, to decide if it is a good insurance risk.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"733","via":"41-3021.00","match":"native","w":0.077}],"n_sources":1,"weight":0.077,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E3","score":1,"basis":"direct"}},{"id":"41-3021.00#18","text":"Install bookkeeping systems and resolve system problems.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"734","via":"41-3021.00","match":"native","w":0.006}],"n_sources":1,"weight":0.006,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"41-3021.00#19","text":"Explain necessary bookkeeping requirements for customer to implement and provide group insurance program.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"736","