a":"49-9052.00","match":"native","w":0.008}],"n_sources":1,"weight":0.008,"ai":null,"robotics":null},{"id":"49-9052.00#5","text":"Access specific areas to string lines, or install terminal boxes, auxiliary equipment, or appliances, using bucket trucks, climbing poles or ladders, or entering tunnels, trenches, or crawl spaces.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"11852","via":"49-9052.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-9052.00#6","text":"Lay underground cable directly in trenches, or string it through conduits running through trenches.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"11855","via":"49-9052.00","match":"native","w":0.4}],"n_sources":1,"weight":0.4,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-9052.00#7","text":"Pull cable through ducts by hand or with winches.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"20807","via":"49-9052.00","match":"native","w":0.4}],"n_sources":1,"weight":0.4,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-9052.00#8","text":"Pull up cable by hand from large reels mounted on trucks.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"20806","via":"49-9052.00","match":"native","w":0.3}],"n_sources":1,"weight":0.3,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-9052.00#9","text":"Travel to customers' premises to install, maintain, or repair audio and visual electronic reception equipment or accessories.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"11846","via":"49-9052.00","match":"native","w":0.8}],"n_sources":1,"weight":0.8,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-9052.00#10","text":"Measure signal strength at utility poles, using electronic test equipment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"11849","via":"49-9052.00","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-9052.00#11","text":"Place insulation over conductors, or seal splices with moisture-proof covering.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"11851","via":"49-9052.00","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-9052.00#12","text":"Compute impedance of wires from poles to houses to determine additional resistance needed for reducing signals to desired levels.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"11859","via":"49-9052.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-9052.00#13","text":"Explain cable service to subscribers after installation, and collect any installation fees due.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"11858","via":"49-9052.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-9052.00#14","text":"String cables between structures and lines from poles, towers, or trenches, and pull lines to proper tension.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"11853","via":"49-9052.00","match":"native","w":0.8}],"n_sources":1,"weight":0.8,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-9052.00#15","text":"Fill and tamp holes, using cement, earth, and tamping devices.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"11863","via":"49-9052.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-9052.00#16","text":"Dig trenches for underground wires or cables.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"11861","via":"49-9052.00","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-9052.00#17","text":"Install equipment such as amplifiers or repeaters to maintain the strength of communications transmissions.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"11854","via":"49-9052.00","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-9052.00#18","text":"Use a variety of construction equipment to complete installations, such as digger derricks, trenchers, or cable plows.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"11860","via":"49-9052.00","match":"native","w":0.3}],"n_sources":1,"weight":0.3,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-9052.00#19","text":"Dig holes for power poles, using power augers or shovels, set poles in place with cranes, and hoist poles upright, using winches.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"11862","via":"49-9052.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-9052.00#20","text":"Participate in the construction or removal of telecommunication towers or associated support structures.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"11864","via":"49-9052.00","match":"native","w":0.008}],"n_sources":1,"weight":0.008,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":null},{"id":"49-9052.00#21","text":"telecommunication trunking","kind":"knowledge","esco_uri":"http://data.europa.eu/esco/skill/4f1afd9d-77a7-40f8-a3c7-fe18b984ce43","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/4f1afd9d-77a7-40f8-a3c7-fe18b984ce43","via":"http://data.europa.eu/esco/occupation/056bef79-c125-47ab-b6b9-8eed05c9458c","match":"closeMatch","essential":true,"w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"49-9052.00#22","text":"operate two-way radio systems","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/30d926ba-1615-417c-a799-e24a3ea239b9","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/30d926ba-1615-417c-a799-e24a3ea239b9","via":"http://data.europa.eu/esco/occupation/056bef79-c125-47ab-b6b9-8eed05c9458c","match":"closeMatch","essential":true,"w":0.8}],"n_sources":1,"weight":0.8,"ai":null,"robotics":null},{"id":"49-9052.00#23","text":"procurement of ICT network equipment","kind":"knowledge","esco_uri":"http://data.europa.eu/esco/skill/32428b21-514b-42c2-81b5-244a7804ea74","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/32428b21-514b-42c2-81b5-244a7804ea74","via":"http://data.europa.eu/esco/occupation/056bef79-c125-47ab-b6b9-8eed05c9458c","match":"closeMatch","essential":true,"w":1}],"n_sources":1,"weight":1,"