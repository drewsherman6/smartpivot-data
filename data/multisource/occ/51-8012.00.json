n_sources":1,"weight":1,"ai":{"pct":0.537,"anthropic_penetration":null,"ilo_2025":0.295,"basis":"direct"},"robotics":null},{"id":"51-8012.00#45","text":"Operating and controlling power generating systems and equipment including boilers, turbines, generators, condensers, and reactors in hydro, thermal, coal, oil, natural gas, and nuclear power plants to generate and distribute electrical power","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3131-2","via":"3131","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.328,"anthropic_penetration":null,"ilo_2025":0.1925,"basis":"direct"},"robotics":null},{"id":"51-8012.00#46","text":"Controlling start-up and shut-down of power plant equipment, controlling switching operations, regulating water levels and communicating with systems operators to regulate and coordinate transmission loads, frequency and line voltages","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3131-3","via":"3131","match":"bls_crosswalk","w":1},{"source":"oasis","ref":"92100.01","via":"92100","match":"statcan_concordance","w":1}],"n_sources":2,"weight":1,"ai":{"pct":0.401,"anthropic_penetration":null,"ilo_2025":0.24,"basis":"direct"},"robotics":null},{"id":"51-8012.00#47","text":"Taking readings from charts, meters and gauges at established intervals, troubleshooting and performing corrective action as necessary","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3131-4","via":"3131","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.603,"anthropic_penetration":null,"ilo_2025":0.3325,"basis":"direct"},"robotics":null},{"id":"51-8012.00#48","text":"Completing and maintaining station records, logs and reports, and communicating with other plant personnel to assess equipment operating status","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3131-5","via":"3131","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.819,"anthropic_penetration":null,"ilo_2025":0.4575,"basis":"direct"},"robotics":null},{"id":"51-8012.00#49","text":"Cleaning and maintaining equipment such as generators, boilers, turbines, pumps, and compressors in order to prevent equipment failure or deterioration.","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3131-6","via":"3131","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.134,"anthropic_penetration":null,"ilo_2025":0.135,"basis":"direct"},"robotics":null},{"id":"51-8012.00#50","text":"Power engineers","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"92100.01","via":"92100","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"51-8012.00#51","text":"Operate automated or computerized control systems, stationary engines and auxiliary equipment such as reactors, boilers, turbines, generators, pumps, compressors, pollution control devices and other equipment to generate electrical power and to provide light, heat, ventilation and refrigeration for buildings, industrial plants and other work sites","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"92100.01","via":"92100","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"51-8012.00#52","text":"Monitor and inspect plant equipment, computer terminals, switches, valves, gauges, alarms, meters and other instruments to measure temperature, pressure and fuel flow to detect leaks or other equipment malfunctions and to ensure plant equipment is operating at maximum efficiency","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"92100.01","via":"92100","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"51-8012.00#53","text":"Analyze and record instrument readings and equipment malfunctions","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"92100.01","via":"92100","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"51-8012.00#54","text":"Troubleshoot and perform corrective action and minor repairs to prevent equipment or system failure","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"92100.01","via":"92100","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"51-8012.00#55","text":"Respond to emergency situations if required","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"92100.01","via":"92100","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"51-8012.00#56","text":"Clean and lubricate generators, turbines, pumps and compressors and perform other routine equipment maintenance duties using appropriate lubricants and hand, power and precision tools","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"92100.01","via":"92100","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"51-8012.00#57","text":"Maintain a daily log of operation, maintenance and safety activities, and write reports on plant operation and non-compliance","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"92100.01","via":"92100","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"51-8012.00#58","text":"May assist in the development of operation, maintenance and safety procedures.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"92100.01","via":"92100","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"51-8012.00#59","text":"Power systems operators","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"92100.02","via":"92100","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"51-8012.00#60","text":"Operate and monitor computerized switchboards and auxiliary equipment in electrical control centres to control the distribution and to regulate the flow of electrical power in the transmission network","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"92100.02","via":"92100","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"51-8012.00#61","text":"Coordinate, schedule and direct generating station and substation power loads and line voltages to meet distribution demands during daily operations, system outages, repairs and importing or exporting of power","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"92100.02","via":"92100","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"51-8012.00#62","text":"Monitor and visually inspect station instruments, meters and alarms to ensure transmission voltages and line loadings are within prescribed limits and to detect equipment failure, line disturbances and outages","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"92100.02","via":"92100","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"51-8012.00#63","text":"Issue work and test permits to electrical and mechanical maintenance personnel, assist maintenance and technical personnel to locate and isolate system problems, and assist during routine system testing","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"92100.02","via":"92100","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"51-8012.00#64","text":"Complete and maintain station records, logs and reports.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"92100.02","via":"92100","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.819,"anthropic_penetration":null,"ilo_2025":0.4575,"basis":"transferred","from":"Completing and maintaining station records, logs and reports, and communicating with other plant personnel to assess equ","similarity":0