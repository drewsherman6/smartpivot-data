":"33-1012.00#87","text":"Consult with and request assistance from law enforcement, physicians, and family","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-1012.00#88","text":"Issue death certificates, including assigning cause and manner of death","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-1012.00#89","text":"Identify and educate the public on dangerous practices or conditions that may lead to death","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-1012.00#90","text":"May testify or produce evidence in proceedings about observations made during investigations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-1012.00#91","text":"May supervisor and coordinator work of other employees.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null}]}