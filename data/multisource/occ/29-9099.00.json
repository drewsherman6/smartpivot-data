sco_uri":null,"sources":[{"source":"ilo","ref":"3259-2","via":"3259","match":"bls_crosswalk","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0.595,"anthropic_penetration":null,"ilo_2025":0.33,"basis":"direct"},"robotics":null},{"id":"29-9099.00#49","text":"Administering therapeutic care and treatment to patients;\r\n(d ) performing certain basic clinical procedures, such as administration of HIV antibody tests or insertion of intrauterine devices","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3259-3","via":"3259","match":"bls_crosswalk","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0.086,"anthropic_penetration":null,"ilo_2025":0.116,"basis":"direct"},"robotics":null},{"id":"29-9099.00#50","text":"Dispensing and advising on dietary supplements, antiretroviral and prophylaxis medications, and other healthcare products","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3259-4","via":"3259","match":"bls_crosswalk","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0.629,"anthropic_penetration":null,"ilo_2025":0.3475,"basis":"direct"},"robotics":null},{"id":"29-9099.00#51","text":"Monitoring patients' progress through treatment plans, and identifying signs and symptoms requiring referral to a medical doctor or other health professional","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3259-5","via":"3259","match":"bls_crosswalk","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0.42,"anthropic_penetration":null,"ilo_2025":0.2475,"basis":"direct"},"robotics":null},{"id":"29-9099.00#52","text":"Recording information on patients' health status and responses to treatment in medical records-keeping systems","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3259-6","via":"3259","match":"bls_crosswalk","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0.944,"anthropic_penetration":null,"ilo_2025":0.6000000000000001,"basis":"direct"},"robotics":null},{"id":"29-9099.00#53","text":"Sharing information with other health care providers when required to ensure continuing and comprehensive care.","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3259-7","via":"3259","match":"bls_crosswalk","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0.483,"anthropic_penetration":null,"ilo_2025":0.2725,"basis":"direct"},"robotics":null},{"id":"29-9099.00#54","text":"Diagnose within the framework of Traditional Chinese Medicine the diseases, physiological disorders and injuries of patients","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32200.01","via":"32200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-9099.00#55","text":"Explain procedures, risks and benefits of treatments to patients","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32200.01","via":"32200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-9099.00#56","text":"Prescribe and administer treatment such as acupuncture, electro-acupuncture, Transcutaneous Electrical Nerve Stimulation (TENS), scraping (Gua Sha), cupping therapy, moxibustion, acupressure, and auriculotherapy","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32200.01","via":"32200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-9099.00#57","text":"May prescribe and administer Chinese manipulative therapy (Tui Na), energy control therapy (Qi Gong) and laser therapy","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32200.01","via":"32200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-9099.00#58","text":"May suggest home care instructions and provide information about life therapies including energy control therapy (Qi Gong), Chinese shadow boxing (Tai Ji Quan) and Chinese food cure recipes (Shi Liao)","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32200.01","via":"32200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-9099.00#59","text":"Maintain patient records","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32200.01","via":"32200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"transferred","from":"Maintain documentation of all patients' contacts, reviewing and updating records as necessary.","similarity":0.375},"robotics":{"tier":"E0","score":0,"basis":"transferred","from":"Maintain documentation of all patients' contacts, reviewing and updating records as necessary.","similarity":0.375}},{"id":"29-9099.00#60","text":"Prescribe and administer treatment using raw or granule herbs and other medicines or dietary supplements","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32200.01","via":"32200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-9099.00#61","text":"May collaborate with other health care professionals such as physiotherapists, chiropractors, physicians and psychologists when developing treatment plans for patients.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32200.01","via":"32200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-9099.00#62","text":"Diagnose symptoms, imbalances, physiological disorders and injuries of patients according to Chinese medicine traditions","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32200.02","via":"32200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-9099.00#63","text":"Educate patients on risks and benefits of treatments","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32200.02","via":"32200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-9099.00#64","text":"Develop and implement treatment plans including acupuncture, acupressure, moxibustion, cupping, scraping or electrical current","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32200.02","via":"32200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-9099.00#65","text":"Evaluate and document patients' progress","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32200.02","via":"32200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-9099.00#66","text":"May provide dietary and lifestyle advice including information on life therapies such as energy control therapy (Qi Gong)","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32200.02","via":"32200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-9099.00#67","text":"May develop treatment plans in collaboration with other health care professionals.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32200.02","via":"32200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-9099.00#68","text":"Assess patients and advise them on the use of herbs for the treatment of conditions such as arthritis, rheumatism, asthma, skin disorders and stomach ailments","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32209.01","via":"32209","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-9099.00#69","text":"May cultivate herbs and manufacture and sell herbal compounds.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32209.01","via":"32209","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-9099.00#70","text":"Assess, treat and manage musculoskeletal and other related disorders of the body's structure by moving, stretching, and massaging a patients' muscles and joints to correct biomechanical dysfunctions.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32209.02","via":"32209","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-9099.00#71","text":"Assess illnesses and treat them by administering, in chemical or herbal form, a small dosage of a remedy made from natural substances or by suggesting lifestyle changes.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32209.03","via":"32209","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-9099.00#72","text":"Assess clients’ physical, mental and emotional health","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32209.04","via":"32209","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-9099.00#73","text":"Provide advice and feedback to support clients’ wellbeing","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32209.04","via":"32209","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-9099.00#74","text":"Apply gentle pressure with thumb and fingers to stimulate specific reflex points or areas, usually on the clients' feet, hands, ears and/or face to relieve tension, improve circulation, and promote better health and well-being.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32209.04","via":"32209","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-9099.00#75","text":"Evaluate the overall health and wellness of clients and recommend nutritional and life style adjustments to address their health issues and to support health goals.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32209.05","via":"32209","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-9099.00#76","text":"Assess and treat illness and injury through the use of holistic approaches such as herbal remedies, massage, as well as counselling in nutrition and exercise.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32209.06","via":"32209","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null}]}