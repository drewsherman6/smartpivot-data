","ref":"64410.04","via":"64410","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"19-4099.00#95","text":"May also conduct polygraph tests (integrity surveys) for clients.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"64410.04","via":"64410","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"19-4099.00#96","text":"Prevent and detect shoplifting and theft in retail establishments.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"64410.05","via":"64410","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"19-4099.00#97","text":"Shampoo, condition and dry customers' hair and assist hair stylists as directed","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.01","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"19-4099.00#98","text":"Keep work areas clean.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.01","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"19-4099.00#99","text":"Assist persons entering or leaving residential buildings, theatres and similar establishments","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.02","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"19-4099.00#100","text":"May call taxis and assist with parcels.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.02","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"19-4099.00#101","text":"Drive hearses","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.03","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"19-4099.00#102","text":"Arrange lights and floral displays","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.03","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"19-4099.00#103","text":"Escort mourners and act as pallbearers","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.03","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"19-4099.00#104","text":"Clean funeral parlours and chapels.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.03","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"19-4099.00#105","text":"Replenish vending machines","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.04","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"19-4099.00#106","text":"Provide change","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.04","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"19-4099.00#107","text":"Explain operation of machines to customers","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.04","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"19-4099.00#108","text":"Clean the laundromat and arrange for the repair of broken machines","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.04","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"19-4099.00#109","text":"May wash, dry and fold laundry for customers","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.04","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"19-4099.00#110","text":"May operate dry cleaning machines for customers.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.04","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"19-4099.00#111","text":"Collect parking fees and issue ticket stubs","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.05","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"19-4099.00#112","text":"Direct customers to parking spaces and park cars.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.05","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"19-4099.00#113","text":"Collect admission tickets or passes from patrons at entertainment events and direct patrons to their seats.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.06","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"19-4099.00#114","text":"Perform services specific to the establishments in which their occupations are found.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.07","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null}]}