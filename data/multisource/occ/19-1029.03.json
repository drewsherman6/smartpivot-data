ind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16817","via":"19-1029.03","match":"native","w":0.636}],"n_sources":1,"weight":0.636,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"19-1029.03#6","text":"Search scientific literature to select and modify methods and procedures most appropriate for genetic research goals.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16830","via":"19-1029.03","match":"native","w":0.364}],"n_sources":1,"weight":0.364,"ai":{"pct":0.965,"anthropic_penetration":0.923,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"19-1029.03#7","text":"Review, approve, or interpret genetic laboratory results.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16829","via":"19-1029.03","match":"native","w":0.545}],"n_sources":1,"weight":0.545,"ai":{"pct":0.981,"anthropic_penetration":0.972,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"19-1029.03#8","text":"Attend clinical and research conferences and read scientific literature to keep abreast of technological advances and current genetic research findings.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16827","via":"19-1029.03","match":"native","w":0.364}],"n_sources":1,"weight":0.364,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"19-1029.03#9","text":"Evaluate genetic data by performing appropriate mathematical or statistical calculations and analyses.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16834","via":"19-1029.03","match":"native","w":0.636}],"n_sources":1,"weight":0.636,"ai":{"pct":0.933,"anthropic_penetration":0.816,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"19-1029.03#10","text":"Analyze determinants responsible for specific inherited traits, and devise methods for altering traits or producing new traits.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16840","via":"19-1029.03","match":"native","w":0.364}],"n_sources":1,"weight":0.364,"ai":{"pct":0.955,"anthropic_penetration":0.901,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"19-1029.03#11","text":"Extract deoxyribonucleic acid (DNA) or perform diagnostic tests involving processes such as gel electrophoresis, Southern blot analysis, and polymerase chain reaction analysis.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16833","via":"19-1029.03","match":"native","w":0.545}],"n_sources":1,"weight":0.545,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"19-1029.03#12","text":"Collaborate with biologists and other professionals to conduct appropriate genetic and biochemical analyses.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16826","via":"19-1029.03","match":"native","w":0.454}],"n_sources":1,"weight":0.454,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"19-1029.03#13","text":"Instruct medical students, graduate students, or others in methods or procedures for diagnosis and management of genetic disorders.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16822","via":"19-1029.03","match":"native","w":0.364}],"n_sources":1,"weight":0.364,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"19-1029.03#14","text":"Create or use statistical models for the analysis of genetic data.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"16837","via":"19-1029.03","match":"native","w":0.273}],"n_sources":1,"weight":0.273,