se","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2131-1","via":"2131","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.618,"anthropic_penetration":null,"ilo_2025":0.3375,"basis":"direct"},"robotics":null},{"id":"19-1029.03#73","text":"Designing and conducting experiments and tests","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2131-2","via":"2131","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.826,"anthropic_penetration":null,"ilo_2025":0.465,"basis":"direct"},"robotics":null},{"id":"19-1029.03#74","text":"Gathering human, animal, insect and plant specimens and data, and studying their origin, development, chemical and physical form, structure, composition, and life and reproductive processes","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2131-3","via":"2131","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.382,"anthropic_penetration":null,"ilo_2025":0.2325,"basis":"direct"},"robotics":null},{"id":"19-1029.03#75","text":"Examining living organisms using a variety of specialised equipment, instruments, technologies and techniques such as electron microscopes, telemetry, global positioning systems, biotechnology, satellite imaging, genetic engineering, digital imaging analysis, polymerase chain reaction and computer modelling","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2131-4","via":"2131","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.633,"anthropic_penetration":null,"ilo_2025":0.35,"basis":"direct"},"robotics":null},{"id":"19-1029.03#76","text":"Identifying, classifying, recording and monitoring living organisms and maintaining databases","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2131-5","via":"2131","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.564,"anthropic_penetration":null,"ilo_2025":0.31,"basis":"direct"},"robotics":null},{"id":"19-1029.03#77","text":"Writing scientific papers and reports detailing research and any new findings which are then made available to the scientific community in scientific journals or at conferences for scrutiny and further debate","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2131-6","via":"2131","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.872,"anthropic_penetration":null,"ilo_2025":0.515,"basis":"direct"},"robotics":null},{"id":"19-1029.03#78","text":"Designing and carrying out environmental impact assessments to identify changes caused by natural or human factors","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2131-7","via":"2131","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.826,"anthropic_penetration":null,"ilo_2025":0.465,"basis":"direct"},"robotics":null},{"id":"19-1029.03#79","text":"Providing advice to governments, organizations and businesses in areas such as conservation, management of natural resources, the effects of climate change and pollution.","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2131-8","via":"2131","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.857,"anthropic_penetration":null,"ilo_2025":0.5,"basis":"direct"},"robotics":null},{"id":"19-1029.03#80","text":"Plan and conduct studies of the environment, and of the population, distribution, structure and functional characteristics and behaviour of plants and animals","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21110.01","via":"21110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"19-1029.03#81","text":"Conduct ecological and environmental impact studies and prepare reports","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21110.01","via":"21110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"19-1029.03#82","text":"Study, identify and classify plant and animal specimens","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21110.01","via":"21110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"19-1029.03#83","text":"Conduct experiments in plant or animal growth, heredity and breeding","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21110.01","via":"21110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"19-1029.03#84","text":"Prepare reports and plans for management of renewable resources","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21110.01","via":"21110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"19-1029.03#85","text":"May supervise biological technologists and technicians and other scientists.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21110.01","via":"21110","match":"statcan_concordance","w":1},{"source":"oasis","ref":"21110.02","via":"21110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"19-1029.03#86","text":"Conduct research into the structure, function, ecology, biotechnology and genetics of micro-organisms, including bacteria, fungi, protozoans, and algae","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21110.02","via":"21110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"19-1029.03#87","text":"Conduct research into the structure and functioning of human, animal and plant tissues and cells","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21110.02","via":"21110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"19-1029.03#88","text":"Conduct studies into the identification, effects and control of human, plant and animal pathogens and toxins","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21110.02","via":"21110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"19-1029.03#89","text":"Conduct clinical or laboratory studies to test, evaluate and screen drugs, pharmaceuticals and nanoparticles used in biomedical applications","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21110.02","via":"21110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"19-1029.03#90","text":"Conduct molecular or biochemical studies and experiments in genetic expression, gene manipulation and recombinant DNA technology to develop new or alternative methods of producing products","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21110.02","via":"21110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"19-1029.03#91","text":"Conduct research in biotechnology to discover, develop and refine, and evaluate new products","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21110.02","via":"21110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"19-1029.03#92","text":"May participate in the commercialization of new products","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21110.02","via":"21110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"19-1029.03#93","text":"May conduct biostatistical data analysis using computer modelling techniques.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21110.02","via":"21110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null}]}