.5}}},"statements":[{"id":"47-2051.00#1","text":"Check the forms that hold the concrete to see that they are properly constructed.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7047","via":"47-2051.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2051.00#2","text":"Set the forms that hold concrete to the desired pitch and depth, and align them.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7048","via":"47-2051.00","match":"native","w":0.3}],"n_sources":1,"weight":0.3,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2051.00#3","text":"Spread, level, and smooth concrete, using rake, shovel, hand or power trowel, hand or power screed, and float.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7049","via":"47-2051.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2051.00#4","text":"Monitor how the wind, heat, or cold affect the curing of the concrete throughout the entire process.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7051","via":"47-2051.00","match":"native","w":0.15}],"n_sources":1,"weight":0.15,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2051.00#5","text":"Mold expansion joints and edges, using edging tools, jointers, and straightedge.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7050","via":"47-2051.00","match":"native","w":0.35}],"n_sources":1,"weight":0.35,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2051.00#6","text":"Signal truck driver to position truck to facilitate pouring concrete, and move chute to direct concrete on forms.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7052","via":"47-2051.00","match":"native","w":0.15}],"n_sources":1,"weight":0.15,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2051.00#7","text":"Direct the casting of the concrete and supervise laborers who use shovels or special tools to spread it.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7055","via":"47-2051.00","match":"native","w":0.15}],"n_sources":1,"weight":0.15,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"47-2051.00#8","text":"Produce rough concrete surface, using broom.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7053","via":"47-2051.00","match":"native","w":0.15}],"n_sources":1,"weight":0.15,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2051.00#9","text":"Apply hardening and sealing compounds to cure surface of concrete, and waterproof or restore surface.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7061","via":"47-2051.00","match":"native","w":0.15},{"source":"oasis","ref":"73100.00","via":"73100","match":"statcan_concordance","w":1}],"n_sources":2,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2051.00#10","text":"Operate power vibrator to compact concrete.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7054","via":"47-2051.00","match":"native","w":0.1},{"source":"oasis","ref":"73100.00","via":"73100","match":"statcan_concordance","w":1}],"n_sources":2,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"47-2051.00#11","text":"Install anchor bolts, steel plates, door sills and other fixtures in freshly poured concrete or pattern or stamp the surface to provide a decorative finish.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7069","via":"47-2051.00","match":"native","w":0.1},{"source":"oasis","ref":"73100.00","via":"73100","match":"statcan_concordance","w":1}],"n_sources":2,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2051.00#12","text":"Wet surface to prepare for bonding, fill holes and cracks with grout or slurry, and smooth, using trowel.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7059","via":"47-2051.00","match":"native","w":0.15}],"n_sources":1,"weight":0.15,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2051.00#13","text":"Waterproof or restore concrete surfaces, using appropriate compounds.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7068","via":"47-2051.00","match":"native","w":0.05}],"n_sources":1,"weight":0.05,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"47-2051.00#14","text":"Mix cement, sand, and water to produce concrete, grout, or slurry, using hoe, trowel, tamper, scraper, or concrete-mixing machine.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7056","via":"47-2051.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"47-2051.00#15","text":"Chip, scrape, and grind high spots, ridges, and rough projections to finish concrete, using pneumatic chisels, power grinders, or hand tools.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7062","via":"47-2051.00","match":"native","w":0.15}],"n_sources":1,"weight":0.15,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2051.00#16","text":"Cut out damaged areas, drill holes for reinforcing rods, and position reinforcing rods to repair concrete, using power saw and drill.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7057","via":"47-2051.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2051.00#17","text":"Wet concrete surface, and rub with stone to smooth surface and obtain specified finish.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7058","via":"47-2051.00","match":"native","w":0.05}],"n_sources":1,"weight":0.05,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"47-2051.00#18","text":"Clean chipped area, using wire brush, and feel and observe surface to determine if it is rough or uneven.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7060","via":"47-2051.00","match":"native","w":0.05}],"n_sources":1,"weight":0.05,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2051.00#19","text":"Build wooden molds, and clamp molds around area to be repaired, using hand tools.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7064","via":"47-2051.00","match":"native","w":0.05}],"n_sources":1,"weight":0.05,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"47-2051.00#20","text":"Sprinkle colored marble or stone chips, powdered steel, or coloring powder over surface to produce prescribed finish.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7065","via":"47-2051.00","match":"native","w":0.004}],"n_sources":1,"weight":0.004,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2051.00#21","text":"Fabricate concrete beams, columns, and panels.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7067","via":"47-2051.00","match":"native","w":0.05}],"n_sources":1,"weight":0.05,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2051.00#22","text":"Polish surface, using polishing or surfacing machine.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7072","via":"47-2051.00","match":"native","w":0.05}],"n_sources":1,"weight":0.05,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2051.00#23","text":"Cut metal division strips, and press them into terrazzo base so that top edges form desired design or pattern.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7066","via":"47-2051.00","match":"native","w":0.004}],"n_sources":1,"weight":0.004,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2051.00#24","text":"Push roller over surface to embed chips in surface.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7071","via":"47-2051.00","match":"native","w":0.004}],"n_sources":1,"weight":0.004,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2051.00#25","text":"Apply muriatic acid to clean surface, and rinse with water.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7070","via":"47-2051.00","match":"native","w":0.004}],"n_sources":1,"weight":0.004,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2051.00#26","text":"Spread roofing paper on surface of foundation, and spread concrete onto roofing paper with trowel to form terrazzo base.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7063","via":"47-2051.00","match":"native","w":0.004}],"n_sources":1,"weight":0.004,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"47-2051.00#27","text":"prevent damage to utility infrastructure","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/63395522-32f0-46c4-851d-69c2d3800a8a","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/63395522-32f0-46c4-851d-69c2d3800a8a","via":"http://data.europa.eu/esco/occupation/a9068f84-cecd-4cbb-9acb-e20c714435ec","match":"exactMatch","essential":true,"w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"47-2051.00#28","text":"place concrete forms","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/aa95f606-13ec-4242-a6bc-635a1aaa841c","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/aa95f606-13ec-4242-a6bc-635a1aaa841c","via":"http://data.europa.eu/esco/occupation/a9068f84-cecd-4cbb-9acb-e20c714435ec","match":"exactMatch","essential":true,"w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"47-2051.00#29","text":"mix concrete","kind":"skill","esco_uri":"http://data.europa.eu/es