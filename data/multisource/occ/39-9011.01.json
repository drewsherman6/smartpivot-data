enetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-9011.01#5","text":"Regulate children's rest periods and nap schedules.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2352","via":"39-9011.01","match":"native","w":0.214}],"n_sources":1,"weight":0.214,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-9011.01#6","text":"Teach and perform age-appropriate activities, such as lap play, reading, and arts and crafts, to encourage intellectual development of children.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2367","via":"39-9011.01","match":"native","w":0.857}],"n_sources":1,"weight":0.857,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-9011.01#7","text":"Help prepare and serve nutritionally balanced meals and snacks for children.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2354","via":"39-9011.01","match":"native","w":0.714}],"n_sources":1,"weight":0.714,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"39-9011.01#8","text":"Model appropriate social behaviors and encourage concern for others to cultivate development of interpersonal relationships and communication skills.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2358","via":"39-9011.01","match":"native","w":0.357}],"n_sources":1,"weight":0.357,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-9011.01#9","text":"Organize and conduct age-appropriate recreational activities, such as games, arts and crafts, sports, walks, and play dates.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2356","via":"39-90