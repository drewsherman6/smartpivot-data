 persons, stolen property, vehicle registration, and stolen vehicles.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2708","via":"55-3015.00","match":"native","w":0.357}],"n_sources":1,"weight":0.357,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3015.00#11","text":"Scan status charts and computer screens, and contact emergency response field units to determine emergency units available for dispatch.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2709","via":"55-3015.00","match":"native","w":0.286}],"n_sources":1,"weight":0.286,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3015.00#12","text":"Answer routine inquiries, and refer calls not requiring dispatches to appropriate departments and agencies.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2718","via":"55-3015.00","match":"native","w":0.286}],"n_sources":1,"weight":0.286,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3015.00#13","text":"Learn material and pass required tests for certification.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2716","via":"55-3015.00","match":"native","w":0.214}],"n_sources":1,"weight":0.214,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3015.00#14","text":"Observe alarm registers and scan maps to determine whether a specific emergency is in the dispatch service area.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2713","via":"55-3015.00","match":"native","w":0.072}],"n_sources":1,"weight":0.072,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3015.00#15","text":"Maintain files of information relating to emergency calls, such as personnel rosters and emergency call-out and pager files.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2714","via":"55-3015.00","match":"native","w":0.072}],"n_sources":1,"weight":0.072,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3015.00#16","text":"Test and adjust communication and alarm systems, and report malfunctions to maintenance units.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2721","via":"55-3015.00","match":"native","w":0.072}],"n_sources":1,"weight":0.072,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3015.00#17","text":"Operate and maintain mobile dispatch vehicles and equipment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2722","via":"55-3015.00","match":"native","w":0.006}],"n_sources":1,"weight":0.006,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3015.00#18","text":"Monitor alarm systems to detect emergencies, such as fires and illegal entry into establishments.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2720","via":"55-3015.00","match":"native","w":0.072}],"n_sources":1,"weight":0.072,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3015.00#19","text":"Respond to emergency calls and complaints, execute search warrants and arrest criminal suspects","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3015.00#20","text":"Patrol assigned areas on foot, horseback, bicycle and motorized vehicles to maintain public safety and order and to enforce laws and regulations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3015.00#21","text":"Prepare reports to record incidents and patrol activities and to provide testimony in courts of law","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3015.00#22","text":"Provide emergency assistance to victims of accidents, crimes and natural disasters","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3015.00#23","text":"Monitor traffic to ensure motorists observe traffic regulations and test persons suspected of driving under the influence of alcohol and drugs","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3015.00#24","text":"Control crowds at public events and protests and monitor suspicious and violent behaviour","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3015.00#25","text":"Participate in crime prevention, public information, safety and community relations programs","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3015.00#26","text":"Perform daily administrative tasks in support of law enforcement activities, such as maintaining equipment and information files","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3015.00#27","text":"May assist police investigators in criminal investigations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3015.00#28","text":"Certify ammunition, explosive items, munitions and non-munitions scrap to different degrees of classification","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42102.00","via":"42102","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3015.00#29","text":"Inspect, test, identify faults, adjust, repair, recondition and modify electrical, electromechanical, electronic, electro-optic and mechanical equipment, optical instruments, and control systems for weapons and missiles","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42102.00","via":"42102","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3015.00#30","text":"Maintain and repair machine-guns and non-guided anti-tank weapons, grenade projectors, mortars and launcher systems","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42102.00","via":"42102","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3015.00#31","text":"Test, inspect and repair air weapons systems","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42102.00","via":"42102","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3015.00#32","text":"Compile test logs, evaluation reports, equipment maintenance documentation and read and interpret electronic drawings","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42102.00","via":"42102","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3015.00#33","text":"Analyze equipment and system performance on all combat information equipment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3015.00#34","text":"Maintain and operate engineering equipment, including weapons, vehicles, heavy equipment and supplies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"transferred","from":"Operate and maintain mobile dispatch vehicles and equipment.","similarity":0.4},"robotics":{"tier":"E0","score":0,"basis":"transferred","from":"Operate and maintain mobile dispatch vehicles and equipment.","similarity":0.4}},{"id":"55-3015.00#35","text":"Inspect motors in operation, road test motor vehicles, and test automotive systems and components using computerized diagnostic and other testing devices to diagnose and isolate faults","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3015.00#36","text":"Configure and operate intelligence, surveillance and recognizance systems","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3015.00#37","text":"Oversee the construction of tools and devices to enable infantry soldiers to cross natural and man-made obstacles and break through enemy defenses","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3015.00#38","text":"Operate weapons and missile related equipment for defense.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3015.00#39","text":"Provide assistance in emergency situations, such as civil disorder, natural disasters and major accidents","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3015.00#40","text":"Operate armoured vehicles, artillery, hand-held weapons and other military combat equipment and defense systems","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3015.00#41","text":"Engage in non-combat operations for humanitarian efforts","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3015.00#42","text":"Participate in drills and other training in preparation for peacekeeping, combat and natural disaster relief","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3015.00#43","text":"Maintain weapon systems, vehicles, survival gear and personal defensive equipment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3015.00#44","text":"Perform underwa