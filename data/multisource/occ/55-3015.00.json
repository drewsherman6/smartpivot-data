0.5,"weight_other_measures":0.5}}},"statements":[{"id":"55-3015.00#1","text":"Provide emergency medical instructions to callers.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2719","via":"55-3015.00","match":"native","w":0.214}],"n_sources":1,"weight":0.214,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3015.00#2","text":"Question callers to determine their locations and the nature of their problems to determine type of response needed.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2707","via":"55-3015.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3015.00#3","text":"Determine response requirements and relative priorities of situations, and dispatch units in accordance with established procedures.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2705","via":"55-3015.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3015.00#4","text":"Receive incoming telephone or alarm system calls regarding emergency and non-emergency police and fire service, emergency ambulance service, information, and after-hours calls for departments within a city.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"2711","via":"55-3015.00","match":"native","w":0.714}],"n_sources":1,"weight":0.714,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-3015.00#5","text":"Relay information and messages to and from emergency sites, to law enforcement agencies, and to all other individuals or groups requiring notification.","kind":"task","esco_uri":null,"sources":[{"source":"onet"