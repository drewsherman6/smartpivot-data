tion":null,"ilo_2025":0.14,"basis":"direct"},"robotics":null},{"id":"31-9097.00#59","text":"Preparing patients for examination or treatment","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"5329-4","via":"5329","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.184,"anthropic_penetration":null,"ilo_2025":0.145,"basis":"direct"},"robotics":null},{"id":"31-9097.00#60","text":"Setting  up instrument trays, preparing materials, and assisting dentists or radiographers during procedures","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"5329-5","via":"5329","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.134,"anthropic_penetration":null,"ilo_2025":0.135,"basis":"direct"},"robotics":null},{"id":"31-9097.00#61","text":"Exposing diagnostic X-rays.","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"5329-6","via":"5329","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.184,"anthropic_penetration":null,"ilo_2025":0.145,"basis":"direct"},"robotics":null},{"id":"31-9097.00#62","text":"Conduct patient interviews, physical assessments and take medical histories","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.01","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#63","text":"Perform or order diagnostic tests and interpret results","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.01","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#64","text":"In consultation with a supervising physician, formulate and implement treatment plans and monitor patients' progress","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.01","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#65","text":"Perform and assist in minor surgery","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.01","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#66","text":"Provide health maintenance education","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.01","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#67","text":"May participate in research activities","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.01","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#68","text":"May prescribe from a limited list of medications.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.01","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#69","text":"Provide primary, full-course, care to women and their babies during pregnancy, such as physical examinations, screening and diagnostic tests to monitor the health of mother and baby and make referrals to medical specialists as required","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.02","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#70","text":"Manage labour and spontaneous normal deliveries","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.02","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#71","text":"Care for, assess and monitor the health of newborns and refer infants to appropriate medical services as required","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.02","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#72","text":"Provide advice and guidance regarding care for newborns and young infants.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.02","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#73","text":"Provide information and support to families affected by or at risk of a genetic disorder","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.03","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#74","text":"Gather and analyze family history and inheritance patterns, calculate risks of recurrence, and provide information about genetic testing and related procedures","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.03","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#75","text":"Develop, implement or coordinate action plans and refer individuals and families to other health professionals","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.03","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#76","text":"Design and conduct genetics training programs for other healthcare professionals or the general public","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.03","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#77","text":"May conduct research in the field of medical genetics and genetic counselling.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.03","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#78","text":"Work alongside ophthalmologists to diagnose and treat eye disorders by performing specialized eye tests to measure and assess defective binocular vision or abnormal eye movement in patients","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.04","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#79","text":"Prescribe treatment such as eye exercises or patching regimens.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.04","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#80","text":"Prepare for autopsies by obtaining patients' medical records and arranging for radiographic examinations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.05","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#81","text":"Prepare, assist with or perform autopsies and surgical specimen examinations under pathologists' supervision","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.05","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#82","text":"Assist with preparation of provisional autopsy report","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.05","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#83","text":"Dissect, examine, weigh, photograph and X-ray organs and specimens, collect tissue samples for chemical analysis and record findings","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.05","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#84","text":"Discard specimens according to established safety procedures","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.05","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#85","text":"Clean and maintain instruments, equipment and supplies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.05","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#86","text":"Develop and maintain processes for laboratory quality control","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.05","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#87","text":"May prepare bodies for release to funeral homes following completion of autopsies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.05","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#88","text":"May supervise and train junior resident pathologists and morgue attendants.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31303.05","via":"31303","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#89","text":"Set up, operate and maintain laboratory equipment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32120.00","via":"32120","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"31-9097.00#90","text":"Conduct and interpret chemical analyses of blood, urine, and cerebrospinal and other body fluids","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32120.00","via":"32120","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics