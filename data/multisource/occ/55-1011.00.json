ics":null},{"id":"55-1011.00#35","text":"Plan, organize and command units engaged in non-military disaster relief,  humanitarian and peacekeeping operations at the national and international level","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"40042.00","via":"40042","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"55-1011.00#36","text":"Set objectives of the organization in accordance with legislation and government policy, formulate or approve and evaluate programs and procedures, alone or in collaboration with senior government committees","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"40042.00","via":"40042","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"55-1011.00#37","text":"Coordinate the work of various military strategic units employing appropriate levels of military force for specific tasks","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"40042.00","via":"40042","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"55-1011.00#38","text":"Develop and implement military procedures and policies that are geared to the capabilities and performance of each unit.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"40042.00","via":"40042","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null}]}