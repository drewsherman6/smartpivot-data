nstrumentation to guide flights when visibility is poor.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10562","via":"55-1011.00","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"55-1011.00#2","text":"Start engines, operate controls, and pilot airplanes to transport passengers, mail, or freight, adhering to flight plans, regulations, and procedures.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10568","via":"55-1011.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#3","text":"Work as part of a flight team with other crew members, especially during takeoffs and landings.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10564","via":"55-1011.00","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"55-1011.00#4","text":"Respond to and report in-flight emergencies and malfunctions.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10563","via":"55-1011.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#5","text":"Inspect aircraft for defects and malfunctions, according to pre-flight checklists.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10569","via":"55-1011.00","match":"native","w":0.4}],"n_sources":1,"weight":0.4,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#6","text":"Contact control towers for takeoff clearances, arrival instructions, and other information, using radio equipment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10565","via":"55-1011.00","match":"native","w":0.3}],"n_sources":1,"weight":0.3,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#7","text":"Monitor engine operation, fuel consumption, and functioning of aircraft systems during flights.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10571","via":"55-1011.00","match":"native","w":0.3}],"n_sources":1,"weight":0.3,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#8","text":"Monitor gauges, warning devices, and control panels to verify aircraft performance and to regulate engine speed.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10567","via":"55-1011.00","match":"native","w":0.3}],"n_sources":1,"weight":0.3,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"55-1011.00#9","text":"Steer aircraft along planned routes, using autopilot and flight management computers.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10566","via":"55-1011.00","match":"native","w":0.6}],"n_sources":1,"weight":0.6,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"55-1011.00#10","text":"Check passenger and cargo distributions and fuel amounts to ensure that weight and balance specifications are met.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10570","via":"55-1011.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#11","text":"Confer with flight dispatchers and weather forecasters to keep abreast of flight conditions.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10572","via":"55-1011.00","match":"native","w":0.3}],"n_sources":1,"weight":0.3,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#12","text":"Order changes in fuel supplies, loads, routes, or schedules to ensure safety of flights.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10574","via":"55-1011.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#13","text":"Brief crews about flight details, such as destinations, duties, and responsibilities.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10577","via":"55-1011.00","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#14","text":"Choose routes, altitudes, and speeds that will provide the fastest, safest, and smoothest flights.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10575","via":"55-1011.00","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#15","text":"Direct activities of aircraft crews during flights.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10576","via":"55-1011.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#16","text":"Record in log books information, such as flight times, distances flown, and fuel consumption.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10578","via":"55-1011.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#17","text":"Instruct other pilots and student pilots in aircraft operations and the principles of flight.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10582","via":"55-1011.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#18","text":"Make announcements regarding flights, using public address systems.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10579","via":"55-1011.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#19","text":"Coordinate flight activities with ground crews and air traffic control and inform crew members of flight and test procedures.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10573","via":"55-1011.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#20","text":"Conduct in-flight tests and evaluations at specified altitudes and in all types of weather to determine the receptivity and other characteristics of equipment and systems.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10583","via":"55-1011.00","match":"native","w":0.005}],"n_sources":1,"weight":0.005,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#21","text":"File instrument flight plans with air traffic control to ensure that flights are coordinated with other air traffic.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10580","via":"55-1011.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#22","text":"Perform minor maintenance work, or arrange for major maintenance.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10581","via":"55-1011.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"55-1011.00#23","text":"Evaluate other pilots or pilot-license applicants for proficiency.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10584","via":"55-1011.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#24","text":"Plan and formulate flight activities and test schedules and prepare flight evaluation reports.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10586","via":"55-1011.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#25","text":"Plan, organize, direct, control and evaluate the purchasing activities of an establishment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"10012.00","via":"10012","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"55-1011.00#26","text":"Develop purchasing policies and procedures and control purchasing department budget","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"10012.00","via":"10012","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"55-1011.00#27","text":"Identify vendors of materials, equipment or supplies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"10012.00","via":"10012","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"55-1011.00#28","text":"Evaluate cost and quality of goods or services","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"10012.00","via":"10012","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"55-1011.00#29","text":"Negotiate or oversee the negotiation of purchase contracts","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"10012.00","via":"10012","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"55-1011.00#30","text":"Participate in the development of specifications for equipment, products or substitute materials","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"10012.00","via":"10012","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"55-1011.00#31","text":"Review and process claims against suppliers","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"10012.00","via":"10012","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"55-1011.00#32","text":"Interview, hire and oversee training of staff.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"10012.00","via":"10012","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"55-1011.00#33","text":"Allocate material, human and financial resources to implement military policies and programs, establish administrative controls, and approve overall personnel planning","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"40042.00","via":"40042","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"55-1011.00#34","text":"Plan, organize and command the activities of the Canadian Armed Forces combat units and military strategic units in the Army, Royal Canadian Air Force, and Royal Canadian Navy at home and when deployed overseas during operations in conflict territory","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"40042.00","via":"40042","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"55-1011.00#35","text":"Plan, organize and command units engaged in non-military disaster relief,  humanitarian and peacekeeping operations at the national and international level","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"40042.00","via":"40042","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"55-1011.00#36","text":"Set objectives of the organization in accordance with legislation and government policy, formulate or approve and evaluate programs and procedures, alone or in collaboration with senior government committees","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"40042.00","via":"40042","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"55-1011.00#37","text":"Coordinate the work of various military strategic units employing appropriate levels of military force for specific tasks","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"40042.00","via":"40042","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"55-1011.00#38","text":"Develop and implement military procedures and policies that are geared to the capabilities and performance of each unit.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"40042.00","via":"40042","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null}]}