"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#13","text":"Brief crews about flight details, such as destinations, duties, and responsibilities.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10577","via":"55-1011.00","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#14","text":"Choose routes, altitudes, and speeds that will provide the fastest, safest, and smoothest flights.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10575","via":"55-1011.00","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#15","text":"Direct activities of aircraft crews during flights.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10576","via":"55-1011.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#16","text":"Record in log books information, such as flight times, distances flown, and fuel consumption.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10578","via":"55-1011.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#17","text":"Instruct other pilots and student pilots in aircraft operations and the principles of flight.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10582","via":"55-1011.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#18","text":"Make announcements regarding flights, using public address systems.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10579","via":"55-1011.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#19","text":"Coordinate flight activities with ground crews and air traffic control and inform crew members of flight and test procedures.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10573","via":"55-1011.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#20","text":"Conduct in-flight tests and evaluations at specified altitudes and in all types of weather to determine the receptivity and other characteristics of equipment and systems.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10583","via":"55-1011.00","match":"native","w":0.005}],"n_sources":1,"weight":0.005,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#21","text":"File instrument flight plans with air traffic control to ensure that flights are coordinated with other air traffic.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10580","via":"55-1011.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"55-1011.00#22","text":"Perform minor maintenance work, or arrange for major maintenance.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10581","via":"55-1011.00","match":"native","w":0.1}],"n_sources":1,"weig