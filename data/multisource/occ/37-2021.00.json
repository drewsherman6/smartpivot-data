ative","w":0.318}],"n_sources":1,"weight":0.318,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"37-2021.00#6","text":"Inspect premises to identify infestation source and extent of damage to property, wall, or roof porosity and access to infested locations.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7975","via":"37-2021.00","match":"native","w":0.591}],"n_sources":1,"weight":0.591,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"37-2021.00#7","text":"Drive truck equipped with power spraying equipment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7979","via":"37-2021.00","match":"native","w":0.682}],"n_sources":1,"weight":0.682,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E3","score":1,"basis":"direct"}},{"id":"37-2021.00#8","text":"Direct, or assist other workers in, treatment or extermination processes to eliminate or control rodents, insects, or weeds.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7978","via":"37-2021.00","match":"native","w":0.091}],"n_sources":1,"weight":0.091,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"37-2021.00#9","text":"Study preliminary reports or diagrams of infested area and determine treatment type required to eliminate and prevent recurrence of infestation.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7983","via":"37-2021.00","match":"native","w":0.091}],"n_sources":1,"weight":0.091,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"37-2021.00#10","text":"Cut or bore openings in building or surrounding concrete, access infested areas, insert nozzle, and inject pestici