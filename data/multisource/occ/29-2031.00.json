er":"E0","score":0,"basis":"direct"}},{"id":"29-2031.00#4","text":"Obtain and record patient identification, medical history, or test results.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4134","via":"29-2031.00","match":"native","w":0.375}],"n_sources":1,"weight":0.375,"ai":{"pct":0.989,"anthropic_penetration":1,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-2031.00#5","text":"Monitor patients' comfort and safety during tests, alerting physicians to abnormalities or changes in patient responses.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4128","via":"29-2031.00","match":"native","w":0.25}],"n_sources":1,"weight":0.25,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-2031.00#6","text":"Prepare and position patients for testing.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4133","via":"29-2031.00","match":"native","w":0.25}],"n_sources":1,"weight":0.25,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-2031.00#7","text":"Attach electrodes to the patients' chests, arms, and legs, connect electrodes to leads from the electrocardiogram (EKG) machine, and operate the EKG machine to obtain a reading.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4135","via":"29-2031.00","match":"native","w":0.313}],"n_sources":1,"weight":0.313,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-2031.00#8","text":"Adjust equipment and controls according to physicians' orders or established protocol.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4136","via":"29-2031.00","match":"native","w":0.125}],"n_sources":1,"weight":0.125,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"29-2031.00#9","text":"Check, test, and maintain cardiology equipment, making minor repairs when necessary, to ensure proper operation.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4137","via":"29-2031.00","match":"native","w":0.188}],"n_sources":1,"weight":0.188,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-2031.00#10","text":"Supervise or train other cardiology technologists or students.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4138","via":"29-2031.00","match":"native","w":0.125},{"source":"oasis","ref":"32103.03","via":"32103","match":"statcan_concordance","w":0.5},{"source":"oasis","ref":"32123.01","via":"32123","match":"statcan_concordance","w":0.5}],"n_sources":2,"weight":0.5,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-2031.00#11","text":"Compare measurements of heart wall thickness and chamber sizes to standard norms to identify abnormalities.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4144","via":"29-2031.00","match":"native","w":0.125}],"n_sources":1,"weight":0.125,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-2031.00#12","text":"Maintain a proper sterile field during surgical procedures.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"15235","via":"29-2031.00","match":"native","w":0.125}],"n_sources":1,"weight":0.125,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-2031.00#13","text":"Observe ultrasound display screen and listen to signals to record vascular information, such as blood pressure, limb volume changes, oxygen saturation, or cerebral circulation.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4142","via":"29-2031.00","match":"native","w":0.125}],"n_sources":1,"weight":0.125,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-2031.00#14","text":"Assist physicians in the diagnosis and treatment of cardiac or peripheral vascular treatments, such as implanting pacemakers or assisting with balloon angioplasties to treat blood vessel blockages.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"15236","via":"29-2031.00","match":"native","w":0.313}],"n_sources":1,"weight":0.313,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-2031.00#15","text":"Assess cardiac physiology and calculate valve areas from blood flow velocity measurements.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4143","via":"29-2031.00","match":"native","w":0.063}],"n_sources":1,"weight":0.063,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-2031.00#16","text":"Operate diagnostic imaging equipment to produce contrast enhanced radiographs of heart and cardiovascular system.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4140","via":"29-2031.00","match":"native","w":0.125}],"n_sources":1,"weight":0.125,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-2031.00#17","text":"Observe gauges, recorder, and video screens of data analysis system during imaging of cardiovascular system.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4131","via":"29-2031.00","match":"native","w":0.125}],"n_sources":1,"weight":0.125,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-2031.00#18","text":"Inject contrast medium into patients' blood vessels.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4141","via":"29-2031.00","match":"native","w":0.063}],"n_sources":1,"weight":0.063,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"29-2031.00#19","text":"Transcribe, type, and distribute reports of diagnostic procedures for interpretation by physician.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"15237","via":"29-2031.00","match":"native","w":0.125}],"n_sources":1,"weight":0.125,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-2031.00#20","text":"Set up 24-hour Holter and event monitors, scan and interpret tapes, and report results to physicians.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"15238","via":"29-2031.00","match":"native","w":0.125}],"n_sources":1,"weight":0.125,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-2031.00#21","text":"Perform general administrative tasks, such as scheduling appointments or ordering supplies or equipment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"15234","via":"29-2031.00","match":"native","w":0.188}],"n_sources":1,"weight":0.188,"ai":{"pct":0.914,"anthropic_penetration":0.724,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-2031.00#22","text":"apply context specific clinical competences","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/e18a6a3c-4f26-4141-8c72-4b4f01d77914","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/e18a6a3c-4f26-4141-8c72-4b4f01d77914","via":"http://data.europa.eu/esco/occupation/57a73b7c-cf10-4852