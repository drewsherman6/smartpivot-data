null,"sources":[{"source":"onet","ref":"21199","via":"33-3021.06","match":"native","w":0.643}],"n_sources":1,"weight":0.643,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-3021.06#6","text":"Prepare comprehensive written reports, presentations, maps, or charts, based on research, collection, and analysis of intelligence data.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17552","via":"33-3021.06","match":"native","w":0.857}],"n_sources":1,"weight":0.857,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-3021.06#7","text":"Collaborate with representatives from other government and intelligence organizations to share information or coordinate intelligence activities.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17556","via":"33-3021.06","match":"native","w":0.428}],"n_sources":1,"weight":0.428,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-3021.06#8","text":"Link or chart suspects to criminal organizations or events to determine activities and interrelationships.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17550","via":"33-3021.06","match":"native","w":0.357}],"n_sources":1,"weight":0.357,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-3021.06#9","text":"Establish criminal profiles to aid in connecting criminal organizations with their members.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17545","via":"33-3021.06","match":"native","w":0.143}],"n_sources":1,"weight":0.143,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-3021.06#10","text":"Identify gaps in information.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23997","via":"33-3021.06","match":"native","w":0.143}],"n_sources":1,"weight":0.143,"ai":null,"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-3021.06#11","text":"Design, use, or maintain databases and software applications, such as geographic information systems (GIS) mapping and artificial intelligence tools.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17544","via":"33-3021.06","match":"native","w":0.286}],"n_sources":1,"weight":0.286,"ai":{"pct":0.956,"anthropic_penetration":0.902,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-3021.06#12","text":"Predict future gang, organized crime, or terrorist activity, using analyses of intelligence data.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17542","via":"33-3021.06","match":"native","w":0.143}],"n_sources":1,"weight":0.143,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-3021.06#13","text":"Study activities relating to narcotics, money laundering, gangs, auto theft rings, terrorism, or other national security threats.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17543","via":"33-3021.06","match":"native","w":0.214}],"n_sources":1,"weight":0.214,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-3021.06#14","text":"Study the assets of criminal suspects to determine the flow of money from or to targeted groups.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17554","via":"33-3021.06","match":"native","w":0.143}],"n_sources":1,"weight":0.143,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"33-3021.06#15","text":"Conduct presentations of anal