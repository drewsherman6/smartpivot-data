s":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/415f816c-07ae-4ac1-9ddb-ecaa9957a249","via":"http://data.europa.eu/esco/occupation/4ca8ba6c-dc55-40c0-ae6c-d55c94dd2e03","match":"exactMatch","essential":false,"w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.06#48","text":"promote human rights","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/646d871b-4503-4dc8-a076-06d7085e4cde","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/646d871b-4503-4dc8-a076-06d7085e4cde","via":"http://data.europa.eu/esco/occupation/4ca8ba6c-dc55-40c0-ae6c-d55c94dd2e03","match":"exactMatch","essential":false,"w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.06#49","text":"Establishing contacts and sources of information about crimes planned or committed, in order to prevent crimes or identify suspected offenders","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3355-1","via":"3355","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.389,"anthropic_penetration":null,"ilo_2025":0.235,"basis":"direct"},"robotics":null},{"id":"33-3021.06#50","text":"Obtaining and verifying evidence by examining crime and accident scenes for clues and physical evidence, interviewing witnesses and suspects and analysing documents and computer files","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3355-2","via":"3355","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.453,"anthropic_penetration":null,"ilo_2025":0.26,"basis":"direct"},"robotics":null},{"id":"33-3021.06#51","text":"Analysing evidence in order to solve crimes, identify criminal activity and gather information for court cases","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3355-3","via":"3355","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.466,"anthropic_penetration":null,"ilo_2025":0.265,"basis":"direct"},"robotics":null},{"id":"33-3021.06#52","text":"Establishing contacts and sources of information not readily available or apparent concerning establishments or the circumstances and behaviour of persons, usually with the aim of preventing a crime","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3355-4","via":"3355","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.506,"anthropic_penetration":null,"ilo_2025":0.285,"basis":"direct"},"robotics":null},{"id":"33-3021.06#53","text":"Making arrests","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3355-5","via":"3355","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.054,"anthropic_penetration":null,"ilo_2025":0.1025,"basis":"direct"},"robotics":null},{"id":"33-3021.06#54","text":"Testifying in courts of law or reporting to superiors about circumstances and results of investigations.","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3355-6","via":"3355","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.424,"anthropic_penetration":null,"ilo_2025":0.25,"basis":"direct"},"robotics":null},{"id":"33-3021.06#55","text":"Interviews persons in connection with criminal incidents, including victims, witnesses and suspects","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.06#56","text":"Exchange information and coordinate activities with other law enforcements agencies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.06#57","text":"Prepare investigation reports and testify in courts concerning criminal investigations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":{"pct":0.424,"anthropic_penetration":null,"ilo_2025":0.25,"basis":"transferred","from":"Testifying in courts of law or reporting to superiors about circumstances and results of investigations.","similarity":0.364},"robotics":null},{"id":"33-3021.06#58","text":"Search and collect physical evidence from crimes scenes, such as fingerprints, and attend autopsies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.06#59","text":"Perform surveillance by using investigative technologies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.06#60","text":"Obtain search warrants, conduct searches and arrest suspects","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.06#61","text":"May conduct investigation on online networks and computer systems to detect cyber crimes or to recover data.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.06#62","text":"May supervise and coordinate the work of police officers.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.06#63","text":"Conduct death investigations to determine the identity of the deceased, date and location of death, medical cause of death, and manner of death","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.06#64","text":"Order or perform autopsies and other medical tests","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.06#65","text":"Consult with and request assistance from law enforcement, physicians, and family","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.06#66","text":"Issue death certificates, including assigning cause and manner of death","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.06#67","text":"Identify and educate the public on dangerous practices or conditions that may lead to death","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.06#68","text":"May testify or produce evidence in proceedings about observations made during investigations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.06#69","text":"May supervisor and coordinator work of other employees.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.06#70","text":"Respond to emergency calls and complaints, execute search warrants and arrest criminal suspects","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.06#71","text":"Patrol assigned areas on foot, horseback, bicycle and motorized vehicles to maintain public safety and order and to enforce laws and regulations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.06#72","text":"Prepare reports to record incidents and patrol activities and to provide testimony in courts of law","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.06#73","text":"Provide emergency assistance to victims of accidents, crimes and natural disasters","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.06#74","text":"Monitor traffic to ensure motorists observe traffic regulations and test persons suspected of driving under the influence of alcohol and drugs","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.06#75","text":"Control crowds at public events and protests and monitor suspicious and violent behaviour","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.06#76","text":"Participate in crime prevention, public information, safety and community relations programs","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.06#77","text":"Perform daily administrative tasks in support of law enforcement activities, such as maintaining equipment and information files","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"33-3021.06#78","text":"May assist police investigators in criminal investigations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"42100.00","via":"42100","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null}]}