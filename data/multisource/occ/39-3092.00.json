/b69cb255-e939-4928-b3fd-9557087dce52","via":"http://data.europa.eu/esco/occupation/2a6784d7-c457-413d-ba99-e320de11fc98","match":"broadMatch","essential":false,"w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"39-3092.00#65","text":"keep personal administration","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/9df34bc3-25d4-4452-a896-4d19b94ef896","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/9df34bc3-25d4-4452-a896-4d19b94ef896","via":"http://data.europa.eu/esco/occupation/2a6784d7-c457-413d-ba99-e320de11fc98","match":"broadMatch","essential":false,"w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"39-3092.00#66","text":"promote yourself","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/a04c2655-5996-4744-bca2-4f4c8b3e4667","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/a04c2655-5996-4744-bca2-4f4c8b3e4667","via":"http://data.europa.eu/esco/occupation/2a6784d7-c457-413d-ba99-e320de11fc98","match":"broadMatch","essential":false,"w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"39-3092.00#67","text":"develop professional network","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/bf5d77ad-e18c-48d8-83f0-bc79c011c74a","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/bf5d77ad-e18c-48d8-83f0-bc79c011c74a","via":"http://data.europa.eu/esco/occupation/2a6784d7-c457-413d-ba99-e320de11fc98","match":"broadMatch","essential":false,"w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"39-3092.00#68","text":"history of fashion","kind":"knowledge","esco_uri":"http://data.europa.eu/esco/skill/bf1b6671-e8f4-4633-932e-15236780037b","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/bf1b6671-e8f4-4633-932e-15236780037b","via":"http://data.europa.eu/esco/occupation/2a6784d7-c457-413d-ba99-e320de11fc98","match":"broadMatch","essential":false,"w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"39-3092.00#69","text":"work safely with chemicals","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/89d2bb53-67fc-4b9e-80c7-07b6c587bc0d","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/89d2bb53-67fc-4b9e-80c7-07b6c587bc0d","via":"http://data.europa.eu/esco/occupation/2a6784d7-c457-413d-ba99-e320de11fc98","match":"broadMatch","essential":false,"w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"39-3092.00#70","text":"Coordinate the work of camera operators and other technical staff, and cue announcers, actors and performers during news broadcasts and television program tapings.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"52119.01","via":"52119","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"39-3092.00#71","text":"Supervise grips, gaffers and stagehands who rig, place, move and dismantle lights, sets, backdrops, scenery and other stage equipment.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"52119.02","via":"52119","match":"statcan_concordance","w":0.5},{"source":"oasis","ref":"53111.05","via":"53111","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"39-3092.00#72","text":"Set up, operate and make repairs to lights and other electrical equipment in studios and on sets and stages.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"52119.03","via":"52119","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"39-3092.00#73","text":"Design and coordinate special effects such as fires, explosions and crashes.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"52119.04","via":"52119","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"39-3092.00#74","text":"Apply cosmetic and special effects make-up on actors and other performers.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"52119.05","via":"52119","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"39-3092.00#75","text":"Study scripts to determine the necessary costumes and oversee the acquisition, fitting and maintenance of costumes.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"52119.06","via":"52119","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"39-3092.00#76","text":"Assist in preparing the construction specifications for sets","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"52119.07","via":"52119","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"39-3092.00#77","text":"Identify and list the necessary props and place them during rehearsals and performances.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"52119.07","via":"52119","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"39-3092.00#78","text":"Set up, assemble, adjust, maintain and replace reels and projector equipment; detect and repair mechanical and electrical problems; and change and install an electronic control panel using automated equipment.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"53111.01","via":"53111","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"39-3092.00#79","text":"Check the condition of the copy; set up and load film reels on movie theatre projection systems, adjust focus, sound levels and other projector and theatre settings; and maintain projection equipment.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"53111.02","via":"53111","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"39-3092.00#80","text":"Assemble, repair, place, build and oversee props.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"53111.03","via":"53111","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"39-3092.00#81","text":"Distribute scripts to actors; keep detailed notes of all actions, positions and camera angles; and photograph and date scenes.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"53111.04","via":"53111","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"39-3092.00#82","text":"Clean, maintain, transport and store costumes, and assist performers to dress in costumes.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"53111.06","via":"53111","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"39-3092.00#83","text":"Provide support to the director and producer, and are responsible for various aspects of production such as preparing schedules, setting up equipment, and making travel arrangements to various shooting locations.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"53111.07","via":"53111","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null}]}