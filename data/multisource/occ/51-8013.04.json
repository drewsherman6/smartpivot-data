rect"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"51-8013.04#4","text":"Perform preventive or corrective containment or cleanup measures in hydroelectric plants to prevent environmental contamination.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17929","via":"51-8013.04","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-8013.04#5","text":"Inspect water-powered electric generators or auxiliary equipment in hydroelectric plants to verify proper operation or to determine maintenance or repair needs.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17916","via":"51-8013.04","match":"native","w":0.545}],"n_sources":1,"weight":0.545,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"51-8013.04#6","text":"Communicate status of hydroelectric operating equipment to dispatchers or supervisors.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17914","via":"51-8013.04","match":"native","w":0.273}],"n_sources":1,"weight":0.273,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-8013.04#7","text":"Operate high voltage switches or related devices in hydropower stations.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17920","via":"51-8013.04","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"51-8013.04#8","text":"Operate hydroelectric plant equipment, such as turbines, pumps, valves, gates, fans, electric control boards, or battery banks.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17921","via":"51-8013.04","match":"native","w":0.273}],"n_sources":1,"weight":0.273,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"51-8013.04#9","text":"Maintain or repair hydroelectric plant electrical, mechanical, or electronic equipment, such as motors, transformers, voltage regulators, generators, relays, battery systems, air compressors, sump pumps, gates, or valves.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17919","via":"51-8013.04","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-8013.04#10","text":"Implement load or switching orders in hydroelectric plants, in accordance with specifications or instructions.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17915","via":"51-8013.04","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"51-8013.04#11","text":"Install or calibrate electrical or mechanical equipment, such as motors, engines, switchboards, relays, switch gears, meters, pumps, hydraulics, or flood channels.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17917","via":"51-8013.04","match":"native","w":0.364}],"n_sources":1,"weight":0.364,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-8013.04#12","text":"Change oil, hydraulic fluid, or other lubricants to maintain condition of hydroelectric plant equipment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17924","via":"51-8013.04","match":"native","w":0.273}],"n_sources":1,"weight":0.273,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-8013.04#13","text":"Maintain logs, reports, work requests, or other records of work performed in hydroelectric plants.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17918","via":"51-8013.04","match":"native","w":0.455}],"n_sources":1,"weight":0.455,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-8013.04#14","text":"Connect metal parts or components in hydroelectric plants by welding, soldering, riveting, tapping, bolting, bonding, or screwing.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17925","via":"51-8013.04","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-8013.04#15","text":"Lift and move loads, using cranes, hoists, and rigging, to install or repair hydroelectric system equipment or infrastructure.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17928","via":"51-8013.04","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-8013.04#16","text":"Perform tunnel or field inspections of hydroelectric plant facilities or resources.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17930","via":"51-8013.04","match":"native","w":0.273}],"n_sources":1,"weight":0.273,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"51-8013.04#17","text":"Splice or terminate cables or electrical wiring in hydroelectric plants.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17931","via":"51-8013.04","match":"native","w":0.091}],"n_sources":1,"weight":0.091,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-8013.04#18","text":"Test and repair or replace electrical equipment, such as circuit breakers, station batteries, cable trays, conduits, or control devices.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17923","via":"51-8013.04","match":"native","w":0.364}],"n_sources":1,"weight":0.364,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-8013.04#19","text":"Take readings and record data, such as water levels, temperatures, or flow rates.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17922","via":"51-8013.04","match":"native","w":0.364}],"n_sources":1,"weight":0.364,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"51-8013.04#20","text":"Erect scaffolds, platforms, or hoisting frames to access hydroelectric plant machinery or infrastructure for repair or replacement.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17927","via":"51-8013.04","match":"native","w":0.091}],"n_sources":1,"weight":0.091,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-8013.04#21","text":"Cut, bend, or shape metal for applications in hydroelectric plants, using equipment such as hydraulic benders or pipe threaders.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17926","via":"51-8013.04","match":"native","w":0.091}],"n_sources":1,"weight":0.091,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-8013.0