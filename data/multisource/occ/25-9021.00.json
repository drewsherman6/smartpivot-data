"direct"},"robotics":null},{"id":"25-9021.00#26","text":"Investigating, planning and implementing management procedures to cope with the effects of fires, floods, droughts, soil erosion, pests and diseases","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2132-11","via":"2132","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.413,"anthropic_penetration":null,"ilo_2025":0.245,"basis":"direct"},"robotics":null},{"id":"25-9021.00#27","text":"Preparing scientific reports and conducting advisory information sessions and lectures for farming, forestry and fishing communities and other groups.","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2132-12","via":"2132","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.9,"anthropic_penetration":null,"ilo_2025":0.5375000000000001,"basis":"direct"},"robotics":null},{"id":"25-9021.00#28","text":"Provide counselling and advisory services to farmers on crop cultivation and fertilization, harvesting, animal and poultry care, disease prevention, farm management, farm financing, marketing and other agricultural subjects","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21112.00","via":"21112","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"25-9021.00#29","text":"Prepare and conduct advisory information sessions and lectures for farmers and other groups","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21112.00","via":"21112","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":{"pct":0.9,"anthropic_penetration":null,"ilo_2025":0.5375000000000001,"basis":"transferred","from":"Preparing scientific reports and conducting advisory information sessions and lectures for farming, forestry and fishing","similarity":0.4},"robotics":null},{"id":"25-9021.00#30","text":"Liaise with researchers, educators and government or business managers on matters pertaining to farming and agriculture","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21112.00","via":"21112","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"25-9021.00#31","text":"May operate unmanned aerial vehicle/drone to map drainage, plant seeds, analyze crop health and identify areas of stress and evenly spray fertilizers or pesticides.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21112.00","via":"21112","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"25-9021.00#32","text":"Develop social programs and policies, social legislation, or proposals based on demographic, social and economic research, analysis and the evaluation of pilot projects.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41403.01","via":"41403","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"25-9021.00#33","text":"Advise and assist consumers on the selection and proper use of food products, textiles and other consumer goods and teach household management skills. They may also provide consultative services in the areas of development and promotion of new food products, retail buying, social program administration and small business endeavours.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41403.02","via":"41403","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"25-9021.00#34","text":"Identify and assess economic, demographic, and social developments and report on their implications for housing policy.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41403.03","via":"41403","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"25-9021.00#35","text":"Conduct research, advise clients and prepare immigration, citizenship and visas applications. They may also represent clients at tribunals and before administrative bodies.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41403.04","via":"41403","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"25-9021.00#36","text":"Plan, organize and administer foreign aid and international development policies and programs.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41403.05","via":"41403","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"25-9021.00#37","text":"Develop questionnaires, coordinate and conduct surveys, analyse data, and compile and interpret statistics on social issues and policy areas.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41403.06","via":"41403","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"25-9021.00#38","text":"Conduct research, develop social programs, assess, coordinate and develop awareness of existing social services, and ensure that duplication of services is avoided. They may also work with land use planners to determine the impact of major land use plans for transportation, housing and recreational facilities projects.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41403.07","via":"41403","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null}]}