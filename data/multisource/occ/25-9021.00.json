ct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"25-9021.00#12","text":"Conduct agricultural research, analyze data, and prepare research reports.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10985","via":"25-9021.00","match":"native","w":0.273},{"source":"oasis","ref":"21112.00","via":"21112","match":"statcan_concordance","w":0.5}],"n_sources":2,"weight":0.5,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"25-9021.00#13","text":"Set and monitor production targets.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10988","via":"25-9021.00","match":"native","w":0.091}],"n_sources":1,"weight":0.091,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"25-9021.00#14","text":"Collaborate with social service and health care professionals to advise individuals and families on home management practices, such as budget planning, meal preparation, and time management.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10983","via":"25-9021.00","match":"native","w":0.363}],"n_sources":1,"weight":0.363,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"25-9021.00#15","text":"Provide direct assistance to farmers by performing activities such as purchasing or selling products and supplies, supervising properties, and collecting soil and herbage samples for testing.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"10987","via":"25-9021.00","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E3","score":1,"basis":"direct"}},{"id":"25-9021.00#16","text":"Collecting and analysing data and samples r