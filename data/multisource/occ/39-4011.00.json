c_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-4011.00#5","text":"Incise stomach and abdominal walls and probe internal organs, using trocar, to withdraw blood and waste matter from organs.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4489","via":"39-4011.00","match":"native","w":0.25}],"n_sources":1,"weight":0.25,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-4011.00#6","text":"Clean and disinfect areas in which bodies are prepared and embalmed.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"23930","via":"39-4011.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"39-4011.00#7","text":"Dress bodies and place them in caskets.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4493","via":"39-4011.00","match":"native","w":0.5}],"n_sources":1,"weight":0.5,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-4011.00#8","text":"Make incisions in arms or thighs and drain blood from circulatory system and replace it with embalming fluid, using pump.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4492","via":"39-4011.00","match":"native","w":0.583}],"n_sources":1,"weight":0.583,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-4011.00#9","text":"Remove the deceased from place of death and transport to funeral home.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"20257","via":"39-4011.00","match":"native","w":0.667}],"n_sources":1,"weight":0.667,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-4011.00#10","text":"Perform the duties of funeral directors, including coordinating funeral activities.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4494","via":"39-4011.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-4011.00#11","text":"Attach trocar to pump-tube, start pump, and repeat probing to force embalming fluid into organs.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4497","via":"39-4011.00","match":"native","w":0.167}],"n_sources":1,"weight":0.167,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-4011.00#12","text":"Reshape or reconstruct disfigured or maimed bodies when necessary, using dermasurgery techniques and materials such as clay, cotton, plaster of Paris, and wax.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4491","via":"39-4011.00","match":"native","w":0.167}],"n_sources":1,"weight":0.167,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-4011.00#13","text":"Pack body orifices with cotton saturated with embalming fluid to prevent escape of gases or waste matter.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4504","via":"39-4011.00","match":"native","w":0.083}],"n_sources":1,"weight":0.083,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-4011.00#14","text":"Conduct interviews to arrange for the preparation of obituary notices, to assist with the selection of caskets or urns, and to determine the location and time of burials or cremations.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4496","via":"39-4011.00","match":"native","w":0.333},{"source":"ilo","ref":"5163-6","via":"5163","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":2,"weight":1,"ai":{"pct":0.403,"anthropic_penetration":0,"ilo_2025":0.4425,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-4011.00#15","text":"Insert convex celluloid or cotton between eyeballs and eyelids to prevent slipping and sinking of eyelids.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4500","via":"39-4011.00","match":"native","w":0.083}],"n_sources":1,"weight":0.083,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-4011.00#16","text":"Assist with placing caskets in hearses and organize cemetery processions.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4505","via":"39-4011.00","match":"native","w":0.25}],"n_sources":1,"weight":0.25,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"39-4011.00#17","text":"Maintain records, such as itemized lists of clothing or valuables delivered with body and names of persons embalmed.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4499","via":"39-4011.00","match":"native","w":0.25}],"n_sources":1,"weight":0.25,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-4011.00#18","text":"Wash and dry bodies, using germicidal soap and towels or hot air dryers.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4501","via":"39-4011.00","match":"native","w":0.25}],"n_sources":1,"weight":0.25,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-4011.00#19","text":"Arrange for transporting the deceased to another state for interment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4502","via":"39-4011.00","match":"native","w":0.083}],"n_sources":1,"weight":0.083,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-4011.00#20","text":"Perform special procedures necessary for remains that are to be transported to other states or overseas, or where death was caused by infectious disease.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4498","via":"39-4011.00","match":"native","w":0.083}],"n_sources":1,"weight":0.083,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-4011.00#21","text":"Supervise funeral attendants and other funeral home staff.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4503","via":"39-4011.00","match":"native","w":0.167},{"source":"oasis","ref":"62201.01","via":"62201","match":"statcan_concordance","w":1},{"source":"oasis","ref":"62201.02","via":"62201","match":"statcan_concordance","w":1}],"n_sources":2,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-4011.00#22","text":"Serve as pallbearers, attend visiting rooms, and provide other assistance to the bereaved.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4506","via":"39-4011.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-4011.00#23","text":"Direct casket and floral display placement and arrange guest seating.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4507","via":"39-4011.00","match":"native","w":0.167}],"n_sources":1,"weight":0.167,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"39-4011.00#24","text":"Arrange funeral home equipment and perform general maintenance.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4508","via":"39-4011.00","match":"native","w":0.25}],"n_sources":1,"weight":0.25,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"39-4011.00#25","text":"Assist coroners at death scenes or at autopsies, file police reports, and testify at inquests or in court, if employed by a coroner.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4509","via":"39-4011.00","match":"native","w":0.007}],"n_sources":1,"weight":0.007,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-4011.00#26","text":"Press diaphragm to evacuate air from lungs.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4510","via":"39-4011.00","match":"native","w":0.007}],"n_sources":1,"weight":0.007,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"39-4011.00#27","text":"embalm bodies","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/43429ca9-c787-49dc-a082-8baae817fd2d","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/43429ca9-c787-49dc-a082-8baae817fd2d","via":"http://data.europa.eu/esco/occupation/dc34c345-caf9-4ab7-b496-e18a572194ba","match":"exactMatch","essential":true,"w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"39-4011.00#28","text":"apply health and safety standards","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/dcc96a49-0bac-4a9c-8f8e-a32b4e47e6eb","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/dcc96a49-0bac-4a9c-8f8e-a32b4e47e6eb","via":"http://data.europa.eu/esco/oc