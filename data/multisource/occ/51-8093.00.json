y_osborne":{"label":"Frey & Osborne (2013) probability of computerisation (supporting, half weight)","weight":0.5,"share_of_other_measures":0.167,"score":0.583,"measures":[{"id":"frey_osborne_rob","label":"Frey-Osborne probability of computerisation (SOC 2010 via BLS 2010-2018)","raw":0.71,"pct":0.583}]}},"agreement":{"families":4,"sd":0.059,"range":0.168,"label":"sources agree"},"headline":{"value":0.262,"time_weighted_tasks":0.256,"other_measures_pct":0.834,"other_measures_linked":0.268,"weight_time_weighted":0.5,"weight_other_measures":0.5}}},"statements":[{"id":"51-8093.00#1","text":"Signal other workers by telephone or radio to operate pumps, open and close valves, and check temperatures.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14309","via":"51-8093.00","match":"native","w":0.308}],"n_sources":1,"weight":0.308,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-8093.00#2","text":"Maintain and repair equipment, or report malfunctioning equipment to supervisors so that repairs can be scheduled.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14318","via":"51-8093.00","match":"native","w":0.385}],"n_sources":1,"weight":0.385,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-8093.00#3","text":"Monitor process indicators, instruments, gauges, and meters to detect and report any possible problems.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14305","via":"51-8093.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"51-8093.00#4","text":"Start pumps and open valves or use automated equipment to regulate the flow of oil in pipelines and into and out of tanks.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14306","via":"51-8093.00","match":"native","w":0.385}],"n_sources":1,"weight":0.385,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"51-8093.00#5","text":"Operate control panels to coordinate and regulate process variables such as temperature and pressure, and to direct product flow rate, according to process schedules.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14308","via":"51-8093.00","match":"native","w":0.846}],"n_sources":1,"weight":0.846,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-8093.00#6","text":"Verify that incoming and outgoing products are moving through the correct meters, and that meters are working properly.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14310","via":"51-8093.00","match":"native","w":0.154}],"n_sources":1,"weight":0.154,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-8093.00#7","text":"Patrol units to monitor the amount of oil in storage tanks, and to verify that activities and operations are safe, efficient, and in compliance with regulations.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14317","via":"51-8093.00","match":"native","w":0.539}],"n_sources":1,"weight":0.539,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"51-8093.00#8","text":"Plan movement of products through lines to processing, storage, and shipping units, using knowledge of system interconnections and capacities.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14313","via":"51-8093.00","match":"native","w":0.231}],"n_sources":1,"weight":0.231,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-8093.00#9","text":"Control or operate manifold and pumping systems to circulate liquids through a petroleum refinery.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14307","via":"51-8093.00","match":"native","w":0.308}],"n_sources":1,"weight":0.308,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-8093.00#10","text":"Operate auxiliary equipment and control multiple processing units during distilling or treating operations, moving controls that regulate valves, pumps, compressors, and auxiliary equipment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14312","via":"51-8093.00","match":"native","w":0.308}],"n_sources":1,"weight":0.308,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-8093.00#11","text":"Collect product samples by turning bleeder valves, or by lowering containers into tanks to obtain oil samples.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14319","via":"51-8093.00","match":"native","w":0.231}],"n_sources":1,"weight":0.231,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-8093.00#12","text":"Read automatic gauges at specified intervals to determine the flow rate of oil into or from tanks, and the amount of oil in tanks.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14311","via":"51-8093.00","match":"native","w":0.231}],"n_sources":1,"weight":0.231,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"51-8093.00#13","text":"Synchronize activities with other pumphouses to ensure a continuous flow of products and a minimum of contamination between products.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14316","via":"51-8093.00","match":"native","w":0.077}],"n_sources":1,"weight":0.077,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-8093.00#14","text":"Record and compile operating data, instrument readings, documentation, and results of laboratory analyses.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14315","via":"51-8093.00","match":"native","w":0.385}],"n_sources":1,"weight":0.385,"ai":{"pct":0.989,"anthropic_penetration":1,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-8093.00#15","text":"Conduct general housekeeping of units, including wiping up oil spills and performing general cleaning duties.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14321","via":"51-8093.00","match":"native","w":0.154}],"n_sources":1,"weight":0.154,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-8093.00#16","text":"Inspect pipelines, tightening connections and lubricating valves as necessary.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14320","via":"51-8093.00","match":"native","w":0.154}],"n_sources":1,"weight":0.154,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-8093.00#17","text":"Read and analyze specifications, schedules, logs, test results, and laboratory recommendations to determine how to set equipment controls to produce the required qualities and quantities of products.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14314","via":"51-8093.00","match":"native","w":0.154}],"n_sources":1,"weight":0.154,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-8093.00#18","text":"Perform tests to check the qualities and grades of products, such as assessing levels of bottom sediment, water, and foreign materials in oil samples, using centrifugal testers.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14323","via":"51-8093.00","match":"native","w":0.154}],"n_sources":1,"weight":0.154,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-8093.00#19","text":"Calculate test result values, using standard formulas.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14328","via":"51-8093.00","match":"native","w":0.077}],"n_sources":1,"weight":0.077,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-8093.00#20","text":"Clean interiors of processing units by circulating chemicals and solvents within units.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14326","via":"51-8093.00","match":"native","w":0.077}],"n_sources":1,"weight":0.077,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-8093.00#21","text":"Clamp seals around valves to secure tanks.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14327","via":"51-8093.00","match":"native","w":0.077}],"n_sources":1,"weight":0.077,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-8093.00#22","text":"Coordinate shutdowns and major projects.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14322","via":"51-8093.00","match":"native","w":0.154}],"n_sources":1,"weig