5,"ai":null,"robotics":null},{"id":"33-9099.00#62","text":"Escort mourners and act as pallbearers","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.03","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.00#63","text":"Clean funeral parlours and chapels.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.03","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.00#64","text":"Replenish vending machines","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.04","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.00#65","text":"Provide change","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.04","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.00#66","text":"Explain operation of machines to customers","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.04","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.00#67","text":"Clean the laundromat and arrange for the repair of broken machines","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.04","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.00#68","text":"May wash, dry and fold laundry for customers","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.04","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.00#69","text":"May operate dry cleaning machines for customers.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.04","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.00#70","text":"Collect parking fees and issue ticket stubs","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.05","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.00#71","text":"Direct customers to parking spaces and park cars.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.05","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.00#72","text":"Collect admission tickets or passes from patrons at entertainment events and direct patrons to their seats.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.06","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.00#73","text":"Perform services specific to the establishments in which their occupations are found.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.07","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null}]}