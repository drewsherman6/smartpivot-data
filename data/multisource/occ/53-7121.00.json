alue":0.4,"time_weighted_tasks":0.421,"other_measures_pct":0.776,"other_measures_linked":0.212,"weight_time_weighted":0.9,"weight_other_measures":0.1}}},"statements":[{"id":"53-7121.00#1","text":"Seal outlet valves on tank cars, barges, and trucks.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"12800","via":"53-7121.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"53-7121.00#2","text":"Verify tank car, barge, or truck load numbers to ensure car placement accuracy based on written or verbal instructions.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"12792","via":"53-7121.00","match":"native","w":0.444}],"n_sources":1,"weight":0.444,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"53-7121.00#3","text":"Start pumps and adjust valves or cables to regulate the flow of products to vessels, using knowledge of loading procedures.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"12809","via":"53-7121.00","match":"native","w":0.889}],"n_sources":1,"weight":0.889,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"53-7121.00#4","text":"Check conditions and weights of vessels to ensure cleanliness and compliance with loading procedures.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"12797","via":"53-7121.00","match":"native","w":0.444}],"n_sources":1,"weight":0.444,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"53-7121.00#5","text":"Observe positions of cars passing loading spouts, and swing spouts into the correct positions at the appropriate times.","kind":"t