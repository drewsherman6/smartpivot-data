,"esco_uri":null,"sources":[{"source":"ilo","ref":"2634-3","via":"2634","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.506,"anthropic_penetration":null,"ilo_2025":0.285,"basis":"direct"},"robotics":null},{"id":"19-3039.02#64","text":"Maintaining required contacts, such as those with family members, educational authorities or employers, and recommending possible solutions to, and treatment of, problems","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2634-4","via":"2634","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.453,"anthropic_penetration":null,"ilo_2025":0.26,"basis":"direct"},"robotics":null},{"id":"19-3039.02#65","text":"Studying psychological factors in the diagnosis, treatment and prevention of mental illnesses and emotional or personality disorders, and conferring with related professionals","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2634-5","via":"2634","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.545,"anthropic_penetration":null,"ilo_2025":0.3,"basis":"direct"},"robotics":null},{"id":"19-3039.02#66","text":"Preparing scholarly papers and reports","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2634-6","via":"2634","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.9,"anthropic_penetration":null,"ilo_2025":0.54,"basis":"direct"},"robotics":null},{"id":"19-3039.02#67","text":"Formulating achievement, diagnostic and predictive tests for use by teachers in planning methods and content of instruction","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2634-7","via":"2634","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.68,"anthropic_penetration":null,"ilo_2025":0.365,"basis":"direct"},"robotics":null},{"id":"19-3039.02#68","text":"Conducting surveys and research studies on job design, work groups, morale, motivation, supervision and management","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2634-8","via":"2634","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.993,"anthropic_penetration":null,"ilo_2025":0.68,"basis":"direct"},"robotics":null},{"id":"19-3039.02#69","text":"Developing theories, models and methods to interpret and describe human behaviour.","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2634-9","via":"2634","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.696,"anthropic_penetration":null,"ilo_2025":0.37,"basis":"direct"},"robotics":null},{"id":"19-3039.02#70","text":"Examine and assess behaviour, diagnose behavioural, emotional and cognitive disorders, counsel clients and provide therapy","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31200.00","via":"31200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.02#71","text":"Help clients manage physical illness and disorders","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31200.00","via":"31200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.02#72","text":"Counsel individuals and groups to achieve more effective personal, social and vocational development and adjustment, and offer mediation services","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31200.00","via":"31200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.02#73","text":"Use standard psychological tests for assessment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31200.00","via":"31200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.02#74","text":"Plan intervention programs and conduct program evaluation","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31200.00","via":"31200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.02#75","text":"Apply psychological theory and principles regarding behaviour and mental processes such as learning, language development, memory and perception to develop treatment programs","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31200.00","via":"31200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.02#76","text":"Formulate hypotheses and experimental designs, review literature, conduct studies and publish research papers, educational texts and articles","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31200.00","via":"31200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.02#77","text":"Deliver presentations at conferences, workshops or symposia","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31200.00","via":"31200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.02#78","text":"Provide consultation services to government and other organizations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31200.00","via":"31200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.02#79","text":"Conduct applied psychology and/or experimental research.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31200.00","via":"31200","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.02#80","text":"Interview clients, prepare case histories and assess problems","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.02#81","text":"Develop and implement counselling and intervention programs to assist clients in determining goals and means of attaining them","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.02#82","text":"Counsel clients, provide therapy and mediation services, and facilitate group sessions","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.02#83","text":"Liaise with community agencies or partners,  and identify additional or alternative services and provide referrals","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.02#84","text":"Evaluate the effectiveness of counselling programs and interventions, and clients' progress in resolving identified problems and movement toward defined objectives","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.02#85","text":"Follow up on results of counselling programs and clients' adjustments","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.02#86","text":"Prepare assessment, progress, follow-up and court reports","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.02#87","text":"May supervise other counsellors, social service staff and assistants","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.02#88","text":"May provide public education and consultation to other professionals or groups regarding counselling services, issues and methods","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.02#89","text":"May provide witness testimony in court proceedings","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.02#90","text":"May conduct research, publish research papers, educational texts and articles and deliver presentations at conferences","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.02#91","text":"May collaborate with employee assistance programs or with government organizations in health and safety or with victims of crime","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-3039.02#92","text":"May participate in fundraising activities.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null}]}