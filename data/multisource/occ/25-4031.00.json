 for inclusion in library collections.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"1699","via":"25-4031.00","match":"native","w":0.363}],"n_sources":1,"weight":0.363,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"25-4031.00#6","text":"Catalogue and sort books and other print and non-print materials according to procedure and return them to shelves, files, or other designated storage areas.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"18512","via":"25-4031.00","match":"native","w":0.636}],"n_sources":1,"weight":0.636,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"25-4031.00#7","text":"Enter and update patrons' records on computers.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"1689","via":"25-4031.00","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"25-4031.00#8","text":"Provide assistance to teachers and students by locating materials and helping to complete special projects.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"1690","via":"25-4031.00","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"25-4031.00#9","text":"Compile and maintain records relating to circulation, materials, and equipment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"1702","via":"25-4031.00","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"25-4031.00#10","text":"Take a