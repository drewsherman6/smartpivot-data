botics":null},{"id":"31-9091.00#87","text":"Cast gold or metal alloys for bridges and denture bases","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33100.02","via":"33100","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"31-9091.00#88","text":"Pack plastic material in moulds to form full or partial dentures","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33100.02","via":"33100","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"31-9091.00#89","text":"Mould wax over denture set-up to form full contours of artificial gums","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33100.02","via":"33100","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"31-9091.00#90","text":"Make orthodontic bands from gold, silver, stainless steel or other metals","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33100.02","via":"33100","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"31-9091.00#91","text":"Finish metal framework of dentures and polish and buff dentures to obtain natural finish.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33100.02","via":"33100","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null}]}