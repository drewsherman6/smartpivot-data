://data.europa.eu/esco/skill/92721092-fe7c-4689-96bd-4f02385bc0e7","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/92721092-fe7c-4689-96bd-4f02385bc0e7","via":"http://data.europa.eu/esco/occupation/659b0ffd-337c-4a1f-82e3-2730812279de","match":"broadMatch","essential":false,"w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"13-2099.00#78","text":"liaise with financiers","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/401d8d12-b56d-4c71-ac58-f791e8c085b4","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/401d8d12-b56d-4c71-ac58-f791e8c085b4","via":"http://data.europa.eu/esco/occupation/659b0ffd-337c-4a1f-82e3-2730812279de","match":"broadMatch","essential":false,"w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"13-2099.00#79","text":"Obtaining information about services to be sold and needs of prospective buyers","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3339-1","via":"3339","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.942,"anthropic_penetration":null,"ilo_2025":0.6,"basis":"direct"},"robotics":null},{"id":"13-2099.00#80","text":"Negotiating contracts on behalf of seller or buyer and explaining terms of sale and payment to client","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3339-2","via":"3339","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.595,"anthropic_penetration":null,"ilo_2025":0.33,"basis":"direct"},"robotics":null},{"id":"13-2099.00#81","text":"Signing agreements on behalf of seller or buyer and ensuring that contract is honoured","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3339-3","via":"3339","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.529,"anthropic_penetration":null,"ilo_2025":0.29,"basis":"direct"},"robotics":null},{"id":"13-2099.00#82","text":"Making sure that the business service purchased is made available to the buyer in the agreed format at the agreed time","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3339-4","via":"3339","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.889,"anthropic_penetration":null,"ilo_2025":0.535,"basis":"direct"},"robotics":null},{"id":"13-2099.00#83","text":"Selling by auction various kinds of property, cars, commodities, livestock, art, jewellery and other objects.","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3339-5","via":"3339","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.741,"anthropic_penetration":null,"ilo_2025":0.4,"basis":"direct"},"robotics":null},{"id":"13-2099.00#84","text":"Organizing group tours for business or vacation travel and making bulk travel and accommodation bookings.","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3339-6","via":"3339","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.872,"anthropic_penetration":null,"ilo_2025":0.515,"basis":"direct"},"robotics":null},{"id":"13-2099.00#85","text":"Examine and analyze journal and ledger entries, bank statements, inventories, expenditures, tax returns and other accounting and financial records, documents and systems of individuals, departments within organizations, businesses or other establishments to ensure financial recording accuracy and compliance with established accounting standards, procedures and internal controls","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11100.01","via":"11100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2099.00#86","text":"Prepare detailed reports on audit findings and make recommendations to improve individual or establishment's accounting and management practices","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11100.01","via":"11100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2099.00#87","text":"Conduct field audits of businesses to ensure compliance with provisions of the Income Tax Act, Canadian Business Corporations Act or other statutory requirements","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11100.01","via":"11100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2099.00#88","text":"May supervise other auditors or professionals in charge of accounting within client's establishment.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11100.01","via":"11100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2099.00#89","text":"Plan, set up and administer accounting systems and prepare financial information for individuals, departments within organizations, businesses and other establishments","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11100.02","via":"11100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2099.00#90","text":"Examine accounting records and prepare financial statements and reports","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11100.02","via":"11100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2099.00#91","text":"Develop and maintain cost finding, reporting and internal control procedures","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11100.02","via":"11100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2099.00#92","text":"Examine financial accounts and records and prepare income tax returns from accounting records","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11100.02","via":"11100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2099.00#93","text":"Analyze financial statements and reports and provide financial, business and tax advice","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11100.02","via":"11100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2099.00#94","text":"May act as a trustee in bankruptcy proceedings","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11100.02","via":"11100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2099.00#95","text":"May supervise and train articling students, other accountants or administrative technicians.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11100.02","via":"11100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2099.00#96","text":"Develop personal financial plans for clients covering cash management, finances, insurance coverage, investments, retirement and estate planning, taxes and legal matters","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11102.00","via":"11102","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2099.00#97","text":"Analyze clients' financial records, set goals and develop a financial strategy","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11102.00","via":"11102","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2099.00#98","text":"Advise clients on implementing the financial plan to help them achieve their goals","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11102.00","via":"11102","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2099.00#99","text":"May also arrange for the purchase and sale of financial products and investments depending on the licence held, and monitor the portfolio to ensure its quality and profitability","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11102.00","via":"11102","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2099.00#100","text":"May help to expand business and attract new clients.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11102.00","via":"11102","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2099.00#101","text":"Review and examine banks, trust companies, credit unions, caisses populaires, credit companies, real estate companies, insurance companies, pension funds, securities brokers and other financial services and institutions to ensure compliance with governing legislation and regulations.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11109.01","via":"11109","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2099.00#102","text":"Investigate possible unethical conduct or breaches of securities or commodity futures laws by persons or companies that trade in securities and commodity futures or that provide related financial services.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11109.02","via":"11109","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2099.00#103","text":"Analyze clients requests to assess risk and details of stocks, bonds, mortgages or other financing solutions","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11109.03","via":"11109","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2099.00#104","text":"Negotiate with corporations, governments or individuals to determine the type and terms of financial products and prepare offering prospectuses or contracts","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11109.03","via":"11109","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2099.00#105","text":"May underwrite new issues of stocks and bonds.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11109.03","via":"11109","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2099.00#106","text":"Administer estate, personal, charitable, corporate and other types of trusts","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11109.04","via":"11109","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2099.00#107","text":"Direct trust account investments, receive and record investment income and disburse trust funds.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11109.04","via":"11109","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2099.00#108","text":"Meet with clients to obtain information about income, liabilities and assets, and type, price and condition of property to be mortgaged","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11109.05","via":"11109","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"13-2099.00#109","text":"Negotiate mortgage loans with lenders or lending institutions on behalf of clients.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"11109.05","via":"11109","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null}]}