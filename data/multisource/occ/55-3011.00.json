asis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3011.00#41","text":"Inspect motors in operation, road test motor vehicles, and test automotive systems and components using computerized diagnostic and other testing devices to diagnose and isolate faults","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3011.00#42","text":"Configure and operate intelligence, surveillance and recognizance systems","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3011.00#43","text":"Oversee the construction of tools and devices to enable infantry soldiers to cross natural and man-made obstacles and break through enemy defenses","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3011.00#44","text":"Operate weapons and missile related equipment for defense.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"43204.00","via":"43204","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3011.00#45","text":"Provide assistance in emergency situations, such as civil disorder, natural disasters and major accidents","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3011.00#46","text":"Operate armoured vehicles, artillery, hand-held weapons and other military combat equipment and defense systems","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3011.00#47","text":"Engage in non-combat operations for humanitarian efforts","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3011.00#48","text":"Participate in drills and other training in preparation for peacekeeping, combat and natural disaster relief","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3011.00#49","text":"Maintain weapon systems, vehicles, survival gear and personal defensive equipment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3011.00#50","text":"Perform underwater search and recovery operations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"55-3011.00#51","text":"Use tactics of camouflage and concealment, patrol, attack, defense, and evasion when engaged in combat missions.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"44200.00","via":"44200","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null}]}