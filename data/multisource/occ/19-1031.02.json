"direct"}},{"id":"19-1031.02#4","text":"Manage forage resources through fire, herbicide use, or revegetation to maintain a sustainable yield from the land.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7500","via":"19-1031.02","match":"native","w":0.455}],"n_sources":1,"weight":0.455,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"19-1031.02#5","text":"Mediate agreements among rangeland users and preservationists as to appropriate land use and management.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7499","via":"19-1031.02","match":"native","w":0.273}],"n_sources":1,"weight":0.273,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"19-1031.02#6","text":"Study rangeland management practices and research range problems to provide sustained production of forage, livestock, and wildlife.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7501","via":"19-1031.02","match":"native","w":0.455}],"n_sources":1,"weight":0.455,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"19-1031.02#7","text":"Offer advice to rangeland users on water management, forage production methods, and control of brush.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7502","via":"19-1031.02","match":"native","w":0.455}],"n_sources":1,"weight":0.455,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"19-1031.02#8","text":"Coordinate with federal land managers and other agencies and organizations to manage and protect rangelands.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21170","via":"19-1031.02","match":"native","w":0.637}],"n_sources":1,"weight":0.637,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"19-1031.02#9","text":"Measure and assess vegetation resources for biological assessment companies, environmental impact statements, and rangeland monitoring programs.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7497","via":"19-1031.02","match":"native","w":0.818}],"n_sources":1,"weight":0.818,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"19-1031.02#10","text":"Plan and implement revegetation of disturbed sites.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7507","via":"19-1031.02","match":"native","w":0.273}],"n_sources":1,"weight":0.273,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"19-1031.02#11","text":"Manage private livestock operations.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7510","via":"19-1031.02","match":"native","w":0.007}],"n_sources":1,"weight":0.007,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":null},{"id":"19-1031.02#12","text":"Plan and direct construction and maintenance of range improvements, such as fencing, corrals, stock-watering reservoirs, and soil-erosion control structures.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7503","via":"19-1031.02","match":"native","w":0.455}],"n_sources":1,"weight":0.455,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"19-1031.02#13","text":"Regulate grazing, such as by issuing permits and checking for compliance with standards, and help ranchers plan and organize grazing systems to manage, improve, protect, and maximize the use of rangelands.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21169","via":"19-1031.02","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"19-1031.02#14","text":"Develop technical standards and specifications used to manage, protect, and improve the natural resources of range lands and related grazing lands.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7505","via":"19-1031.02","match":"native","w":0.273}],"n_sources":1,"weight":0.273,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"19-1031.02#15","text":"Study forage plants and their growth requirements to determine varieties best suited to particular range.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7508","via":"19-1031.02","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"19-1031.02#16","text":"Develop new and improved instruments and techniques for activities, such as range reseeding.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7511","via":"19-1031.02","match":"native","w":0.091}],"n_sources":1,"weight":0.091,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"19-1031.02#17","text":"Develop methods for protecting range from fire and rodent damage and for controlling poisonous plants.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"7509","via":"19-1031.02","match":"native","w":0.182}],"n_sources":1,"weight":0.182,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"19-1031.02#18","text":"Apply herbicide to eliminate harmful plants.","kind":"task","esco_uri":null,"sources":[{"sour