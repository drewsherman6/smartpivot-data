osswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.618,"anthropic_penetration":null,"ilo_2025":0.3375,"basis":"direct"},"robotics":null},{"id":"19-1021.00#88","text":"Designing and conducting experiments and tests","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2131-2","via":"2131","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.826,"anthropic_penetration":null,"ilo_2025":0.465,"basis":"direct"},"robotics":null},{"id":"19-1021.00#89","text":"Gathering human, animal, insect and plant specimens and data, and studying their origin, development, chemical and physical form, structure, composition, and life and reproductive processes","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2131-3","via":"2131","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.382,"anthropic_penetration":null,"ilo_2025":0.2325,"basis":"direct"},"robotics":null},{"id":"19-1021.00#90","text":"Examining living organisms using a variety of specialised equipment, instruments, technologies and techniques such as electron microscopes, telemetry, global positioning systems, biotechnology, satellite imaging, genetic engineering, digital imaging analysis, polymerase chain reaction and computer modelling","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2131-4","via":"2131","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.633,"anthropic_penetration":null,"ilo_2025":0.35,"basis":"direct"},"robotics":null},{"id":"19-1021.00#91","text":"Identifying, classifying, recording and monitoring living organisms and maintaining databases","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2131-5","via":"2131","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.564,"anthropic_penetration":null,"ilo_2025":0.31,"basis":"direct"},"robotics":null},{"id":"19-1021.00#92","text":"Writing scientific papers and reports detailing research and any new findings which are then made available to the scientific community in scientific journals or at conferences for scrutiny and further debate","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2131-6","via":"2131","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.872,"anthropic_penetration":null,"ilo_2025":0.515,"basis":"direct"},"robotics":null},{"id":"19-1021.00#93","text":"Designing and carrying out environmental impact assessments to identify changes caused by natural or human factors","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2131-7","via":"2131","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.826,"anthropic_penetration":null,"ilo_2025":0.465,"basis":"direct"},"robotics":null},{"id":"19-1021.00#94","text":"Providing advice to governments, organizations and businesses in areas such as conservation, management of natural resources, the effects of climate change and pollution.","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2131-8","via":"2131","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.857,"anthropic_penetration":null,"ilo_2025":0.5,"basis":"direct"},"robotics":null},{"id":"19-1021.00#95","text":"Design and conduct research in experimental and theoretical physics","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21100.01","via":"21100","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-1021.00#96","text":"Carry out analysis of research data and prepare research reports","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21100.01","via":"21100","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-1021.00#97","text":"Participate as a member of a research or development team in the design and development of experimental, industrial or medical equipment, instrumentation and procedures.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21100.01","via":"21100","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-1021.00#98","text":"Design and conduct observational surveys, conduct detailed analyses and develop numerical models to extend knowledge of celestial bodies and cosmic radiation","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21100.02","via":"21100","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-1021.00#99","text":"Develop or participate in the development of instrumentation and software for astronomical observation and analysis.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21100.02","via":"21100","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-1021.00#100","text":"Analyze, synthesize, purify, modify and characterize chemical or biochemical compounds","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21101.00","via":"21101","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-1021.00#101","text":"Develop and conduct programs of analysis to ensure quality control of raw materials, chemical intermediates or final products","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21101.00","via":"21101","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-1021.00#102","text":"Conduct programs of sample and data collection and analysis to identify and quantify environmental toxicants","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21101.00","via":"21101","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-1021.00#103","text":"Conduct research to develop new chemical formulations and processes and devise new technical applications of industrial chemicals and compounds","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21101.00","via":"21101","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-1021.00#104","text":"Conduct research to discover, develop, refine and evaluate new products such as those used in nanomedicine, nanoelectronics and other applications of chemistry","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21101.00","via":"21101","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-1021.00#105","text":"Conduct fundamental and applied research into the synthesis and properties of chemical compounds and the mechanisms of chemical reactions","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21101.00","via":"21101","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-1021.00#106","text":"Investigate chemical aspects of the mechanisms of drug action, the diagnosis and treatment of disease, organ function and the assessment of health","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21101.00","via":"21101","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-1021.00#107","text":"Participate in interdisciplinary research and development projects working with chemical engineers, biologists, microbiologists, agronomists, geologists or other professionals","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21101.00","via":"21101","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-1021.00#108","text":"Act as technical consultant in a particular field of expertise","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21101.00","via":"21101","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-1021.00#109","text":"May participate in the commercialization of new products","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21101.00","via":"21101","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"19-1021.00#110","text":"May supervise other chemists and chemical technicians and technologists.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"21101.00","via":"21101","match":"statcan_concordance","w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null}]}