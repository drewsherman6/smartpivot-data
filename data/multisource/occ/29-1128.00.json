44056b62523","match":"broadMatch","essential":true,"w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-1128.00#39","text":"identify customer objectives","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/4a84caca-4423-4a73-aeb4-47986173922b","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/4a84caca-4423-4a73-aeb4-47986173922b","via":"http://data.europa.eu/esco/occupation/f7177f79-63e7-4944-8896-044056b62523","match":"broadMatch","essential":true,"w":0.5}],"n_sources":1,"weight":0.5,"ai":null,"robotics":null},{"id":"29-1128.00#40","text":"older adults' needs","kind":"knowledge","esco_uri":"http://data.europa.eu/esco/skill/634865e0-2ec2-4b7f-bb7f-c196637f0f7b","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/634865e0-2ec2-4b7f-bb7f-c196637f0f7b","via":"http://data.europa.eu/esco/occupation/f7177f79-63e7-4944-8896-044056b62523","match":"broadMatch","essential":false,"w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"29-1128.00#41","text":"communicate with youth","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/b5af495b-61f1-4330-9891-dca56d97d714","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/b5af495b-61f1-4330-9891-dca56d97d714","via":"http://data.europa.eu/esco/occupation/f7177f79-63e7-4944-8896-044056b62523","match":"broadMatch","essential":false,"w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"29-1128.00#42","text":"evaluate older adults' ability to take care of themselves","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/b4910ea9-578d-4767-bd68-00a315a64e09","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/b4910ea9-578d-4767-bd68-00a315a64e09","via":"http://data.europa.eu/esco/occupation/f7177f79-63e7-4944-8896-044056b62523","match":"broadMatch","essential":false,"w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"29-1128.00#43","text":"children's physical development","kind":"knowledge","esco_uri":"http://data.europa.eu/esco/skill/3ff9d956-3e26-40d1-ae0e-f5f247943042","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/3ff9d956-3e26-40d1-ae0e-f5f247943042","via":"http://data.europa.eu/esco/occupation/f7177f79-63e7-4944-8896-044056b62523","match":"broadMatch","essential":false,"w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"29-1128.00#44","text":"Administering muscle, nerve, joint  functional ability and other tests to identify and assess physical problems of patients","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2264-1","via":"2264","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.257,"anthropic_penetration":null,"ilo_2025":0.165,"basis":"direct"},"robotics":null},{"id":"29-1128.00#45","text":"Establishing treatment goals with patients and designing treatment programmes to reduce physical pain, strengthen muscles, improve cardiothoracic, cardiovascular and respiratory functions, restore joint mobility and improve balance and coordination","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2264-2","via":"2264","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.324,"anthropic_penetration":null,"ilo_2025":0.19,"basis":"direct"},"robotics":null},{"id":"29-1128.00#46","text":"Developing, implementing and monitoring programmes and treatments using the therapeutic properties of exercise, heat, cold, massage, manipulation, hydrotherapy, electrotherapy, ultraviolet and infra-red light and ultrasound in the treatment of patients","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2264-3","via":"2264","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.257,"anthropic_penetration":null,"ilo_2025":0.165,"basis":"direct"},"robotics":null},{"id":"29-1128.00#47","text":"Instructing patients and their families in procedures to be continued outside clinical settings","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2264-4","via":"2264","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.377,"anthropic_penetration":null,"ilo_2025":0.2275,"basis":"direct"},"robotics":null},{"id":"29-1128.00#48","text":"Recording information on patients' health status and responses to treatment in medical records-keeping systems, and sharing information with other health professionals as required to ensure continuing and comprehensive care","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2264-5","via":"2264","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.919,"anthropic_penetration":null,"ilo_2025":0.56,"basis":"direct"},"robotics":null},{"id":"29-1128.00#49","text":"Developing and implementing programmes for screening and prevention of common physical ailments and disorders","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2264-6","via":"2264","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.657,"anthropic_penetration":null,"ilo_2025":0.355,"basis":"direct"},"robotics":null},{"id":"29-1128.00#50","text":"Supervising the work of physiotherapy assistants and others.","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2264-7","via":"2264","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.589,"anthropic_penetration":null,"ilo_2025":0.3225,"basis":"direct"},"robotics":null},{"id":"29-1128.00#51","text":"Assess patients and review reports from physicians, physiotherapists, psychiatrists, counsellors, teachers and other professionals to determine patients' capabilities and needs.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31204.01","via":"31204","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#52","text":"Prepare individualized and group treatment plans either independently or through a multidisciplinary team approach, based on health concerns and on recommendations from physicians or other health professionals","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31204.01","via":"31204","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#53","text":"Design and carry out specialized therapy sessions employing techniques such as art, athletic, dance, music or recreational therapy or remedial gymnastics to meet specific physical or psychological needs of patients","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31204.01","via":"31204","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#54","text":"Co-ordinate, initiate, design and implement specialized therapy programs for the general patient population and in the community","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31204.01","via":"31204","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#55","text":"Advise patients on how to deal with their mental and physical abilities and help them integrate into the community","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31204.01","via":"31204","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#56","text":"Observe, analyze and record, patients' participation, reactions, and progress during treatment sessions and consult with other health care professionals to evaluate and modify treatment plans as needed","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31204.01","via":"31204","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#57","text":"May conduct research in therapeutic recreation.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31204.01","via":"31204","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#58","text":"Assess clients to determine their current and potential functioning level and to aid in the development of individualized recovery or rehabilitation programs","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31204.02","via":"31204","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"transferred","from":"Assess physical performance requirements to aid in the development of individualized recovery or rehabilitation exercise","similarity":0.412},"robotics":{"tier":"E0","score":0,"basis":"transferred","from":"Assess physical performance requirements to aid in the development of individualized recovery or rehabilitation exercise","similarity":0.412}},{"id":"29-1128.00#59","text":"Design specialized therapy programs to maintain, rehabilitate or enhance movement, musculoskeletal functioning and performance in sports, work and recreation","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31204.02","via":"31204","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#60","text":"Implement therapeutic programs by employing approaches and techniques such as exercise, sports or other movement therapy","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31204.02","via":"31204","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#61","text":"Instruct clients on techniques to rehabilitate physical injuries or improve physical performance","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31204.02","via":"31204","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#62","text":"Observe, record observations and analyze clients during treatment sessions, write progress reports and consult with other health professionals to evaluate and modify treatment plans as required","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31204.02","via":"31204","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#63","text":"May advise clients regarding health promotion and injury prevention, management and treatment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31204.02","via":"31204","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#64","text":"May conduct research in respective field of specialization.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31204.02","via":"31204","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#65","text":"Interview clients, prepare case histories and assess problems","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#66","text":"Develop and implement counselling and intervention programs to assist clients in determining goals and means of attaining them","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#67","text":"Counsel clients, provide therapy and mediation services, and facilitate group sessions","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#68","text":"Liaise with community agencies or partners,  and identify additional or alternative services and provide referrals","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#69","text":"Evaluate the effectiveness of counselling programs and interventions, and clients' progress in resolving identified problems and movement toward defined objectives","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#70","text":"Follow up on results of counselling programs and clients' adjustments","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#71","text":"Prepare assessment, progress, follow-up and court reports","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#72","text":"May supervise other counsellors, social service staff and assistants","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#73","text":"May provide public education and consultation to other professionals or groups regarding counselling services, issues and methods","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#74","text":"May provide witness testimony in court proceedings","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#75","text":"May conduct research, publish research papers, educational texts and articles and deliver presentations at conferences","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#76","text":"May collaborate with employee assistance programs or with government organizations in health and safety or with victims of crime","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#77","text":"May participate in fundraising activities.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41301.00","via":"41301","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#78","text":"Advise clients on hair colour, hairstyles, make-up, clothing and accessories; may advise on posture, general appearance and manners, and provide courses and seminars on business and social etiquette","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"64201.01","via":"64201","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#79","text":"Advise clients on type, colour and application of make-up","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"64201.01","via":"64201","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#80","text":"Advise clients on choice of colours for clothing that will complement their appearance.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"64201.01","via":"64201","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#81","text":"Advise clients on the selection of wedding gowns, floral arrangements, banquet facilities, wedding invitations and other items related to weddings.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"64201.02","via":"64201","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1128.00#82","text":"Administer commercial weight-loss programs, advise clients on diet and exercise and provide related support services.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"64201.03","via":"64201","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null}]}