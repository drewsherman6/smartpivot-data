333333333333,"basis":"direct"}},{"id":"51-9197.00#4","text":"Place tires into molds for new tread.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14431","via":"51-9197.00","match":"native","w":0.3}],"n_sources":1,"weight":0.3,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-9197.00#5","text":"Fit inner tubes and final layers of rubber onto tires.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14423","via":"51-9197.00","match":"native","w":0.3}],"n_sources":1,"weight":0.3,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-9197.00#6","text":"Buff tires according to specifications for width and undertread depth.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21215","via":"51-9197.00","match":"native","w":0.6}],"n_sources":1,"weight":0.6,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-9197.00#7","text":"Brush or spray solvents onto plies to ensure adhesion, and repeat process as specified, alternating direction of each ply to strengthen tires.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14426","via":"51-9197.00","match":"native","w":0.3}],"n_sources":1,"weight":0.3,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-9197.00#8","text":"Start rollers that bond tread and plies as drums revolve.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14411","via":"51-9197.00","match":"native","w":0.4}],"n_sources":1,"weight":0.4,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"5