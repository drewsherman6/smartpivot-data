"score":0.3333333333333333,"basis":"direct"}},{"id":"51-9197.00#14","text":"Cut plies at splice points, and press ends together to form continuous bands.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14414","via":"51-9197.00","match":"native","w":0.4}],"n_sources":1,"weight":0.4,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-9197.00#15","text":"Depress pedals to rotate drums, and wind specified numbers of plies around drums to form tire bodies.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14410","via":"51-9197.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-9197.00#16","text":"Clean and paint completed tires.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14422","via":"51-9197.00","match":"native","w":0.1}],"n_sources":1,"weight":0.1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-9197.00#17","text":"Rub cement sticks on drum edges to provide adhesive surfaces for plies.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14424","via":"51-9197.00","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-9197.00#18","text":"Depress pedals to collapse drums after processing is complete.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14429","via":"51-9197.00","match":"native","w":0.2}],"n_sources":1,"weight":0.2,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-9197.00#19","text":"Wind chafers and breakers onto plies.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14419","via":"51-9197.00","match":"native","w":0.3}],"n_sources":1,"weight":0.3,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-9197.00#20","text":"Pull plies from supply racks, and align plies with edges of drums.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14420","via":"51-9197.00","match":"native","w":0.5}],"n_sources":1,"weight":0.5,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-9197.00#21","text":"brush solvent","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/52aaaffb-affb-4b2e-9094-efdf4ab95674","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/52aaaffb-affb-4b2e-9094-efdf4ab95674","via":"http://data.europa.eu/esco/occupation/2430774f-d92a-40e4-817d-d03dd5a33207","match":"exactMatch","essential":true,"w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"51-9197.00#22","text":"paint tyres","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/499b42b1-6118-41bd-bd1b-13a61844b120","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/499b42b1-6118-41bd-bd1b-13a61844b120","via":"http://data.europa.eu/esco/occupation/2430774f-d92a-40e4-817d-d03dd5a33207","match":"exactMatch","essential":true,"w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"51-9197.00#23","text":"manage camelbacks","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/d6fa0a32-0e78-4c4f-ae34-c127e946de48","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/d6fa0a32-0e78-4c4f-ae34-c127e946de48","via":"http://data.europa.eu/esco/occupation/2430774f-d92a-40e4-817d-d03dd5a33207","match":"exactMatch","essential":true,"w":1}],"n_sources":1,"weight":1,