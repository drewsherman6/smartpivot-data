,"kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9627","via":"39-3099.00","match":"native","w":0.214}],"n_sources":1,"weight":0.214,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-3099.00#2","text":"Provide dressing assistance to cast members or assign cast dressers to assist specific cast members with costume changes.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"20898","via":"39-3099.00","match":"native","w":0.928}],"n_sources":1,"weight":0.928,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-3099.00#3","text":"Arrange costumes in order of use to facilitate quick-change procedures for performances.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9616","via":"39-3099.00","match":"native","w":0.5}],"n_sources":1,"weight":0.5,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"39-3099.00#4","text":"Design or construct costumes or send them to tailors for construction, major repairs, or alterations.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9621","via":"39-3099.00","match":"native","w":0.285}],"n_sources":1,"weight":0.285,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-3099.00#5","text":"Examine costume fit on cast members and sketch or write notes for alterations.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9629","via":"39-3099.00","match":"native","w":0.285}],"n_sources":1,"weight":0.285,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-3099.00#6","text":"Distribute costumes or related equipment and keep records of item status.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9615","via":"39-3099.00","match":"native","w":0.285}],"n_sources":1,"weight":0.285,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"39-3099.00#7","text":"Check the appearance of costumes on stage or under lights to determine whether desired effects are being achieved.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9623","via":"39-3099.00","match":"native","w":0.143}],"n_sources":1,"weight":0.143,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-3099.00#8","text":"Clean and press costumes before and after performances and perform any minor repairs.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9618","via":"39-3099.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"39-3099.00#9","text":"Collaborate with production designers, costume designers, or other production staff to discuss and execute costume design details.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9625","via":"39-3099.00","match":"native","w":0.214}],"n_sources":1,"weight":0.214,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-3099.00#10","text":"Monitor, maintain, or secure inventories of costumes, wigs, or makeup, providing keys or access to assigned directors, costume designers, or wardrobe mistresses/masters.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9626","via":"39-3099.00","match":"native","w":0.214}],"n_sources":1,"weight":0.214,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"39-3099.00#11","text":"Purchase, rent, or requisition costumes or other wardrobe necessities.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9622","via":"39-3099.00","match":"native","w":0.143}],"n_sources":1,"weight":0.143,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-3099.00#12","text":"Study books, pictures, or examples of period clothing to determine styles worn during specific periods in history.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9632","via":"39-3099.00","match":"native","w":0.071}],"n_sources":1,"weight":0.071,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-3099.00#13","text":"Return borrowed or rented items when productions are complete and return other items to storage.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9617","via":"39-3099.00","match":"native","w":0.143}],"n_sources":1,"weight":0.143,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"39-3099.00#14","text":"Review scripts or other production information to determine a story's locale or period, as well as the number of characters and required costumes.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9630","via":"39-3099.00","match":"native","w":0.071}],"n_sources":1,"weight":0.071,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-3099.00#15","text":"Inventory stock to determine types or conditions of available costuming.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9624","via":"39-3099.00","match":"native","w":0.143}],"n_sources":1,"weight":0.143,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"39-3099.00#16","text":"Direct the work of wardrobe crews during dress rehearsals or performances.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9628","via":"39-3099.00","match":"native","w":0.214}],"n_sources":1,"weight":0.214,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-3099.00#17","text":"Participate in the hiring, training, scheduling, or supervision of alteration workers.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9634","via":"39-3099.00","match":"native","w":0.071}],"n_sources":1,"weight":0.071,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-3099.00#18","text":"Provide managers with budget recommendations and take responsibility for budgetary line items related to costumes, storage, or makeup needs.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9633","via":"39-3099.00","match":"native","w":0.071}],"n_sources":1,"weight":0.071,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-3099.00#19","text":"Assign lockers to employees and maintain locker rooms, dressing rooms, wig rooms, or costume storage or laundry areas.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9619","via":"39-3099.00","match":"native","w":0.214}],"n_sources":1,"weight":0.214,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-3099.00#20","text":"Recommend vendors and monitor their work.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9631","via":"39-3099.00","match":"native","w":0.071}],"n_sources":1,"weight":0.071,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"39-3099.00#21","text":"Care for non-clothing items, such as flags, table skirts, or draperies.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"9635","via":"39-3099.00","match":"native","w":0.071}],"n_sources":1,"weight":0.071,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"39-3099.00#22","text":"Set up, assemble, adjust, maintain and replace reels and projector equipment; detect and repair mechanical and electrical problems; and change and install an electronic control panel using automated equipment.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"53111.01","via":"53111","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"39-3099.00#23","text":"Check the condition of the copy; set up and load film reels on movie theatre projection systems, adjust focus, sound levels and other projector and theatre settings; and maintain projection equipment.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"53111.02","via":"53111","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"39-3099.00#24","text":"Assemble, repair, place, build and oversee props.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"53111.03","via":"53111","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"39-3099.00#25","text":"Distribute scripts to actors; keep detailed notes of all actions, positions and camera angles; and photograph and date scenes.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"53111.04","via":"53111","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"39-3099.00#26","text":"Rig, place, move and dismantle sets, backdrops, scenery and other stage equipment.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"53111.05","via":"53111","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"39-3099.00#27","text":"Clean, maintain, transport and store costumes, and assist performers to dress in costumes.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"53111.06","via":"53111","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"39-3099.00#28","text":"Provide support to the director and producer, and are responsible for various aspects of production such as preparing schedules, setting up equipment, and making travel arrangements to various shooting locations.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"53111.07","via":"53111","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null}]}