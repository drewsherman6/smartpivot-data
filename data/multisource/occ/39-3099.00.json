oducer, and are responsible for various aspects of production such as preparing schedules, setting up equipment, and making travel arrangements to various shooting locations.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"53111.07","via":"53111","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null}]}