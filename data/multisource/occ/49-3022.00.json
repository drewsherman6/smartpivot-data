ation (SOC 2010 via BLS 2010-2018)","raw":0.55,"pct":0.488}]}},"agreement":{"families":4,"sd":0.268,"range":0.701,"label":"sources disagree"},"headline":{"value":0.003,"time_weighted_tasks":0,"other_measures_pct":0.37,"other_measures_linked":0.005,"weight_time_weighted":0.5,"weight_other_measures":0.5}}},"statements":[{"id":"49-3022.00#1","text":"Select appropriate tools, safety equipment, and parts, according to job requirements.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8325","via":"49-3022.00","match":"native","w":0.334}],"n_sources":1,"weight":0.334,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-3022.00#2","text":"Prime all scratches on pinchwelds with primer and allow to dry.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"20645","via":"49-3022.00","match":"native","w":0.167}],"n_sources":1,"weight":0.167,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-3022.00#3","text":"Remove all dirt, foreign matter, and loose glass from damaged areas, apply primer along windshield or window edges, and allow primer to dry.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8318","via":"49-3022.00","match":"native","w":0.416}],"n_sources":1,"weight":0.416,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-3022.00#4","text":"Check for and remove moisture or contamination in damaged areas and keep areas dry until repairs are complete.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8323","via":"49-3022.00","match":"native","w":0.167}],"n_sources":1,"weight":0.167,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-3022.00#5","text":"Apply a bead of urethane around the perimeter of each pinchweld and dress the remaining urethane on the pinchwelds so that it is of uniform level and thickness.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8324","via":"49-3022.00","match":"native","w":0.5}],"n_sources":1,"weight":0.5,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-3022.00#6","text":"Obtain windshields or windows for specific automobile makes and models from stock and examine them for defects prior to installation.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8322","via":"49-3022.00","match":"native","w":0.416}],"n_sources":1,"weight":0.416,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-3022.00#7","text":"Install, repair, or replace safety glass and related materials, such as back glass heating elements, on vehicles or equipment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8329","via":"49-3022.00","match":"native","w":0.5}],"n_sources":1,"weight":0.5,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-3022.00#8","text":"Install replacement glass in vehicles.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"20646","via":"49-3022.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-3022.00#9","text":"Allow all glass parts installed with urethane ample time to cure, taking temperature and humidity into account.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8320","via":"49-3022.00","match":"native","w":0.25}],"n_sources":1,"weight":0.25,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-3022.00#10","text":"Replace all moldings, clips, windshield wipers, or other parts that were removed prior to glass replacement or repair.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8327","via":"49-3022.00","match":"native","w":0.5}],"n_sources":1,"weight":0.5,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-3022.00#11","text":"Remove broken or damaged glass windshields or window glass from motor vehicles, using hand tools to remove screws from frames holding glass.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8326","via":"49-3022.00","match":"native","w":0.666}],"n_sources":1,"weight":0.666,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-3022.00#12","text":"Replace or adjust motorized or manual window-raising mechanisms.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8333","via":"49-3022.00","match":"native","w":0.167}],"n_sources":1,"weight":0.167,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-3022.00#13","text":"Remove moldings, clips, windshield wipers, screws, bolts, and inside A-pillar moldings and lower headliners in preparation for installation or repair work.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8328","via":"49-3022.00","match":"native","w":0.5}],"n_sources":1,"weight":0.5,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-3022.00#14","text":"Install new foam dams on pinchwelds, if required.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8334","via":"49-3022.00","match":"native","w":0.083}],"n_sources":1,"weight":0.083,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-3022.00#15","text":"Install rubber channeling strips around edges of glass or frames to weatherproof windows or to prevent rattling.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8330","via":"49-3022.00","match":"native","w":0.167}],"n_sources":1,"weight":0.167,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-3022.00#16","text":"Cut flat safety glass according to specified patterns or perform precision pattern making and glass cutting to custom fit replacement windows.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8332","via":"49-3022.00","match":"native","w":0.083}],"n_sources":1,"weight":0.083,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-3022.00#17","text":"Hold cut or uneven edges of glass against automated abrasive belts to shape or smooth edges.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8331","via":"49-3022.00","match":"native","w":0.006}],"n_sources":1,"weight":0.006,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-3022.00#18","text":"Cool or warm glass in the event of temperature extremes.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"8335","via":"49-3022.00","match":"native","w":0.083}],"n_sources":1,"weight":0.083,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-3022.00#19","text":"troubleshoot","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/334e3e49-fb02-4051-809a-f06adfdc1c40","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/334e3e49-fb02-4051-809a-f06adfdc1c40","via":"http://data.europa.eu/esco/occupation/211716b7-2857-40c8-a078-da983c78c70a","match":"exactMatch","essential":true,"w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"49-3022.00#20","text":"clean vehicle exterior","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/62c65f51-b92f-43f7-bf66-a0ae1df19ef0","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/62c65f51-b92f-43f7-bf66-a0ae1df19ef0","via":"http://data.europa.eu/esco/occupation/211716b7-2857-40c8-a078-da983c78c70a","match":"exactMatch","essential":true,"w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"49-3022.00#21","text":"apply primer","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/0ca36eb4-ead9-4a60-863c-713841d69048","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/0ca36eb4-ead9-4a60-863c-713841d69048","via":"http://data.europa.eu/esco/occupation/211716b7-2857-40c8-a078-da983c78c70a","match":"exactMatch","essential":true,"w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"49-3022.00#22","text":"remove windshields","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/cccf1173-2b4c-422c-8cbd-e66182c6834a","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/cccf1173-2b4c-422c-8cbd-e66182c6834a","via":"http://data.europa.eu/esco/occupation/211716b7-2857-40c8-a078-da983c78c70a","match":"exactMatch","essential":true,"w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"49-3022.00#23","text":"polish windshields","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/99dacbf5-d14c-4ce3-8d20-f3976a6f3818","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/99dacbf5-d14c-4ce3-8d20-f3976a6f3818","via":"http://data.europa.eu/esco/occupation/211716b7-2857-40c8-a078-da983c78c70a","match":"exactMatch"