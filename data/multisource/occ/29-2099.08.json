"kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32103.02","via":"32103","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#39","text":"Perform diagnostic tests, such as pulmonary function and asthma stress, or assist physicians with cardiac and cardiopulmonary stress tests and bronchoscopies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32103.03","via":"32103","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#40","text":"Determine patients' blood characteristics such as activated clotting time and oxygen saturation","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32103.03","via":"32103","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#41","text":"Monitor patients and advise physician of any changes in patients' condition","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32103.03","via":"32103","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#42","text":"Prepare medications and administer inhaler and other treatments under supervision of cardiologist","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32103.03","via":"32103","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#43","text":"Provide information and care for patients during tests","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32103.03","via":"32103","match":"statcan_concordance","w":0.2},{"source":"oasis","ref":"32123.01","via":"32123","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#44","text":"Assist with the preparation of cardiac catheterization room, prepare specialized catheters and assist cardiologists during catheterization","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32103.03","via":"32103","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#45","text":"Perform analysis, programming and monitoring of implanted devices such as pacemakers and defibrillators during surgery","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32103.03","via":"32103","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#46","text":"Supervise and train students and other cardiopulmonary technologists","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32103.03","via":"32103","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#47","text":"Provide technical support for research.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32103.03","via":"32103","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#48","text":"Operate electrocardiogram and other electronic equipment to record cardiac activity of patients","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32123.01","via":"32123","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#49","text":"Perform non-invasive cardiovascular procedures and tests, such as electrocardiograms, exercise tolerance tests, ambulatory monitoring and scanning of tapes, holter arrhythmia scanning, pacemaker analysis and follow-up","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32123.01","via":"32123","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#50","text":"Record and assess cardiac activity and provide preliminary reports of tests","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32123.01","via":"32123","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#51","text":"Prepare reports for interpretation by cardiologists","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32123.01","via":"32123","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#52","text":"Reprogram pacemakers according to required standards","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32123.01","via":"32123","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#53","text":"Check, calibrate and perform routine maintenance of cardiology equipment to ensure proper operation","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32123.01","via":"32123","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#54","text":"May analyze tests and notify physician or other health care professionals of abnormalities","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32123.01","via":"32123","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#55","text":"May administer certain drugs under direct supervision of physician","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32123.01","via":"32123","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#56","text":"May document and record pacemaker implant threshold measurements under direct supervision of cardiac surgeon","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32123.01","via":"32123","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#57","text":"May supervise and train students, other cardiology technologists and nurses.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32123.01","via":"32123","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#58","text":"Review patient's case history and assess nature of problem to determine procedures and tests required","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32123.02","via":"32123","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#59","text":"Attach diagnostic equipment to patients and ensure their comfort and safety","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32123.02","via":"32123","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#60","text":"Operate diagnostic equipment such as electroencephalographic and evoked potential equipment to record the electrical activity of the brain and cranial and central nervous systems","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32123.02","via":"32123","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#61","text":"Operate electromyographic equipment to conduct electrophysiological nerve conduction velocity tests and to assist physicians in conducting electrophysiological tests such as muscle strength and repetitive stimulation","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32123.02","via":"32123","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#62","text":"Take notes on the recorded graph to identify interference such as poor electrode contact or patient movement","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32123.02","via":"32123","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#63","text":"Prepare recordings and reports of findings for physicians to aid in the diagnosis of neurological disorders","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32123.02","via":"32123","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#64","text":"Check, calibrate and perform routine maintenance of diagnostic equipment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32123.02","via":"32123","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#65","text":"Train and supervise students, technicians or other electroencephalograph technologists.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32123.02","via":"32123","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#66","text":"Assist pharmacists to maintain inventories of medications and prescription records of pharmaceutical products","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32124.00","via":"32124","match":"statcan_concordance","w":0.2},{"source":"oasis","ref":"33103.00","via":"33103","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#67","text":"Assess prescriptions for completeness and ensure information is accurate","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32124.00","via":"32124","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#68","text":"Gather and enter client information in databases and prepare medications for clients in collaboration with pharmacists","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32124.00","via":"32124","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#69","text":"Compound pharmaceutical products such as intravenous injections, oral solutions, ointments and creams","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32124.00","via":"32124","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#70","text":"Process payment of prescriptions and other pharmacy services including direct billing to third party insurers","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32124.00","via":"32124","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#71","text":"Provide instructions on how to use health aids, and medical devices such as drug administration devices and monitoring devices","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32124.00","via":"32124","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#72","text":"May help with scheduling and workflow.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32124.00","via":"32124","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#73","text":"Assist dietitians or nutritionists to plan and supervise food service operations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32129.01","via":"32129","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#74","text":"Plan menus and diet for individuals or groups under the direction of a dietitian or nutritionist","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32129.01","via":"32129","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#75","text":"Assist in the supervision of personnel who prepare and serve food","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32129.01","via":"32129","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#76","text":"Help patients select menu items","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32129.01","via":"32129","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#77","text":"Assist dietitians with research in food, nutrition and food service systems.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32129.01","via":"32129","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#78","text":"Design, fabricate and fit ocular prostheses and conformers, and may design and fabricate implants","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32129.02","via":"32129","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#79","text":"Paint the iris and pupil of artificial eyes","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32129.02","via":"32129","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#80","text":"Clean and restore ocular prostheses","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32129.02","via":"32129","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#81","text":"Advise patients concerning the loss of depth perception and the care and use of ocular prostheses","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32129.02","via":"32129","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#82","text":"Repair and maintain fabrication and laboratory equipment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32129.02","via":"32129","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#83","text":"Consult with ophthalmologists concerning insertion of ocular prostheses.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32129.02","via":"32129","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#84","text":"Design, fabricate and fit prosthetic and orthotic appliances such as artificial limbs, braces or supports","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32129.03","via":"32129","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#85","text":"Interpret physicians' specifications and examine and measure patients to develop working sketches of appliances","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32129.03","via":"32129","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#86","text":"Make and modify plaster casts of areas to receive prostheses or orthoses","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32129.03","via":"32129","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#87","text":"Fit, adjust and repair appliances","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32129.03","via":"32129","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#88","text":"Advise patients in the use and care of prostheses and orthoses","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32129.03","via":"32129","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#89","text":"Supervise and direct the activities of prosthetic and orthotic technicians.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32129.03","via":"32129","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#90","text":"Prosthetic and orthotic technicians","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32129.04","via":"32129","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#91","text":"Assemble or build prosthetic and orthotic appliances according to drawings, measurements and plaster casts using a variety of materials such as metals, plastics and leathers","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32129.04","via":"32129","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#92","text":"Repair, rebuild and modify prosthetic and orthotic appliances or orthopaedic footwear","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32129.04","via":"32129","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#93","text":"May take the body or limb measurements of patients.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32129.04","via":"32129","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#94","text":"Assess prescriptions for completeness","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33103.00","via":"33103","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#95","text":"Enter clients’ information and prescription details in databases","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33103.00","via":"33103","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#96","text":"Help pharmacists and other pharmacy staff with preparing, packaging and labelling of pharmaceutical products","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33103.00","via":"33103","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#97","text":"Compound oral solutions, ointments and creams","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33103.00","via":"33103","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#98","text":"May process medical billing information","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33103.00","via":"33103","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#99","text":"May price and stock items on shelves.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"33103.00","via":"33103","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null}]}