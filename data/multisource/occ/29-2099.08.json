,"ref":"32103.01","via":"32103","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#26","text":"Perform artificial respiration and external cardiac massage","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32103.01","via":"32103","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#27","text":"Evaluate and monitor patients’ cardiorespiratory conditions","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32103.01","via":"32103","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#28","text":"Provide and optimize patients’ mechanical ventilation","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32103.01","via":"32103","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#29","text":"Assist with transport of high-risk patients","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32103.01","via":"32103","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#30","text":"May prepare and administer authorized medications","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32103.01","via":"32103","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#31","text":"Supervise and train students and other respiratory therapists","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32103.01","via":"32103","match":"statcan_concordance","w":0.2}],"n_sources":1,"weight":0.2,"ai":null,"robotics":null},{"id":"29-2099.08#32","text":"Participate in home care programs for chronic respiratory patients and provide patient and family education","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32103.01","via":"32103","match":"statcan_concorda