}},{"id":"29-2099.08#6","text":"Read current literature, talk with colleagues, continue education, or participate in professional organizations or conferences to keep abreast of developments in the field.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17677","via":"29-2099.08","match":"native","w":0.111}],"n_sources":1,"weight":0.111,"ai":{"pct":0.914,"anthropic_penetration":0.724,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-2099.08#7","text":"Collect and report data on topics, such as patient encounters or inter-institutional problems, making recommendations for change when appropriate.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17673","via":"29-2099.08","match":"native","w":0.222}],"n_sources":1,"weight":0.222,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-2099.08#8","text":"Investigate and direct patient inquiries or complaints to appropriate medical staff members and follow up to ensure satisfactory resolution.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17669","via":"29-2099.08","match":"native","w":0.666}],"n_sources":1,"weight":0.666,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-2099.08#9","text":"Analyze patients' abilities to pay to determine charges on a sliding scale.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17672","via":"29-2099.08","match":"native","w":0.111}],"n_sources":1,"weight":0.111,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-2099.08#10","text":"Identify and share research, recommendations, or other information regarding legal liabilities, risk management, or quality of care.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":