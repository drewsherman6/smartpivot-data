the nature or extent of ocular disorders.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17175","via":"29-1249.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1249.00#2","text":"Diagnose or treat injuries, disorders, or diseases of the eye and eye structures including the cornea, sclera, conjunctiva, or eyelids.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17176","via":"29-1249.00","match":"native","w":0.611}],"n_sources":1,"weight":0.611,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1249.00#3","text":"Provide or direct the provision of postoperative care.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17166","via":"29-1249.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1249.00#4","text":"Develop or implement plans and procedures for ophthalmologic services.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17162","via":"29-1249.00","match":"native","w":0.167}],"n_sources":1,"weight":0.167,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1249.00#5","text":"Prescribe or administer topical or systemic medications to treat ophthalmic conditions and to manage pain.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17169","via":"29-1249.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1249.00#6","text":"Develop treatment plans based on patients' histories and goals, the nature and severity of disorders, and treatment risks and benefits.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17171","via":"29-1249.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1249.00#7","text":"Perform ophthalmic surgeries such as cataract, glaucoma, refractive, corneal, vitro-retinal, eye muscle, or oculoplastic surgeries.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17173","via":"29-1249.00","match":"native","w":0.778}],"n_sources":1,"weight":0.778,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1249.00#8","text":"Educate patients about maintenance and promotion of healthy vision.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17163","via":"29-1249.00","match":"native","w":0.222}],"n_sources":1,"weight":0.222,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1249.00#9","text":"Document or evaluate patients' medical histories.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17167","via":"29-1249.00","match":"native","w":0.5}],"n_sources":1,"weight":0.5,"ai":{"pct":0.914,"anthropic_penetration":0.724,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1249.00#10","text":"Perform, order, or interpret the results of diagnostic or clinical tests.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17170","via":"29-1249.00","match":"native","w":0.444}],"n_sources":1,"weight":0.444,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1249.00#11","text":"Provide ophthalmic consultation to other medical professionals.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17159","via":"29-1249.00","match":"native","w":0.111}],"n_sources":1,"weight":0.111,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1249.00#12","text":"Refer patients for more specialized treatments when conditions exceed the experience, expertise, or scope of practice of practitioner.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17160","via":"29-1249.00","match":"native","w":0.056}],"n_sources":1,"weight":0.056,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1249.00#13","text":"Perform laser surgeries to alter, remove, reshape, or replace ocular tissue.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17172","via":"29-1249.00","match":"native","w":0.167}],"n_sources":1,"weight":0.167,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"29-1249.00#14","text":"Collaborate with multidisciplinary teams of health professionals to provide optimal patient care.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17165","via":"29-1249.00","match":"native","w":0.111}],"n_sources":1,"weight":0.111,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1249.00#15","text":"Prescribe corrective lenses such as glasses or contact lenses.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17168","via":"29-1249.00","match":"native","w":0.111}],"n_sources":1,"weight":0.111,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1249.00#16","text":"Prescribe ophthalmologic treatments or therapies such as chemotherapy, cryotherapy, or low vision therapy.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17174","via":"29-1249.00","match":"native","w":0.056}],"n_sources":1,"weight":0.056,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1249.00#17","text":"Instruct interns, residents, or others in ophthalmologic procedures and techniques.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17161","via":"29-1249.00","match":"native","w":0.111}],"n_sources":1,"weight":0.111,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1249.00#18","text":"Conduct clinical or laboratory-based research in ophthalmology.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"17164","via":"29-1249.00","match":"native","w":0.056}],"n_sources":1,"weight":0.056,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1249.00#19","text":"Conducting physical examinations of patients and interviewing them and their families to determine their health status","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2212-1","via":"2212","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.257,"anthropic_penetration":null,"ilo_2025":0.165,"basis":"direct"},"robotics":null},{"id":"29-1249.00#20","text":"Considering medical information provided by a referring doctor or other health care provider","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2212-2","via":"2212","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.605,"anthropic_penetration":null,"ilo_2025":0.335,"basis":"direct"},"robotics":null},{"id":"29-1249.00#21","text":"Ordering specialized diagnostic tests to determine the nature of disorders or illnesses","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2212-3","via":"2212","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.506,"anthropic_penetration":null,"ilo_2025":0.285,"basis":"direct"},"robotics":null},{"id":"29-1249.00#22","text":"Prescribing, administering and monitoring patients' responses to treatments, medications, anaesthetics, psychotherapies, physical rehabilitation programmes and other preventive and curative measures","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2212-4","via":"2212","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.304,"anthropic_penetration":null,"ilo_2025":0.18,"basis":"direct"},"robotics":null},{"id":"29-1249.00#23","text":"Performing surgery of a general or specialized nature","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2212-5","via":"2212","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.101,"anthropic_penetration":null,"ilo_2025":0.1225,"basis":"direct"},"robotics":null},{"id":"29-1249.00#24","text":"Managing complications before, during and after childbirth","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2212-6","via":"2212","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.064,"anthropic_penetration":null,"ilo_2025":0.1075,"basis":"direct"},"robotics":null},{"id":"29-1249.00#25","text":"Recording patients' medical information and exchanging information with other health professionals to ensure the provision of comprehensive care","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2212-7","via":"2212","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.68,"anthropic_penetration":null,"ilo_2025":0.365,"basis":"direct"},"robotics":null},{"id":"29-1249.00#26","text":"Reporting births, deaths and notifiable diseases to government authorities to meet legal and professional requirements","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2212-8","via":"2212","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.708,"anthropic_penetration":null,"ilo_2025":0.375,"basis":"direct"},"robotics":null},{"id":"29-1249.00#27","text":"Providing information to patients and families and communities about preventive measures, treatment and care for specific ailments","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2212-9","via":"2212","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.778,"anthropic_penetration":null,"ilo_2025":0.43,"basis":"direct"},"robotics":null},{"id":"29-1249.00#28","text":"Performing autopsies to determine cause of death","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2212-10","via":"2212","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.232,"anthropic_penetration":null,"ilo_2025":0.155,"basis":"direct"},"robotics":null},{"id":"29-1249.00#29","text":"Conducting research into specific human disorders and illnesses and preventive or curative methods and disseminating the findings such as through scientific reports","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2212-11","via":"2212","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.733,"anthropic_penetration":null,"ilo_2025":0.388,"basis":"direct"},"robotics":null},{"id":"29-1249.00#30","text":"Planning and participating in programmes designed to prevent the occurrence and spread of specific diseases.","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"2212-12","via":"2212","match":"bls_crosswalk","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.633,"anthropic_penetration":null,"ilo_2025":0.35,"basis":"direct"},"robotics":null},{"id":"29-1249.00#31","text":"Administer anesthetics prior to, during, or after surgery or other medical procedures.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.01","via":"31100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#32","text":"Diagnose and provide non-surgical treatment of diseases and injuries of internal organ systems. Provide care mainly for adults who have a wide range of problems associated with the internal organs.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.02","via":"31100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#33","text":"Diagnose, treat, and help prevent children's diseases and injuries.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.03","via":"31100","match":"statcan_concordance","w":0.333},{"source":"oasis","ref":"31101.03","via":"31101","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#34","text":"Diagnose, treat, and help prevent disorders of the mind.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.04","via":"31100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#35","text":"Diagnose, treat, and help prevent allergic diseases and disease processes affecting the immune system.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.05","via":"31100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#36","text":"Provide inpatient care predominantly in settings such as medical wards,  intensive care units, rehabilitation centers, or emergency rooms. Manage and coordinate patient care throughout treatment.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.06","via":"31100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#37","text":"Diagnose, treat, and help prevent diseases and disorders of the nervous system involving the brain and spinal cord and other nerve and muscular conditions.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.07","via":"31100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#38","text":"Diagnose and treat diseases using radioactive materials. May monitor radionuclide preparation, administration, and disposition.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.08","via":"31100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#39","text":"Diagnose, treat, and help prevent diseases or other conditions of the skin.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.09","via":"31100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#40","text":"Diagnose and treat disorders requiring physiotherapy to provide physical, mental, and occupational rehabilitation.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.10","via":"31100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#41","text":"Apply knowledge of general preventive medicine and public health issues to promote health care to groups or individuals, and aid in the prevention or reduction of risk of disease, injury, disability, or death. May diagnose and treat patients in the context of clinical health promotion and disease prevention.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.11","via":"31100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#42","text":"Examine and diagnose disorders and diseases using x-rays and radioactive materials. May treat patients.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.12","via":"31100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#43","text":"Diagnose and treat diseases and physiological or psychiatric disorders. Order laboratory tests, X-rays and other diagnostic procedures. Prescribe medication and treatment and refer patients for surgery. Act as consultants to other physicians. May conduct medical research.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.13","via":"31100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#44","text":"Diagnose presence and stage of diseases using laboratory techniques and patient specimens. Study the nature, cause and development of diseases in humans and the structural and functional changes caused by diseases. Act as consultants to other physicians. May perform autopsies.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31100.14","via":"31100","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#45","text":"Treat diseases, injuries, and deformities by invasive, minimally-invasive, or non-invasive surgical methods, such as using instruments, appliances, or by manual manipulation.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31101.01","via":"31101","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#46","text":"Provide medical care related to pregnancy or childbirth.  Diagnose, treat, and help prevent diseases of women, particularly those affecting the reproductive system. May also provide general medical care to women. May perform both medical and gynecological surgery functions.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31101.02","via":"31101","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#47","text":"Diagnose, treat, and help prevent benign and malignant medical and surgical disorders of the genitourinary system and the renal glands.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31101.04","via":"31101","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#48","text":"Assess patients' diseases or disorders to determine appropriate surgical procedures","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31101.05","via":"31101","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#49","text":"Perform and supervise surgical procedures to correct physical abnormalities and deficiencies and repair injuries","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31101.05","via":"31101","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#50","text":"Act as consultants to other physicians.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31101.05","via":"31101","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#51","text":"Interviews persons in connection with criminal incidents, including victims, witnesses and suspects","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#52","text":"Exchange information and coordinate activities with other law enforcements agencies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#53","text":"Prepare investigation reports and testify in courts concerning criminal investigations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#54","text":"Search and collect physical evidence from crimes scenes, such as fingerprints, and attend autopsies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#55","text":"Perform surveillance by using investigative technologies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#56","text":"Obtain search warrants, conduct searches and arrest suspects","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#57","text":"May conduct investigation on online networks and computer systems to detect cyber crimes or to recover data.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#58","text":"May supervise and coordinate the work of police officers.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.01","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#59","text":"Conduct death investigations to determine the identity of the deceased, date and location of death, medical cause of death, and manner of death","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#60","text":"Order or perform autopsies and other medical tests","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#61","text":"Consult with and request assistance from law enforcement, physicians, and family","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#62","text":"Issue death certificates, including assigning cause and manner of death","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#63","text":"Identify and educate the public on dangerous practices or conditions that may lead to death","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#64","text":"May testify or produce evidence in proceedings about observations made during investigations","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null},{"id":"29-1249.00#65","text":"May supervisor and coordinator work of other employees.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"41310.02","via":"41310","match":"statcan_concordance","w":0.333}],"n_sources":1,"weight":0.333,"ai":null,"robotics":null}]}