Assessing health status of persons involved in accidents, natural disasters and other emergency situations, and determining needs for immediate and specialized medical assistance","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3258-1","via":"3258","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.092,"anthropic_penetration":null,"ilo_2025":0.12,"basis":"direct"},"robotics":null},{"id":"29-2042.00#60","text":"Performing medical procedures and administering drugs and other therapies according to protocol for emergency medical treatment, including resuscitating and defibrillating patients and operating life-support equipment","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3258-2","via":"3258","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.003,"anthropic_penetration":null,"ilo_2025":0.0625,"basis":"direct"},"robotics":null},{"id":"29-2042.00#61","text":"Monitoring changes in health status of patients during transport to and from medical, rehabilitation and other health care facilities","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3258-3","via":"3258","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.377,"anthropic_penetration":null,"ilo_2025":0.23,"basis":"direct"},"robotics":null},{"id":"29-2042.00#62","text":"Providing information and training to community groups and essential service workers in first aid for initial care of an illness or injury","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3258-4","via":"3258","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.121,"anthropic_penetration":null,"ilo_2025":0.13,"basis":"direct"},"robotics":null},{"id":"29-2042.00#63","text":"Attending and/or patrolling large-scale public gatherings and other events where health emergencies are more likely to occur","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3258-5","via":"3258","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.334,"anthropic_penetration":null,"ilo_2025":0.2,"basis":"direct"},"robotics":null},{"id":"29-2042.00#64","text":"Recording information on patients' conditions and treatments provided in medical records-keeping systems.","kind":"task","esco_uri":null,"sources":[{"source":"ilo","ref":"3258-6","via":"3258","match":"bls_crosswalk∩esco_isco","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0.905,"anthropic_penetration":null,"ilo_2025":0.55,"basis":"direct"},"robotics":null},{"id":"29-2042.00#65","text":"Assess extent of injuries or medical illnesses of trauma victims, patients with respiratory disease and stress, overdose and poisoning victims, industrial accident victims and other ill or injured individuals to determine emergency medical treatment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32102.00","via":"32102","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-2042.00#66","text":"Administer pre-hospital emergency care to patients such as oxygen therapy, cardiopulmonary resuscitation (CPR), spinal immobilization, bandaging and splinting","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32102.00","via":"32102","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-2042.00#67","text":"Establish and maintain intravenous treatment (IV), apply adjunctive equipment for ventilation and circulation complications, administer medications and provide other advanced emergency treatment to patients","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32102.00","via":"32102","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-2042.00#68","text":"Transport patients by air, land or water to hospital or other medical facility for further medical care","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32102.00","via":"32102","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-2042.00#69","text":"Collaborate with ambulance dispatch centres, hospital staff, police, firefighters and family members to ensure relevant information is collected and proper treatment is administered","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32102.00","via":"32102","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-2042.00#70","text":"Document and record nature of injuries and illnesses and treatment provided","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32102.00","via":"32102","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-2042.00#71","text":"Assist hospital personnel with provision of medical treatment, if necessary","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32102.00","via":"32102","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-2042.00#72","text":"Maintain emergency care equipment and supplies","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32102.00","via":"32102","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-2042.00#73","text":"May train and supervise other workers in this unit group","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32102.00","via":"32102","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-2042.00#74","text":"May assist with triage of emergency patients.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"32102.00","via":"32102","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null}]}