 or fire department personnel.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"22857","via":"29-2042.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-2042.00#7","text":"Decontaminate ambulance interior following treatment of patient with infectious disease, and report case to proper authorities.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"22858","via":"29-2042.00","match":"native","w":0.25}],"n_sources":1,"weight":0.25,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-2042.00#8","text":"Drive mobile intensive care unit to specified location, following instructions from emergency medical dispatcher.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"22859","via":"29-2042.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"29-2042.00#9","text":"Immobilize patient for placement on stretcher and ambulance transport, using backboard or other spinal immobilization device.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"22860","via":"29-2042.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-2042.00#10","text":"Maintain vehicles and medical and communication equipment, and replenish first aid equipment and supplies.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"22861","via":"29-2042.00","match":"native","w":0.5}],"n_sources":1,"weight":0.5,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-2042.00#11","text":"Observe, record, and report to physician the patient's condition or injury, the treatment provided, and reactions to drugs or treatment.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"22862","via":"29-2042.00","match":"native","w":0.667}],"n_sources":1,"weight":0.667,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-2042.00#12","text":"Perform emergency diagnostic and treatment procedures, such as stomach suction, airway management, or heart monitoring, during ambulance ride.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"22863","via":"29-2042.00","match":"native","w":0.333}],"n_sources":1,"weight":0.333,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-2042.00#13","text":"position patients undergoing interventions","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/e2e398af-6449-48e7-9fd5-ebe202dd157f","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/e2e398af-6449-48e7-9fd5-ebe202dd157f","via":"http://data.europa.eu/esco/occupation/64e909ad-1bd0-493c-a8dc-1afbed0c9c2f","match":"closeMatch","essential":true,"w":0.8}],"n_sources":1,"weight":0.8,"ai":null,"robotics":null},{"id":"29-2042.00#14","text":"transfer patients","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/949c119b-3433-439f-8ca9-1a9ce04b696d","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/949c119b-3433-439f-8ca9-1a9ce04b696d","via":"http://data.europa.eu/esco/occupation/64e909ad-1bd0-493c-a8dc-1afbed0c9c2f","match":"closeMatch","essential":true,"w":0.8}],"n_sources":1,"weight":0.8,"ai":null,"robotics":null},{"id":"29-2042.00#15","text":"adhere to organisational guidelines","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/aa238394-8126-4ada-be2f-9dfe065cf314","sources":[{"source":"esco","