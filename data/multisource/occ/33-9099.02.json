y","esco_uri":null,"sources":[{"source":"oasis","ref":"45100.01","via":"45100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#41","text":"May supervise tests, school detention, and other related activities","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"45100.01","via":"45100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#42","text":"May prepare classroom equipment such as projectors and other audio-visual or electronic equipment for special activities.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"45100.01","via":"45100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#43","text":"Coordinate the flow of pedestrians across selected intersection with the flow of vehicles.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"45100.02","via":"45100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#44","text":"Direct and assist students at school crossing locations.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"45100.02","via":"45100","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#45","text":"Control access to establishments, operate security control-room equipment and patrol assigned areas to guard against theft, vandalism and fire","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"64410.01","via":"64410","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#46","text":"Enforce regulations to maintain order and resolve conflicts and to monitor establishment activities","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"64410.01","via":"64410","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#47","text":"Ensure safety and emergency procedures are followed","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"64410.01","via":"64410","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#48","text":"Issue passes and direct visitors to appropriate areas and check age identification of patrons.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"64410.01","via":"64410","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#49","text":"Drive and guard armoured trucks, pick-up and deliver cash and valuables to banks, automated teller machines and retail establishments.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"64410.02","via":"64410","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#50","text":"Investigate unlawful acts of employees or patrons of establishments","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"64410.03","via":"64410","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#51","text":"Recommend security systems such as electronic detection devices and access devices.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"64410.03","via":"64410","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#52","text":"Conduct investigations to locate missing persons","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"64410.04","via":"64410","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#53","text":"Obtain information for use in civil and criminal litigation matters or for other purposes","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"64410.04","via":"64410","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#54","text":"May also conduct polygraph tests (integrity surveys) for clients.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"64410.04","via":"64410","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#55","text":"Prevent and detect shoplifting and theft in retail establishments.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"64410.05","via":"64410","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#56","text":"Shampoo, condition and dry customers' hair and assist hair stylists as directed","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.01","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#57","text":"Keep work areas clean.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.01","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#58","text":"Assist persons entering or leaving residential buildings, theatres and similar establishments","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.02","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#59","text":"May call taxis and assist with parcels.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.02","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#60","text":"Drive hearses","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.03","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#61","text":"Arrange lights and floral displays","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.03","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#62","text":"Escort mourners and act as pallbearers","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.03","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#63","text":"Clean funeral parlours and chapels.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.03","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#64","text":"Replenish vending machines","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.04","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#65","text":"Provide change","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.04","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#66","text":"Explain operation of machines to customers","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.04","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#67","text":"Clean the laundromat and arrange for the repair of broken machines","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.04","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#68","text":"May wash, dry and fold laundry for customers","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.04","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#69","text":"May operate dry cleaning machines for customers.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.04","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#70","text":"Collect parking fees and issue ticket stubs","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.05","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#71","text":"Direct customers to parking spaces and park cars.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.05","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#72","text":"Collect admission tickets or passes from patrons at entertainment events and direct patrons to their seats.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.06","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null},{"id":"33-9099.02#73","text":"Perform services specific to the establishments in which their occupations are found.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"65329.07","via":"65329","match":"statcan_concordance","w":0.25}],"n_sources":1,"weight":0.25,"ai":null,"robotics":null}]}