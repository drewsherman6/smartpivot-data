"label":"sources agree"},"headline":{"value":0.336,"time_weighted_tasks":0.333,"other_measures_pct":0.756,"other_measures_linked":0.338,"weight_time_weighted":0.5,"weight_other_measures":0.5}}},"statements":[{"id":"51-6021.00#1","text":"Hang, fold, package, and tag finished articles for delivery to customers.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14038","via":"51-6021.00","match":"native","w":0.316}],"n_sources":1,"weight":0.316,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6021.00#2","text":"Operate steam, hydraulic, or other pressing machines to remove wrinkles from garments and flatwork items, or to shape, form, or patch articles.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14035","via":"51-6021.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6021.00#3","text":"Straighten, smooth, or shape materials to prepare them for pressing.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14043","via":"51-6021.00","match":"native","w":0.211}],"n_sources":1,"weight":0.211,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6021.00#4","text":"Remove finished pieces from pressing machines and hang or stack them for cooling, or forward them for additional processing.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14037","via":"51-6021.00","match":"native","w":0.316}],"n_sources":1,"weight":0.316,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6021.00#5","text":"Finish pleated garments, determining sizes of pleats from evidence of old pleats or from work orders, using machine presses or hand irons.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14042","via":"51-6021.00","match":"native","w":0.053}],"n_sources":1,"weight":0.053,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-6021.00#6","text":"Lower irons, rams, or pressing heads of machines into position over material to be pressed.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14036","via":"51-6021.00","match":"native","w":0.211}],"n_sources":1,"weight":0.211,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"51-6021.00#7","text":"Identify and treat spots on garments.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"21026","via":"51-6021.00","match":"native","w":0.105}],"n_sources":1,"weight":0.105,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-6021.00#8","text":"Shrink, stretch, or block articles by hand to conform to original measurements, using forms, blocks, and steam.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14051","via":"51-6021.00","match":"native","w":0.053}],"n_sources":1,"weight":0.053,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6021.00#9","text":"Finish fancy garments such as evening gowns and costumes, using hand irons to produce high quality finishes.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14049","via":"51-6021.00","match":"native","w":0.053}],"n_sources":1,"weight":0.053,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-6021.00#10","text":"Push and pull irons over surfaces of articles to smooth or shape them.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14041","via":"51-6021.00","match":"native","w":0.158}],"n_sources":1,"weight":0.158,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6021.00#11","text":"Finish pants, jackets, shirts, skirts and other dry-cleaned and laundered articles, using hand irons.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14044","via":"51-6021.00","match":"native","w":0.368},{"source":"oasis","ref":"65320.03","via":"65320","match":"statcan_concordance","w":1}],"n_sources":2,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6021.00#12","text":"Slide material back and forth over heated, metal, ball-shaped forms to smooth and press portions of garments that cannot be satisfactorily pressed with flat pressers or hand irons.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14039","via":"51-6021.00","match":"native","w":0.053}],"n_sources":1,"weight":0.053,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6021.00#13","text":"Select appropriate pressing machines, based on garment properties such as heat tolerance.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14040","via":"51-6021.00","match":"native","w":0.053}],"n_sources":1,"weight":0.053,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-6021.00#14","text":"Spray water over fabric to soften fibers when not using steam irons.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14046","via":"51-6021.00","match":"native","w":0.053}],"n_sources":1,"weight":0.053,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6021.00#15","text":"Position materials such as cloth garments, felt, or straw on tables, dies, or feeding mechanisms of pressing machines, or on ironing boards or work tables.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14045","via":"51-6021.00","match":"native","w":0.368}],"n_sources":1,"weight":0.368,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-6021.00#16","text":"Moisten materials to soften and smooth them.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14047","via":"51-6021.00","match":"native","w":0.053}],"n_sources":1,"weight":0.053,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6021.00#17","text":"Clean and maintain pressing machines, using cleaning solutions and lubricants.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14052","via":"51-6021.00","match":"native","w":0.105}],"n_sources":1,"weight":0.105,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6021.00#18","text":"Press ties on small pressing machines.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14057","via":"51-6021.00","match":"native","w":0.004}],"n_sources":1,"weight":0.004,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6021.00#19","text":"Block or shape knitted garments after cleaning.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14053","via":"51-6021.00","match":"native","w":0.004}],"n_sources":1,"weight":0.004,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6021.00#20","text":"Activate and adjust machine controls to regulate temperature and pressure of rollers, ironing shoes, or plates, according to specifications.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14050","via":"51-6021.00","match":"native","w":0.105}],"n_sources":1,"weight":0.105,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"51-6021.00#21","text":"Use covering cloths to prevent equipment from damaging delicate fabrics.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14056","via":"51-6021.00","match":"native","w":0.053}],"n_sources":1,"weight":0.053,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6021.00#22","text":"Examine and measure finished articles to verify conformance to standards, using measuring devices such as tape measures and micrometers.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14059","via":"51-6021.00","match":"native","w":0.053}],"n_sources":1,"weight":0.053,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6021.00#23","text":"Finish velvet garments by steaming them on bucks of hot-head presses or steam tables, and brushing pile (nap) with handbrushes.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14048","via":"51-6021.00","match":"native","w":0.004}],"n_sources":1,"weight":0.004,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-6021.00#24","text":"Measure fabric to specifications, cut uneven edges with shears, fold material, and press it with an iron to form a heading.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14061","via":"51-6021.00","match":"native","w":0.004}],"n_sources":1,"weight":0.004,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6021.00#25","text":"Insert heated metal forms into ties and touch up rough places with hand irons.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14054","via":"51-6021.00","match":"native","w":0.004}],"n_sources":1,"weight":0.004,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6021.00#26","text":"Brush materials made of suede, leather, or felt to remove spots or to raise and smooth naps.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14055","via":"51-6021.00","match":"native","w":0.053}],"n_sources":1,"weight":0.053,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"51-6021.00#27","text":"Sew ends of new material to leaders or to ends of material in pressing machines, using sewing machines.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14060","via":"51-6021.00","match":"native","w":0.004}],"n_sources":1,"weight":0.004,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"51-6021.00#28","text":"Select, install, and adjust machine components, including pressing forms, rollers, and guides, using hoists and hand tools.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"14058","via":"51-6021.00","match":"native","w":0.053}],"n_sources":1,"weight":0.053,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":