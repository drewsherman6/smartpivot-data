ines in cases where major repairs are required.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13841","via":"49-9091.00","match":"native","w":0.062}],"n_sources":1,"weight":0.062,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-9091.00#16","text":"Transport machines to installation sites.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13852","via":"49-9091.00","match":"native","w":0.062}],"n_sources":1,"weight":0.062,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-9091.00#17","text":"Refer to manuals and wiring diagrams to gather information needed to repair machines.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13851","via":"49-9091.00","match":"native","w":0.062}],"n_sources":1,"weight":0.062,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"49-9091.00#18","text":"Install machines, making the necessary water and electrical connections in compliance with codes.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"13850","via":"49-9091.00","match":"native","w":0.125}],"n_sources":1,"weight":0.125,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"49-9091.00#19","text":"ensure public safety and security","kind":"skill","esco_uri":"http://data.europa.eu/esco/skill/499c05a2-6f36-4407-83c1-dc3448d35818","sources":[{"source":"esco","ref":"http://data.europa.eu/esco/skill/499c05a2-6f36-4407-83c1-dc3448d35818","via":"http://data.europa.eu/esco/occupation/9ab02537-920a-4549-9711-fd999fd40c28","match":"narrowMatch","essential":true,"w":0.6}],"n_sources":1,"weight":0.6,"ai":null,"robotics":null},{"id":"49-9091.00#20","text":"geographi