:"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-1029.00#36","text":"Prescribe antibiotics or other medication as required","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31110.01","via":"31110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-1029.00#37","text":"Refer patients to dental specialists as needed for recommended procedures","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31110.01","via":"31110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-1029.00#38","text":"May provide basic orthodontic treatments with additional training.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31110.01","via":"31110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-1029.00#39","text":"Collaborate with other professionals, such as restorative dentists and orthodontists, to plan treatment","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31110.02","via":"31110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-1029.00#40","text":"Administer general and local anesthetics","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31110.02","via":"31110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-1029.00#41","text":"Perform surgery to prepare the mouth for dental implants orto aid in the regeneration of deficient bone and gum tissues","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31110.02","via":"31110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-1029.00#42","text":"Remove impacted, damaged, and non-restorable teeth, as well as tumors and other abnormal growths of the oral and facial regions","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31110.02","via":"31110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-1029.00#43","text":"Perform surgery on the mouth and jaws to treat conditions, such as cleft lip, palate, and jaw growth problems","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31110.02","via":"31110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-1029.00#44","text":"Provide emergency treatment of facial injuries including facial lacerations, intra-oral lacerations, and fractured facial bones","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31110.02","via":"31110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-1029.00#45","text":"Treat infections of the oral cavity, salivary glands, jaws, and neck.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31110.02","via":"31110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-1029.00#46","text":"Examine patients' teeth, gums and surrounding tissue to assess abnormalities of jaw development, tooth position, and other dental-facial structures","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31110.03","via":"31110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-1029.00#47","text":"Diagnose teeth and jaw or other dental-facial abnormalities","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31110.03","via":"31110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-1029.00#48","text":"Propose treatment plan for conditions such as underbites, overbites, crowding and others","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31110.03","via":"31110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-1029.00#49","text":"Design and fabricate appliances, such as space maintainers, retainers, and labial and lingual arch wires","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31110.03","via":"31110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-1029.00#50","text":"Fit dental appliances in patients' mouths to alter the position and relationship of teeth and jaws or to realign teeth","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31110.03","via":"31110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-1029.00#51","text":"Coordinate orthodontic services with other dental and medical professionals","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31110.03","via":"31110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-1029.00#52","text":"Educate patients about improving and maintaining orthodontic care, and promoting routine dental health care.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31110.03","via":"31110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-1029.00#53","text":"Examine patient’s teeth, gums and jaws to diagnose disease, injury and decay, and plan appropriate treatment to enhance patients’ dental and facial aesthetics, or correct orofacial problems","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31110.04","via":"31110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-1029.00#54","text":"Replace missing teeth and associated oral structures with permanent fixtures, such as implant-supported prostheses, crowns and bridges, or removable fixtures, such as dentures","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31110.04","via":"31110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-1029.00#55","text":"Restore function and improve aesthetics for traumatic injury victims, or individuals with diseases or birth defects","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31110.04","via":"31110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-1029.00#56","text":"Design and fabricate dental prostheses, or supervise dental technicians who construct the devices","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31110.04","via":"31110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-1029.00#57","text":"Fit prostheses to patients, making any necessary adjustments and modifications","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31110.04","via":"31110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-1029.00#58","text":"Restore damaged teeth with materials such as fillings, veneers and crowns","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31110.04","via":"31110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null},{"id":"29-1029.00#59","text":"Collaborate with general dentists, dental specialists, and other health professionals to develop solutions to dental and oral health concerns.","kind":"duty","esco_uri":null,"sources":[{"source":"oasis","ref":"31110.04","via":"31110","match":"statcan_concordance","w":1}],"n_sources":1,"weight":1,"ai":null,"robotics":null}]}