sures":0.5}}},"statements":[{"id":"29-1124.00#1","text":"Position patients for treatment with accuracy, according to prescription.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4086","via":"29-1124.00","match":"native","w":1}],"n_sources":1,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"29-1124.00#2","text":"Administer prescribed doses of radiation to specific body parts, using radiation therapy equipment according to established practices and standards.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4085","via":"29-1124.00","match":"native","w":0.857}],"n_sources":1,"weight":0.857,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E2","score":0.6666666666666666,"basis":"direct"}},{"id":"29-1124.00#3","text":"Follow principles of radiation protection for patient, self, and others.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4088","via":"29-1124.00","match":"native","w":0.143}],"n_sources":1,"weight":0.143,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1124.00#4","text":"Review prescription, diagnosis, patient chart, and identification.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4090","via":"29-1124.00","match":"native","w":0.357}],"n_sources":1,"weight":0.357,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1124.00#5","text":"Conduct most treatment sessions independently, in accordance with the long-term treatment plan and under the general direction of the patient's physician.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4091","via":"29-1124.00","match":"native","w":0.214}],"n_sources":1,"weight":0.214,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"29-1124.00#6","text":"Enter data into computer and set controls to operate or adjust equipment or regulate dosage.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4087","via":"29-1124.00","match":"native","w":0.428}],"n_sources":1,"weight":0.428,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1124.00#7","text":"Check radiation therapy equipment to ensure proper operation.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4092","via":"29-1124.00","match":"native","w":0.286},{"source":"oasis","ref":"32121.02","via":"32121","match":"statcan_concordance","w":1},{"source":"oasis","ref":"32121.03","via":"32121","match":"statcan_concordance","w":1}],"n_sources":2,"weight":1,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E1","score":0.3333333333333333,"basis":"direct"}},{"id":"29-1124.00#8","text":"Observe and reassure patients during treatment and report unusual reactions to physician or turn equipment off if unexpected adverse reactions occur.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4093","via":"29-1124.00","match":"native","w":0.286}],"n_sources":1,"weight":0.286,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","score":0,"basis":"direct"}},{"id":"29-1124.00#9","text":"Educate, prepare, and reassure patients and their families by answering questions, providing physical assistance, and reinforcing physicians' advice regarding treatment reactions or post-treatment care.","kind":"task","esco_uri":null,"sources":[{"source":"onet","ref":"4095","via":"29-1124.00","match":"native","w":0.286}],"n_sources":1,"weight":0.286,"ai":{"pct":0,"anthropic_penetration":0,"ilo_2025":null,"basis":"direct"},"robotics":{"tier":"E0","s