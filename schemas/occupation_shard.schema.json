{"$schema": "http://json-schema.org/draft-07/schema#", "$id": "occupation_shard.schema.json", "type": "object", "required": ["schema_version", "dataset", "generated", "sources", "occupations"], "properties": {"dataset": {"const": "occupation_shard"}, "generated": {"type": "string", "format": "date"}, "sources": {"type": "object", "additionalProperties": {"type": "object", "required": ["name", "url", "retrieved_at"], "properties": {"url": {"type": "string", "format": "uri"}, "retrieved_at": {"type": "string", "format": "date"}}}}, "occupations": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["code", "title", "description", "tasks", "skills", "abilities", "knowledge", "technology", "related", "bls", "exposure", "derived", "major_group", "agents"], "properties": {"code": {"type": "string", "pattern": "^\\d{2}-\\d{4}\\.\\d{2}$"}, "skills": {"type": "array", "items": {"type": "object", "required": ["id", "name", "kind", "importance"], "properties": {"kind": {"const": "skill"}, "importance": {"type": "number", "minimum": 1, "maximum": 5}, "level": {"type": ["number", "null"], "minimum": 0, "maximum": 7}}}}, "knowledge": {"type": "array", "items": {"type": "object", "properties": {"kind": {"const": "knowledge"}}}}, "abilities": {"type": "array", "items": {"type": "object", "required": ["name", "kind", "category"], "properties": {"kind": {"const": "ability"}, "category": {"enum": ["cognitive", "psychomotor", "physical", "sensory", "other"]}}}}, "tasks": {"type": "array", "items": {"type": "object", "required": ["id", "text"], "properties": {"robot_tier": {"enum": ["E0", "E1", "E2", "E3", null, ""]}, "ai_task_penetration": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}}}, "exposure": {"type": "object", "required": ["ai", "robotics"], "properties": {"ai": {"type": "object", "properties": {"composite": {"type": ["object", "null"], "properties": {"value": {"type": "number", "minimum": 0, "maximum": 1}}}, "task_share": {"type": ["object", "null"], "properties": {"share": {"type": "number", "minimum": 0, "maximum": 1}}}}}, "robotics": {"type": "object", "required": ["total_tasks", "rated_tasks", "exposed_tasks_count", "exposed_task_share", "exposed_time_share", "task_share_method"], "properties": {"exposed_task_share": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "exposed_time_share": {"type": ["number", "null"], "minimum": 0, "maximum": 1.01}}}}}, "derived": {"type": "object", "required": ["transitions", "future_skills", "skills_to_develop", "method", "core_skills"], "properties": {"future_skills": {"type": "array", "minItems": 0, "maxItems": 8, "items": {"type": "object", "required": ["skill", "category", "kind", "future_importance", "current_importance", "distinctiveness", "future_score", "why", "signal_sources"], "properties": {"kind": {"const": "skill"}, "why": {"type": "string", "minLength": 1}, "signal_sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["type", "source"], "properties": {"type": {"enum": ["distinctiveness", "growing_transitions", "hot_technology", "emerging_task", "rising_skill"]}}}}}}}, "skills_to_develop": {"type": "array", "items": {"type": "object", "required": ["skill", "kind"], "properties": {"kind": {"const": "skill"}}}}, "transitions": {"type": "array", "items": {"type": "object", "required": ["code", "title", "score", "skill_gaps"]}}, "core_skills": {"type": "array", "items": {"type": "object", "required": ["skill", "kind", "current_importance", "why"], "properties": {"kind": {"const": "skill"}}}}}}, "agents": {"type": "object", "required": ["platforms", "platform_count", "category_scores", "method"], "properties": {"platforms": {"type": "array", "maxItems": 12, "items": {"type": "object", "required": ["id", "name", "url", "status", "category", "score", "relevance", "matched_tasks"], "properties": {"status": {"const": "verified"}, "relevance": {"enum": ["high", "medium", "low"]}, "score": {"type": "number", "minimum": 0, "maxim